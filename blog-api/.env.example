# ==========================================
# Yaoxi Blog API — Standalone Configuration
# ==========================================

PORT=3001
HOST=127.0.0.1
DB_PATH=/var/lib/blog-api/yaoxi-blog.sqlite

# 管理员鉴权 Token (用于评论审核、批量广播等)
ADMIN_TOKEN=yaoxi_admin_token_change_me_in_production

# JWT / SSO 密钥
JWT_SECRET=yaoxi_jwt_secret_change_me
AUTH_SECRET=yaoxi_auth_secret_change_me
SSO_SECRET=
COMMENT_IP_SALT=salt_yaoxi_blog_2026

# 评论免审上墙 (设为 true 则读者提交评论/弹幕直接公开可见，无需人工审核)
DANMAKU_AUTO_APPROVE=true

# 邮件发信配置
OWNER_EMAIL=admin@yaoxi.wiki
EMAIL_FROM=no-reply@yaoxi.wiki
MAIL_GATEWAY_URL=https://mail-api.yaoxi.cloud
MAIL_GATEWAY_TOKEN=
RESEND_API_KEY=

# Telegram 通知与审核机器人 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
