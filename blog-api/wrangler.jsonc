{
	"name": "blog-api",
	"main": "src/index.js",
	"compatibility_date": "2025-08-11",
	"routes": [
		{
			"pattern": "blog-api.yaoxi.cloud",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "REPLACE_WITH_KV_ID"
		}
	],
	"d1_databases": [
		// 评论系统存储：与 zk-bff 共享同一 D1 库（migrations 在 ./migrations 下独立管理）
		{
			"binding": "DB",
			"database_name": "yaoxi-blog-d1",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "PRESENCE",
				"class_name": "PresenceRoom"
			}
		]
	},
	"migrations": [
		// 实时共读房间（SQLite 后端 Durable Object，免费额度即可运行）
		{
			"tag": "v1",
			"new_sqlite_classes": ["PresenceRoom"]
		}
	],
	"vars": {
		// 天御开启时，仅 Pass 可自动上墙；Review / 调用异常始终人工待审，Block 拒绝。
		"DANMAKU_AUTO_APPROVE": "false",
		// 配好 TENCENTCLOUD_SECRET_ID / TENCENTCLOUD_SECRET_KEY 后再开启。
		"TENCENT_TMS_ENABLED": "true",
		"TENCENT_TMS_REGION": "ap-guangzhou"
	}
}
