---
// MomentsClient.astro — 朋友圈客户端逻辑（列表 / 标签 / 详情页共用）
// 重构自三份重复内联脚本；修复：30 天统计滚动归零、Observer 泄漏、
// 重复上报、hashtag 吞标点/误匹配、无限滚动新卡片灯箱失效、分享按钮重复克隆等。
import { umamiConfig } from '../config';

interface Props {
  // 详情页传 false：避免 View 事件与 data-umami-event 属性重复计数
  trackViews?: boolean;
}

const { trackViews = true } = Astro.props;
---

<script define:vars={{ umamiConfig, trackViews }}>
(() => {
  'use strict';

  // ---------- 工具：相对时间 ----------
  function timeAgo(dateString) {
    const date = new Date(dateString);
    const now = new Date();
    const diffInSeconds = Math.floor((now - date) / 1000);

    if (diffInSeconds < 60) return '刚刚';
    if (diffInSeconds < 3600) return `${Math.floor(diffInSeconds / 60)}分钟前`;
    if (diffInSeconds < 86400) return `${Math.floor(diffInSeconds / 3600)}小时前`;
    if (diffInSeconds < 172800) return '昨天';
    if (diffInSeconds < 2592000) return `${Math.floor(diffInSeconds / 86400)}天前`;
    if (diffInSeconds < 31104000) return `${Math.floor(diffInSeconds / 2592000)}个月前`;
    return `${Math.floor(diffInSeconds / 31104000)}年前`;
  }

  function updateRelativeTimes() {
    document.querySelectorAll('.moment-time').forEach((el) => {
      const timeStr = el.getAttribute('data-time');
      if (timeStr) el.textContent = timeAgo(timeStr);
    });
  }

  // ---------- 工具：Hashtag 链接化 ----------
  // 只匹配字母/数字/下划线/连字符（含 CJK），避免把中文标点吞进 tag；
  // 跳过 <pre>/<code> 代码块，避免源码里的 # 被变成链接
  const HASHTAG_TEST = /#[\p{L}\p{N}_-]+/u;
  const HASHTAG_SPLIT = /(#[\p{L}\p{N}_-]+)/gu;

  function processHashtags(root) {
    root.querySelectorAll('.moment-content').forEach((el) => {
      if (el.dataset.hashtagsProcessed) return;
      el.dataset.hashtagsProcessed = 'true';

      const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null, false);
      const nodesToReplace = [];
      let n;
      while ((n = walk.nextNode())) {
        // 跳过代码块 / 行内代码内的文本
        if (n.parentElement && n.parentElement.closest('pre, code')) continue;
        if (HASHTAG_TEST.test(n.nodeValue)) nodesToReplace.push(n);
      }

      nodesToReplace.forEach((node) => {
        const fragment = document.createDocumentFragment();
        const parts = node.nodeValue.split(HASHTAG_SPLIT);
        parts.forEach((part) => {
          if (part && part.startsWith('#')) {
            const a = document.createElement('a');
            a.className = 'hover:underline cursor-pointer text-blue-500';
            a.style.color = '#3b82f6';
            a.textContent = part;
            a.href = '/moments/tag/' + encodeURIComponent(part.substring(1)) + '/';
            a.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              if (window.swup) window.swup.navigate(a.href);
              else window.location.href = a.href;
            });
            fragment.appendChild(a);
          } else if (part) {
            fragment.appendChild(document.createTextNode(part));
          }
        });
        node.parentNode.replaceChild(fragment, node);
      });
    });
  }

  // ---------- 工具：富媒体嵌入（Bilibili / YouTube / 网易云） ----------
  function processMediaEmbeds(root) {
    root.querySelectorAll('.moment-content').forEach((el) => {
      if (el.dataset.mediaProcessed) return;
      el.dataset.mediaProcessed = 'true';

      el.querySelectorAll('a').forEach((a) => {
        const url = a.href;
        let iframeSrc = null;
        let isMusic = false;

        const ytMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/);
        if (ytMatch) iframeSrc = `https://www.youtube.com/embed/${ytMatch[1]}`;

        const biliMatch = url.match(/bilibili\.com\/video\/(BV[\w]+)/);
        if (biliMatch) iframeSrc = `//player.bilibili.com/player.html?bvid=${biliMatch[1]}&page=1&high_quality=1&as_wide=1&allowfullscreen=true`;

        const musicMatch = url.match(/music\.163\.com\/.*id=(\d+)/);
        if (musicMatch) {
          iframeSrc = `//music.163.com/outchain/player?type=2&id=${musicMatch[1]}&auto=0&height=66`;
          isMusic = true;
        }

        if (iframeSrc) {
          const iframe = document.createElement('iframe');
          iframe.src = iframeSrc;
          iframe.className = 'w-full rounded-xl mt-3 shadow-sm border border-black/5 dark:border-white/5';
          iframe.style.height = isMusic ? '86px' : '220px';
          iframe.allowFullscreen = true;

          if (a.parentNode.tagName === 'P' && a.parentNode.textContent.trim() === a.textContent.trim()) {
            a.parentNode.replaceWith(iframe);
          } else {
            a.parentNode.insertBefore(iframe, a.nextSibling);
          }
        }
      });
    });
  }

  // ---------- 1. 分享按钮（Web Share API 优先，降级复制链接） ----------
  function initShareButtons(root) {
    root.querySelectorAll('.moment-share-btn').forEach((btn) => {
      if (btn.dataset.shareInitialized) return;
      btn.dataset.shareInitialized = 'true';

      const flash = () => {
        const icon = btn.querySelector('svg');
        if (icon) icon.style.transform = 'scale(1.2)';
        btn.classList.add('text-green-500');
        setTimeout(() => {
          if (icon) icon.style.transform = 'scale(1)';
          btn.classList.remove('text-green-500');
        }, 1000);
      };

      btn.addEventListener('click', async () => {
        const url = window.location.origin + '/moment/' + btn.dataset.momentId + '/';
        const text = document.querySelector('meta[name="description"]')?.content || document.title || '朋友圈动态';

        // 移动端优先调起系统分享面板（微信/QQ/系统分享）
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title || '朋友圈', text, url });
            flash();
            return;
          } catch (e) {
            if (e && e.name === 'AbortError') return; // 用户取消分享，静默退出
            // 其他错误降级到复制链接
          }
        }

        try {
          await navigator.clipboard.writeText(url);
          flash();
        } catch (e) {
          console.warn('复制链接失败', e);
        }
      });
    });
  }

  // ---------- 2. 展开全文 / 收起 ----------
  function initReadMore(root) {
    root.querySelectorAll('.moment-content-wrapper').forEach((wrapper) => {
      if (wrapper.dataset.foldProcessed) return;
      wrapper.dataset.foldProcessed = 'true';

      const content = wrapper.querySelector('.moment-content');
      const btn = wrapper.querySelector('.moment-read-more');
      if (!content || !btn) return;

      if (content.scrollHeight > content.clientHeight) {
        btn.classList.remove('hidden');
        btn.addEventListener('click', () => {
          const collapsed = content.classList.toggle('line-clamp-6');
          btn.textContent = collapsed ? '展开全文' : '收起';
        });
      }
    });
  }

  // ---------- 3. 点赞（本地点赞态 + Umami 事件） ----------
  function initLikeButtons(root) {
    root.querySelectorAll('.moment-like-btn').forEach((btn) => {
      if (btn.dataset.likeInitialized) return;
      btn.dataset.likeInitialized = 'true';

      const momentId = btn.dataset.momentId;
      const storageKey = `liked_moment_${momentId}`;

      if (localStorage.getItem(storageKey) === 'true') {
        btn.dataset.liked = 'true';
        btn.classList.add('text-red-500');
      }

      btn.addEventListener('click', function () {
        if (this.dataset.liked === 'true') return;
        this.dataset.liked = 'true';
        this.classList.add('text-red-500');
        localStorage.setItem(storageKey, 'true');

        const span = this.querySelector('.like-count');
        if (span) {
          const current = parseInt(span.textContent, 10) || 0;
          span.textContent = current + 1;
        }

        if (window.umami) window.umami.track(`Like_${momentId}`);

        const icon = this.querySelector('svg');
        if (icon) {
          icon.style.transform = 'scale(1.3)';
          setTimeout(() => { icon.style.transform = 'scale(1)'; }, 200);
        }
      });
    });
  }

  // ---------- 4. 浏览计数（单例 IntersectionObserver，杜绝重复上报与泄漏） ----------
  let viewObserver = null;

  function initViewTracking(root) {
    if (!trackViews) return;
    if (!umamiConfig.enable || !window.umami) return;

    if (!viewObserver) {
      viewObserver = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const momentId = entry.target.dataset.momentId;
            if (momentId) {
              window.umami.track(`View_${momentId}`);
              obs.unobserve(entry.target); // 同一会话只上报一次
            }
          }
        });
      }, { threshold: 0.5 });
    }

    root.querySelectorAll('.moment-card').forEach((card) => {
      if (!card.dataset.momentId) {
        const id = (card.id || '').replace(/^moment-/, '');
        if (id) card.dataset.momentId = id;
      }
      if (card.dataset.momentId && !card.dataset.viewTracked) {
        card.dataset.viewTracked = 'true';
        viewObserver.observe(card);
      }
    });
  }

  // ---------- 5. 卡片点击跳详情（全局一次性事件委托） ----------
  function initCardClick() {
    if (window._momentCardClickInit) return;
    window._momentCardClickInit = true;

    document.addEventListener('click', (e) => {
      const card = e.target.closest('.moment-card');
      if (!card) return;

      // 忽略交互元素上的点击
      if (e.target.closest('a') || e.target.closest('button') || e.target.closest('.moment-view-btn') || e.target.closest('img')) {
        return;
      }

      const idAttr = card.id;
      if (!idAttr || !idAttr.startsWith('moment-')) return;
      const momentId = idAttr.replace('moment-', '');

      if (window.swup) window.swup.navigate(`/moment/${momentId}/`);
      else window.location.href = `/moment/${momentId}/`;
    });
  }

  // ---------- 6. 无限滚动（加载更多卡片） ----------
  let infiniteObserver = null;

  function initInfiniteScroll() {
    const trigger = document.getElementById('infinite-scroll-trigger');
    if (!trigger) return;

    // 防止 swup 导航后旧 observer 继续监听已移除的节点
    if (infiniteObserver) infiniteObserver.disconnect();

    infiniteObserver = new IntersectionObserver(async (entries) => {
      if (!entries[0].isIntersecting) return;
      const nextUrl = trigger.getAttribute('data-next-url');
      if (!nextUrl) return;
      if (trigger.dataset.loading === 'true') return;
      trigger.dataset.loading = 'true';

      try {
        const res = await fetch(nextUrl);
        const html = await res.text();

        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const newCards = doc.querySelectorAll('#moments-container .moment-card');
        const container = document.getElementById('moments-container');
        if (!container) return;

        newCards.forEach((card) => container.appendChild(card));

        const newTrigger = doc.getElementById('infinite-scroll-trigger');
        if (newTrigger && newTrigger.getAttribute('data-next-url')) {
          trigger.setAttribute('data-next-url', newTrigger.getAttribute('data-next-url'));
          trigger.dataset.loading = 'false';
        } else {
          trigger.style.display = 'none';
          const pagination = document.getElementById('standard-pagination');
          if (pagination) pagination.classList.remove('hidden');
          infiniteObserver.disconnect();
        }

        // 处理新卡片，并通知 Layout 重新绑定图片灯箱
        processMomentDOM(container);
        initLikeButtons(container);
        initViewTracking(container);
        document.dispatchEvent(new CustomEvent('moments:cards-appended'));
      } catch (error) {
        console.error('Infinite scroll failed:', error);
        trigger.dataset.loading = 'false';
      }
    }, { rootMargin: '200px' });

    infiniteObserver.observe(trigger);
  }

  // ---------- 7. 随机一条朋友圈 ----------
  function initRandomButton() {
    const btn = document.getElementById('random-moment-btn');
    if (!btn) return;
    if (btn.dataset.randomInit) return;
    btn.dataset.randomInit = 'true';

    btn.addEventListener('click', () => {
      let slugs = [];
      try {
        slugs = JSON.parse(btn.dataset.slugs || '[]');
      } catch (e) {
        console.warn('随机一条：无法解析 slugs', e);
        return;
      }
      if (!slugs.length) return;

      const slug = slugs[Math.floor(Math.random() * slugs.length)];
      const url = `/moment/${slug}/`;
      if (window.swup) window.swup.navigate(url);
      else window.location.href = url;
    });
  }

  // ---------- 8. 那年今日 ----------
  function initMemory() {
    const el = document.getElementById('memory-moment');
    if (!el || el.dataset.memoryInit) return;
    el.dataset.memoryInit = 'true';

    let map = {};
    try {
      map = JSON.parse(el.dataset.memoryMap || '{}');
    } catch (e) {
      console.warn('那年今日：无法解析记忆索引', e);
      return;
    }

    const now = new Date();
    const key = `${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const today = `${now.getFullYear()}-${key}`;

    // 命中今天、且排除今天刚发的动态（已经在列表里了）
    const entries = (map[key] || []).filter((e) => e.date !== today);
    if (!entries.length) return;

    // 年份越久越靠前？不——最新年份的优先展示，最多 2 条
    entries.sort((a, b) => b.date.localeCompare(a.date));
    const items = entries.slice(0, 2).map((e) => {
      const yearDiff = now.getFullYear() - new Date(e.date).getFullYear();
      const label = yearDiff <= 1 ? '去年今日' : `${yearDiff} 年前`;
      const esc = (s) =>
        String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      return `<a href="/moment/${esc(e.slug)}/" class="group flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-[var(--primary)]/10 transition">
        <span class="shrink-0 text-xs font-bold text-[var(--primary)]">${label}</span>
        <span class="shrink-0 text-xs text-[var(--text-color-light)] tabular-nums">${esc(e.date)}</span>
        <span class="flex-1 truncate text-sm text-[var(--text-color)] group-hover:text-[var(--primary)] transition">${esc(e.text) || '（无文字内容）'}</span>
        <span class="shrink-0 text-[var(--text-color-light)] group-hover:translate-x-0.5 transition">→</span>
      </a>`;
    }).join('');

    el.querySelector('#memory-list').innerHTML = items;
    el.classList.remove('hidden');
  }

  // ---------- 9. Umami 统计（走全局带缓存 helper，全量数据不滚动归零） ----------
  async function loadMomentStats() {
    if (!umamiConfig.enable) return;
    if (!window.fetchUmamiEvents) return;

    try {
      const statsData = await window.fetchUmamiEvents(umamiConfig.baseUrl, umamiConfig.shareId, {});
      const items = Array.isArray(statsData) ? statsData : [];

      items.forEach((item) => {
        if (!item || typeof item.x !== 'string') return;
        if (item.x.startsWith('Like_')) {
          const momentId = item.x.slice(5);
          const span = document.getElementById(`like-count-${momentId}`);
          if (span) {
            const current = parseInt(span.textContent, 10) || 0;
            if (item.y > current) span.textContent = item.y;
          }
        } else if (item.x.startsWith('View_')) {
          const momentId = item.x.slice(5);
          const span = document.getElementById(`view-count-${momentId}`);
          if (span) span.textContent = item.y;
        }
      });
    } catch (error) {
      console.error('获取朋友圈点赞/浏览数据失败:', error);
    }
  }

  // ---------- 朋友圈搜索 ----------
  function initSearch() {
    const box = document.getElementById('moment-search');
    const input = document.getElementById('moment-search-input');
    const results = document.getElementById('moment-search-results');
    if (!box || !input || !results) return;
    if (window.__momentSearchInit) return;
    window.__momentSearchInit = true;

    const esc = (s) =>
      String(s ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]),
      );

    let index = null;
    const loadIndex = async () => {
      if (index) return index;
      const res = await fetch('/api/moments/search.json', {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(`search index HTTP ${res.status}`);
      index = await res.json();
      return index;
    };

    let timer = null;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const q = input.value.trim().toLowerCase();
        if (!q) {
          results.classList.add('hidden');
          results.innerHTML = '';
          return;
        }
        try {
          const data = await loadIndex();
          const terms = q.split(/\s+/).filter(Boolean);
          const hits = data
            .filter((item) => {
              const hay =
                `${item.text} ${(item.tags || []).join(' ')} ${item.date} ${item.author}`.toLowerCase();
              return terms.every((t) => hay.includes(t));
            })
            .slice(0, 20);

          results.classList.remove('hidden');
          if (hits.length === 0) {
            results.innerHTML = `<div class="text-sm text-[var(--text-color-light)] py-2">没有找到与「${esc(q)}」相关的动态喵~</div>`;
          } else {
            results.innerHTML = hits
              .map(
                (h) => `<a href="/moment/${encodeURIComponent(h.slug)}/" class="group flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-[var(--primary)]/10 transition">
                  <span class="shrink-0 text-xs text-[var(--text-color-light)] tabular-nums">${esc(h.date)}</span>
                  <span class="flex-1 truncate text-sm text-[var(--text-color)] group-hover:text-[var(--primary)] transition">${esc(h.text) || '（无文字内容）'}</span>
                </a>`,
              )
              .join('');
          }
        } catch (error) {
          console.warn('朋友圈搜索索引加载失败:', error);
        }
      }, 200);
    });
  }

  // ---------- 统一入口 ----------
  function processMomentDOM(root) {
    updateRelativeTimes();
    processHashtags(root);
    processMediaEmbeds(root);
    initShareButtons(root);
    initReadMore(root);
  }

  // ---------- 新动态小红点（localStorage 标记已读） ----------
  function initNewBadge() {
    const badge = document.getElementById('moment-new-badge');
    if (!badge || badge.dataset.badgeInitialized) return;
    badge.dataset.badgeInitialized = 'true';

    const KEY = 'moments_last_visit';
    const latest = Date.parse(badge.dataset.latest || '');
    if (Number.isNaN(latest)) return;

    let lastVisit = 0;
    try {
      lastVisit = parseInt(localStorage.getItem(KEY) || '0', 10);
    } catch (e) {
      return; // 隐私模式等 localStorage 不可用
    }

    if (!lastVisit) {
      // 首次访问：记录基线，不打扰
      try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
      return;
    }

    if (latest > lastVisit) {
      badge.classList.remove('hidden');
      badge.style.display = 'flex';
    }

    badge.addEventListener('click', () => {
      try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
      badge.classList.add('hidden');
      badge.style.display = 'none';
    });
  }

  // 更多菜单：按钮 + fixed 菜单（移到 body 避免被 card-base overflow-hidden 裁剪）
  function initMoreMenu() {
    const btn = document.getElementById('moments-more-btn');
    const menu = document.getElementById('moments-more-menu');
    if (!btn || !menu || btn.dataset.moreBound === '1') return;
    btn.dataset.moreBound = '1';

    // 移除 body 里残留的旧菜单（Swup 页面切换后）
    document.querySelectorAll('#moments-more-menu').forEach((el) => {
      if (el !== menu) el.remove();
    });
    document.body.appendChild(menu);
    menu.style.display = 'none';

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (menu.style.display === 'flex') {
        menu.style.display = 'none';
        return;
      }
      const r = btn.getBoundingClientRect();
      menu.style.display = 'flex';
      const mw = menu.offsetWidth;
      let left = r.right - mw;
      left = Math.max(8, Math.min(left, window.innerWidth - mw - 8));
      menu.style.left = left + 'px';
      menu.style.top = r.bottom + 6 + 'px';
    });

    // 全局关闭监听只挂一次（菜单被移到 body，查 id 即可）
    if (!window.__moreMenuBound) {
      window.__moreMenuBound = true;
      document.addEventListener('click', (e) => {
        const m = document.getElementById('moments-more-menu');
        const b = document.getElementById('moments-more-btn');
        if (m && m.style.display === 'flex' && !m.contains(e.target) && e.target !== b) {
          m.style.display = 'none';
        }
      });
      window.addEventListener('scroll', () => {
        const m = document.getElementById('moments-more-menu');
        if (m) m.style.display = 'none';
      }, { passive: true });
      window.addEventListener('resize', () => {
        const m = document.getElementById('moments-more-menu');
        if (m) m.style.display = 'none';
      });
    }
  }

  function initAll() {
    processMomentDOM(document);
    initLikeButtons(document);
    initViewTracking(document);
    initCardClick();
    initInfiniteScroll();
    initRandomButton();
    initMemory();
    initSearch();
    initNewBadge();
    initMoreMenu();
    loadMomentStats();

    // 每 60s 刷新相对时间，避免停留页面时时间显示过期
    if (!window.__momentTimeTimer) {
      window.__momentTimeTimer = setInterval(updateRelativeTimes, 60000);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
  document.addEventListener('swup:page:view', initAll);
})();
</script>