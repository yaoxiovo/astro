---
// PosterGenerator.astro
import { Icon } from "astro-icon/components";
import authorsConfig from "../content/moments/authors.json";

interface Props {
  title: string;
  excerpt: string;
  author: string;
  images?: string[]; // 完整图片 URL 列表（用于随机背景；朋友圈动态传入，文章页可为空）
  coverImage?: string; // 兼容文章页：封面图优先并入背景候选
}

const { title, excerpt, author, images = [], coverImage } = Astro.props;

// 背景图候选：封面优先 + 动态图片，去重
const bgCandidates = Array.from(new Set(
  [coverImage, ...images].filter((u): u is string => !!u)
));

// 动态判断V认证主体和颜色
let verifiedIconColor = "";
let verifiedEntity = "";

const role = (authorsConfig as any)[author];
if (role) {
  if (role.verifyType === "blue") {
    verifiedIconColor = "text-blue-500";
    verifiedEntity = role.verifySubject || "企业官方认证";
  } else if (role.verifyType === "yellow") {
    verifiedIconColor = "text-yellow-500";
    verifiedEntity = role.verifySubject || "个人博主认证";
  }
}
---

<button id="generate-poster-btn" class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] text-[var(--btn-content)] text-xs font-medium transition-all active:scale-95">
  <Icon name="material-symbols:image-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform" />
  分享海报
</button>

<!-- 隐藏的海报 DOM 结构（深色主题：随机图背景 + 遮罩 + 白字；无图时品牌渐变兜底） -->
<div id="poster-hidden-container" class="fixed top-[-9999px] left-[-9999px] w-[400px] text-white p-6 rounded-2xl shadow-2xl overflow-hidden relative"
  style="z-index: -99; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
  <!-- 背景图（JS 随机选择并设置；遮罩保证文字可读） -->
  <div id="poster-bg-overlay" class="absolute inset-0 bg-black/60 hidden z-0"></div>

  <div class="relative z-10 flex flex-col min-h-[420px]">
    <!-- 标题 -->
    <h1 class="text-2xl font-bold mb-3 leading-snug" style="font-family: sans-serif;">{title}</h1>

    <!-- 摘要（完整文字，不再截断；max-height 交给内容撑开） -->
    <p class="text-gray-200 text-sm leading-relaxed mb-6 whitespace-pre-wrap flex-1" style="word-break: break-word;">
      {excerpt}
    </p>

    <!-- 底部信息 -->
    <div class="flex items-center justify-between border-t border-white/10 pt-4 mt-auto">
      <div class="flex flex-col">
        <span class="text-xs text-gray-400 mb-1">Author</span>
        <div class="flex items-center gap-1">
          <span class="text-sm font-bold text-white">{author}</span>
          {verifiedEntity && (
            <div class="flex items-center gap-0.5 mt-0.5">
              <Icon name="material-symbols:verified" class={`text-[0.9rem] ${verifiedIconColor}`} />
              <span class={`text-[0.65rem] ${verifiedIconColor} font-medium`}>{verifiedEntity}</span>
            </div>
          )}
        </div>
      </div>

      <div class="flex flex-col items-end">
        <span class="text-xs text-gray-400 mb-1">来自博客</span>
        <span class="text-sm font-bold text-gray-100">Yaoxi Blog</span>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ images: bgCandidates }}>
  function initPoster() {
    const btn = document.getElementById('generate-poster-btn');
    if (!btn || btn.dataset.initialized) return;
    btn.dataset.initialized = 'true';

    btn.addEventListener('click', async () => {
      const container = document.getElementById('poster-hidden-container');
      if (!container) return;

      const originalText = btn.innerHTML;
      btn.innerHTML = `<span class="animate-spin inline-block w-3 h-3 border-2 border-current border-t-transparent rounded-full mr-1"></span> 生成中...`;
      btn.style.pointerEvents = 'none';

      try {
        // 1) 随机选一张图片作为背景（CORS 探测失败则降级为渐变底）
        let bgApplied = false;
        if (images && images.length > 0) {
          const candidates = images.slice().sort(() => Math.random() - 0.5); // 洗牌，随机挑
          for (const url of candidates) {
            try {
              const res = await fetch(url, { method: 'GET', mode: 'cors' });
              if (res.ok) {
                container.style.backgroundImage = `url("${url}")`;
                container.style.backgroundSize = 'cover';
                container.style.backgroundPosition = 'center';
                const overlay = document.getElementById('poster-bg-overlay');
                if (overlay) overlay.classList.remove('hidden');
                bgApplied = true;
                break;
              }
            } catch (e) { /* 该图 CORS 失败，试下一张 */ }
          }
        }

        if (!(window as any).htmlToImage) {
           await new Promise((resolve, reject) => {
             const s = document.createElement('script');
             s.src = "https://cdn.staticfile.net/html-to-image/1.11.11/html-to-image.min.js";
             s.onload = resolve;
             s.onerror = () => {
                 const s2 = document.createElement('script');
                 s2.src = "https://cdnjs.cloudflare.com/ajax/libs/html-to-image/1.11.11/html-to-image.min.js";
                 s2.onload = resolve;
                 s2.onerror = () => reject(new Error("Failed to load html-to-image from all CDNs."));
                 document.head.appendChild(s2);
             };
             document.head.appendChild(s);
           });
        }

        // 2) 临时将容器移入可视区域，避免因元素在屏幕外而渲染为空白
        const originalClasses = container.className;
        const originalCssText = container.style.cssText;
        container.classList.remove('top-[-9999px]', 'left-[-9999px]');
        container.style.cssText = 'position: fixed; top: 0px; left: 0px; z-index: -9999; pointer-events: none; opacity: 1;';

        // 3) 稍微等待，确保浏览器完成重排（背景图可能未就绪，等待一下）
        await new Promise(resolve => setTimeout(resolve, 150));

        // 4) 预热渲染（应对 Safari 首次渲染空白的 Bug）
        try { await (window as any).htmlToImage.toPng(container, { pixelRatio: 1 }); } catch(e) {}

        // 5) 正式渲染高清海报
        const url = await (window as any).htmlToImage.toPng(container, {
          pixelRatio: 2, // 高清
          backgroundColor: '#0f172a'
        });

        // 6) 恢复隐藏状态
        container.className = originalClasses;
        container.style.cssText = originalCssText;

        // 7) 下载图片
        const a = document.createElement('a');
        a.href = url;
        a.download = `share-poster-${Date.now()}.png`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        // 8) 将链接写入剪贴板
        try {
          await navigator.clipboard.writeText(window.location.href);
        } catch(e) {
          console.warn("Failed to copy url to clipboard", e);
        }

        // 9) 临时修改按钮文本提示成功
        btn.innerHTML = `<span style="color: #10b981; margin-right: 0.25rem;">✔</span> 链接已复制`;
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.style.pointerEvents = 'auto';
        }, 2000);
      } catch (err) {
        console.error('Failed to generate poster', err);
        alert(`海报生成失败: ${err.message || err}`);
        btn.innerHTML = originalText;
        btn.style.pointerEvents = 'auto';
      }
    });
  }

  initPoster();
  document.addEventListener('swup:page:view', initPoster);
</script>