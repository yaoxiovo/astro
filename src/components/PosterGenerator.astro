---
// PosterGenerator.astro
import { Icon } from "astro-icon/components";
import authorsConfig from "../content/moments/authors.json";

interface Props {
  title: string;
  excerpt: string;
  author: string;
  images?: string[]; // 完整图片 URL 列表（用于随机背景；朋友圈动态传入，文章页可为空）
  coverImage?: string; // 兼容文章页：封面图优先并入背景候选
}

const { title, excerpt, author, images = [], coverImage } = Astro.props;

// 背景图候选：封面优先 + 动态图片，去重
const bgCandidates = Array.from(new Set(
  [coverImage, ...images].filter((u): u is string => !!u)
));

// 动态判断V认证主体和颜色
let verifiedIconColor = "";
let verifiedEntity = "";

const role = (authorsConfig as any)[author];
if (role) {
  if (role.verifyType === "blue") {
    verifiedIconColor = "text-blue-500";
    verifiedEntity = role.verifySubject || "企业官方认证";
  } else if (role.verifyType === "yellow") {
    verifiedIconColor = "text-yellow-500";
    verifiedEntity = role.verifySubject || "个人博主认证";
  }
}
---

<button id="generate-poster-btn" data-poster-btn class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] text-[var(--btn-content)] text-xs font-medium transition-all active:scale-95">
  <Icon name="material-symbols:image-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform" />
  分享海报
</button>

<!--
  隐藏的海报 DOM（深色主题：随机图背景 + 遮罩 + 白字；无图时品牌渐变兜底）
  关键修复：
  1. 用 display:none 内联隐藏 —— 不占文档流、不撑爆布局；即使 JS 全部失效也不可见
  2. 不依赖 Tailwind position 类（避免 fixed/relative 互相覆盖的坑），全部内联 style
  3. 渲染时由 JS 临时 display:block 并移入视口左上角，渲染后 finally 恢复隐藏
-->
<div id="poster-hidden-container"
  style="display:none; position:fixed; top:0; left:0; width:400px; z-index:9999; overflow:hidden; border-radius:1rem; box-shadow:0 25px 50px -12px rgba(0,0,0,0.5); background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%);">
  <!-- 背景遮罩：随机图背景时 JS 显示，保证文字可读 -->
  <div id="poster-bg-overlay" style="display:none; position:absolute; inset:0; background:rgba(0,0,0,0.6);"></div>

  <div style="position:relative; z-index:10; display:flex; flex-direction:column; min-height:420px; padding:1.5rem; color:#fff;">
    <!-- 标题 -->
    <h1 style="font-size:1.5rem; font-weight:700; margin:0 0 0.75rem; line-height:1.3; font-family:sans-serif;">{title}</h1>

    <!-- 摘要（完整文字，不再截断；高度由内容自然撑开） -->
    <p style="flex:1; font-size:0.875rem; color:#e5e7eb; line-height:1.7; margin:0 0 1.5rem; white-space:pre-wrap; word-break:break-word;">
      {excerpt}
    </p>

    <!-- 底部信息 -->
    <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.1); padding-top:1rem;">
      <div style="display:flex; flex-direction:column;">
        <span style="font-size:0.75rem; color:#9ca3af; margin-bottom:0.25rem;">Author</span>
        <div style="display:flex; align-items:center; gap:0.25rem;">
          <span style="font-size:0.875rem; font-weight:700; color:#fff;">{author}</span>
          {verifiedEntity && (
            <div style="display:flex; align-items:center; gap:0.125rem; margin-top:0.125rem;">
              <Icon name="material-symbols:verified" class={`text-[0.9rem] ${verifiedIconColor}`} />
              <span class={`text-[0.65rem] ${verifiedIconColor} font-medium`}>{verifiedEntity}</span>
            </div>
          )}
        </div>
      </div>

      <div style="display:flex; flex-direction:column; align-items:flex-end;">
        <span style="font-size:0.75rem; color:#9ca3af; margin-bottom:0.25rem;">来自博客</span>
        <span style="font-size:0.875rem; font-weight:700; color:#f3f4f6;">Yaoxi Blog</span>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ images: bgCandidates }}>
  (function () {
    const SELECTOR = "#generate-poster-btn, [data-poster-btn]";
    const CONTAINER_ID = "poster-hidden-container";
    const OVERLAY_ID = "poster-bg-overlay";
    let busy = false;

    // 事件委托 + 全局标记：脚本无论执行多少次都只注册一次委托，
    // document 级监听在 Swup 导航/DOM 替换后依然有效 —— 按钮永远有反应
    if (window.__posterDelegate) return;
    window.__posterDelegate = true;

    document.addEventListener("click", async (e) => {
      const target = e.target;
      if (!target || !target.closest || busy) return;
      const btn = target.closest(SELECTOR);
      if (!btn) return;

      const container = document.getElementById(CONTAINER_ID);
      if (!container) return;
      const overlay = document.getElementById(OVERLAY_ID);

      busy = true;
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span class="animate-spin inline-block w-3 h-3 border-2 border-current border-t-transparent rounded-full mr-1"></span> 生成中...';
      btn.style.pointerEvents = "none";

      try {
        // 1) 随机选一张 CORS 可加载的图片作为背景（并行探测，带 4s 超时）
        if (images && images.length > 0) {
          const candidates = images.slice().sort(() => Math.random() - 0.5).slice(0, 5);
          const probe = async (url) => {
            const ctrl = new AbortController();
            const timer = setTimeout(() => ctrl.abort(), 4000);
            try {
              const res = await fetch(url, { method: "GET", mode: "cors", signal: ctrl.signal });
              if (!res.ok) throw new Error("bad status " + res.status);
              return url;
            } finally {
              clearTimeout(timer);
            }
          };
          const results = await Promise.allSettled(candidates.map(probe));
          const hit = results.find((r) => r.status === "fulfilled");
          if (hit) {
            const url = String(hit.value).replace(/'/g, "\\'");
            container.style.backgroundImage = "url('" + url + "')";
            container.style.backgroundSize = "cover";
            container.style.backgroundPosition = "center";
            if (overlay) overlay.style.display = "block";
          }
        }

        // 2) 确保 html-to-image 已加载（双 CDN 降级）
        if (!window.htmlToImage) {
          await new Promise((resolve, reject) => {
            const load = (src, onFail) => {
              const s = document.createElement("script");
              s.src = src;
              s.onload = resolve;
              s.onerror = onFail;
              document.head.appendChild(s);
            };
            load("https://cdn.staticfile.net/html-to-image/1.11.11/html-to-image.min.js", () => {
              load("https://cdnjs.cloudflare.com/ajax/libs/html-to-image/1.11.11/html-to-image.min.js", () => {
                reject(new Error("无法加载 html-to-image 库（两个 CDN 均失败）"));
              });
            });
          });
        }

        // 3) 临时显示容器（移入视口左上角），等待重排与背景图就绪
        container.style.display = "block";
        await new Promise((resolve) => setTimeout(resolve, 200));

        // 4) 预热渲染（规避 Safari 首次渲染空白的 Bug）
        try {
          await window.htmlToImage.toPng(container, { pixelRatio: 1 });
        } catch (e) { /* 预热失败可忽略 */ }

        // 5) 正式渲染高清海报
        const dataUrl = await window.htmlToImage.toPng(container, {
          pixelRatio: 2,
          backgroundColor: "#0f172a"
        });

        // 6) 下载图片
        const a = document.createElement("a");
        a.href = dataUrl;
        a.download = "share-poster-" + Date.now() + ".png";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        // 7) 复制当前链接
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(window.location.href);
          }
        } catch (e) {
          console.warn("复制链接失败", e);
        }

        // 8) 成功提示
        btn.innerHTML = '<span style="color:#10b981; margin-right:0.25rem;">✔</span> 链接已复制';
        setTimeout(() => { btn.innerHTML = originalText; }, 2000);
      } catch (err) {
        console.error("Failed to generate poster", err);
        alert("海报生成失败：" + ((err && err.message) || err));
        btn.innerHTML = originalText;
      } finally {
        // 9) 无论成功失败，恢复容器隐藏状态 —— 永不占位、永不爆版
        container.style.display = "none";
        container.style.backgroundImage = "";
        if (overlay) overlay.style.display = "none";
        btn.style.pointerEvents = "auto";
        busy = false;
      }
    });
  })();
</script>