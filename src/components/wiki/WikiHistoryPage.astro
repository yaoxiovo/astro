---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import type { WikiPostHistory } from "../../types/wiki";
import WikiHistoryTable from "./WikiHistoryTable.svelte";
import WikiQualityBadge from "./WikiQualityBadge.astro";

interface Props {
	entry: Record<string, unknown> & { id: string; data: { title: string } };
	history: WikiPostHistory;
}

const { entry, history } = Astro.props;
const slug = entry.id.replace(/\.[^/.]+$/, "");
const pageTitle = `“${entry.data.title}”的修订历史 - 维基百科风格版本记录`;
---

<MainGridLayout title={pageTitle} description={`查看《${entry.data.title}》的完整 Git 修订历史与版本比对`}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 pt-6 pb-6 relative w-full">
            <!-- 维基百科经典导航返回栏 -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-[var(--line-divider)]">
                <div>
                    <a href={`/posts/${slug}/`} class="text-xs text-[var(--primary)] hover:underline inline-flex items-center gap-1 font-medium mb-1.5">
                        <Icon name="material-symbols:arrow-back" class="text-sm" />
                        <span>返回文章《{entry.data.title}》</span>
                    </a>
                    <h1 class="text-2xl md:text-3xl font-bold text-black/90 dark:text-white/90 flex items-center gap-2">
                        <span>“{entry.data.title}”的修订历史</span>
                    </h1>
                </div>

                <div class="flex items-center gap-2.5">
                    <WikiQualityBadge slug={slug} />
                    <a
                        href={`https://github.com/yaoxiovo/astro/commits/main/${history?.filePath || `src/content/posts/${entry.id}`}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-3 py-1.5 rounded-lg text-xs font-medium border border-[var(--line-divider)] hover:bg-black/5 dark:hover:bg-white/10 transition-colors inline-flex items-center gap-1.5 text-black/70 dark:text-white/70"
                    >
                        <Icon name="fa6-brands:github" class="text-sm" />
                        <span>在 GitHub 查看 Commits</span>
                    </a>
                </div>
            </div>

            <!-- 说明引言 (MediaWiki Help Notice) -->
            <div class="mb-5 p-3.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-[var(--line-divider)] text-xs text-black/60 dark:text-white/60 leading-relaxed">
                <p>
                    下方展示了此页面的全部 Git 提交修订记录。您可以通过左右单选按钮（左选旧版，右选新版）选择任意两个版本，并点击<strong>“比较所选版本”</strong>查看行内字符级差异（Word-level Diff）。点击时间戳可直接进入该历史时间点的快照永久链接。
                </p>
            </div>

            <!-- 维基历史表格核心组件 -->
            <WikiHistoryTable history={history} slug={slug} standalone={true} client:load />
        </div>
    </div>
</MainGridLayout>
