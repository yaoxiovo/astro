---
import { Icon } from "astro-icon/components";
import type { WikiRevision } from "../../types/wiki";

interface Props {
	slug: string;
	currentRevision: WikiRevision;
	latestRevision: WikiRevision;
	prevRevision?: WikiRevision;
	nextRevision?: WikiRevision;
}

const { slug, currentRevision, latestRevision, prevRevision, nextRevision } =
	Astro.props;
const isLatest = currentRevision.sha === latestRevision.sha;
---

<div class="wiki-revision-notice mb-6 p-4 rounded-2xl border border-amber-500/30 bg-amber-500/[0.08] dark:bg-amber-500/[0.12] text-amber-900 dark:text-amber-200 text-xs transition-all shadow-sm">
	<div class="flex items-start gap-3">
		<div class="w-7 h-7 rounded-xl bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
			<Icon name="material-symbols:history" class="text-base" />
		</div>

		<div class="flex-1 min-w-0">
			<div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
				<h4 class="font-bold text-sm text-amber-950 dark:text-amber-100 flex items-center gap-1.5">
					<span>维基历史修订版本 (Historical Revision)</span>
					<span class="font-mono text-xs px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-800 dark:text-amber-300">
						{currentRevision.shortSha}
					</span>
				</h4>

				<span class="text-[11px] text-amber-800/60 dark:text-amber-300/60">
					MediaWiki 永久链 (Permalink)
				</span>
			</div>

			<p class="text-amber-900/80 dark:text-amber-200/80 leading-relaxed mb-3">
				这是由贡献者 <strong class="font-semibold text-amber-950 dark:text-amber-100">{currentRevision.author}</strong> 于 
				<strong class="font-semibold text-amber-950 dark:text-amber-100">{currentRevision.displayDate}</strong> 提交的修订快照。
				{currentRevision.message && (
					<span class="block mt-1 text-[11px] text-amber-900/70 dark:text-amber-300/70 italic">
						编辑摘要：“{currentRevision.message}”
					</span>
				)}
				{!isLatest && (
					<span class="inline-block mt-1 font-medium text-amber-700 dark:text-amber-300">
						⚠️ 注意：此快照可能包含过时或已被更正的信息。
					</span>
				)}
			</p>

			<!-- 维基百科经典导航快捷链 -->
			<div class="flex flex-wrap items-center gap-2 pt-2.5 border-t border-amber-500/20 text-[11px] font-medium">
				<a
					href={`/posts/${slug}/`}
					class="px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-900 dark:text-amber-100 transition-colors inline-flex items-center gap-1"
				>
					<Icon name="material-symbols:arrow-back" class="text-xs" />
					<span>返回当前最新文章</span>
				</a>

				<a
					href={`/posts/${slug}/history/`}
					class="px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition-colors inline-flex items-center gap-1"
				>
					<Icon name="material-symbols:list-alt" class="text-xs" />
					<span>查看全部修订历史</span>
				</a>

				{prevRevision && (
					<a
						href={`/posts/${slug}/revision/${prevRevision.shortSha}/`}
						class="px-2 py-1 rounded-lg hover:underline text-amber-800 dark:text-amber-200"
						title={`更旧的版本: ${prevRevision.displayDate}`}
					>
						← 更旧的版本
					</a>
				)}

				{nextRevision && (
					<a
						href={`/posts/${slug}/revision/${nextRevision.shortSha}/`}
						class="px-2 py-1 rounded-lg hover:underline text-amber-800 dark:text-amber-200"
						title={`更新的版本: ${nextRevision.displayDate}`}
					>
						更新的版本 →
					</a>
				)}

				{currentRevision.diffUrl && (
					<a
						href={currentRevision.diffUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="ml-auto text-amber-800/70 hover:text-amber-950 dark:text-amber-300/70 dark:hover:text-amber-100 hover:underline inline-flex items-center gap-1"
					>
						<Icon name="fa6-brands:github" class="text-xs" />
						<span>GitHub Commit</span>
					</a>
				)}
			</div>
		</div>
	</div>
</div>
