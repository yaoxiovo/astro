---
import type { CollectionEntry } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
// RelatedReading.astro - 编辑编排的站内延伸阅读指引（互链 / 单向指引）
// 数据源：frontmatter `related: ["slug", ...]`
// 可见性：仅渲染当前构建可见的条目（生产环境自动过滤 draft 目标）
import { Icon } from "astro-icon/components";

interface Props {
	slug: string;
	related?: string[];
	allPosts: CollectionEntry<"posts">[];
}

const { slug, related = [], allPosts } = Astro.props;

function normalizeSlug(value: string): string {
	return String(value).replace(/\.md$/i, "").replace(/\/+$/, "");
}

const currentSlug = normalizeSlug(slug);
const visiblePosts = new Map(
	allPosts.map((post) => [normalizeSlug(post.id), post]),
);

const entries: {
	slug: string;
	title: string;
	description: string;
	dateText: string;
	mutual: boolean;
}[] = [];
const seen = new Set<string>();
for (const raw of related) {
	const itemSlug = normalizeSlug(raw);
	if (itemSlug === currentSlug || seen.has(itemSlug)) continue;
	const target = visiblePosts.get(itemSlug);
	if (!target) continue;
	seen.add(itemSlug);
	entries.push({
		slug: itemSlug,
		title: target.data.title,
		description: target.data.description || "",
		dateText: formatDateToYYYYMMDD(target.data.published),
		mutual: (target.data.related || []).some(
			(value: string) => normalizeSlug(value) === currentSlug,
		),
	});
}
---

{entries.length > 0 && (
	<div class="mb-6 p-5 rounded-2xl border border-[var(--line-divider)] bg-black/[0.02] dark:bg-white/[0.02] shadow-sm onload-animation">
		<div class="flex items-center justify-between mb-4 pb-3 border-b border-[var(--line-divider)]">
			<div class="flex items-center gap-2">
				<Icon name="material-symbols:auto-stories" class="text-lg text-[var(--primary)]" />
				<h3 class="text-sm font-bold text-black/90 dark:text-white/90">延伸阅读 (See Also)</h3>
				<span class="px-2 py-0.5 rounded-full text-[10px] bg-black/5 dark:bg-white/10 font-mono text-black/50 dark:text-white/50">
					{entries.length} 篇
				</span>
			</div>
			<span class="text-[11px] text-black/40 dark:text-white/40">编辑精选的站内指引</span>
		</div>

		<ul class="flex flex-col gap-1.5">
			{entries.map((item) => (
				<li class="px-3 py-2.5 rounded-lg bg-black/[0.02] dark:bg-white/[0.03] hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors">
					<div class="flex items-start justify-between gap-3">
						<div class="min-w-0 flex-1">
							<a
								href={getPostUrlBySlug(item.slug)}
								class="text-xs font-semibold text-[var(--primary)] hover:underline"
								title={item.title}
							>
								{item.title}
							</a>
							{item.description && (
								<p class="mt-1 text-[11px] text-black/50 dark:text-white/50 leading-relaxed line-clamp-2">
									{item.description}
								</p>
							)}
						</div>
						<div class="flex flex-col items-end gap-1 shrink-0">
							{item.mutual ? (
								<span
									class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-[10px] font-mono bg-[var(--primary)]/10 text-[var(--primary)]"
									title="双方文章均互相指引（互链）"
								>
									<Icon name="material-symbols:swap-horiz" class="text-[0.75rem]" />
									互链
								</span>
							) : (
								<span
									class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-[10px] font-mono bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50"
									title="本文单方面指引该文（单向）"
								>
									<Icon name="material-symbols:east" class="text-[0.75rem]" />
									单向指引
								</span>
							)}
							<span class="text-[10px] font-mono text-black/35 dark:text-white/35">{item.dateText}</span>
						</div>
					</div>
				</li>
			))}
		</ul>
	</div>
)}
