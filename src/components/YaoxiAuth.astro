---
// YaoxiAuth.astro — 耀西统一身份认证 (accounts.yaoxi.cloud SSO) 客户端初始化与状态管理
import { siteConfig } from "@/config";

const ssoConfig = siteConfig.sso || {
	enable: true,
	authUrl: "https://accounts.yaoxi.cloud",
	clientId: "yaoxi-blog",
};
---

<script define:vars={{ ssoConfig }}>
(() => {
  if (!ssoConfig.enable) return;

  function initYaoxiSSO() {
    if (typeof window.YaoxiAuth === "undefined") {
      console.warn("[YaoxiAuth] SDK尚未就绪，将在延迟后重试...");
      setTimeout(initYaoxiSSO, 100);
      return;
    }

    if (!window.yaoxiAuth) {
      window.yaoxiAuth = new window.YaoxiAuth({
        clientId: ssoConfig.clientId || "yaoxi-blog",
        authUrl: ssoConfig.authUrl || "https://accounts.yaoxi.cloud",
        mode: "popup",
        targetDomain: window.location.hostname,
        scope: "openid profile email admin",
      });

      // 检查并处理重定向回调 (URL Hash 模式 #access_token=...)
      const callbackResult = window.yaoxiAuth.handleCallback();
      if (callbackResult) {
        console.log("[YaoxiAuth] 重定向回调已解析并存储用户凭证:", callbackResult.user);
      }
    }

    // 全局凭据下发同步方法
    window.yaoxiSyncCredentials = async function (apiBase) {
      if (window.yaoxiAuth && typeof window.yaoxiAuth.syncCredentials === "function") {
        return await window.yaoxiAuth.syncCredentials(apiBase);
      }
      return null;
    };

    // 全局快捷调起方法
    window.yaoxiLogin = async function (mode = "popup") {
      try {
        console.log(`[YaoxiAuth] 正在通过 ${mode} 模式调起认证中心...`);
        const result = await window.yaoxiAuth.login({ mode });
        console.log("[YaoxiAuth] 认证成功，用户信息:", result.user);
        syncAuthState();

        const rawRole = String(result.user?.role || "").toLowerCase();
        const roles = Array.isArray(result.user?.roles) ? result.user.roles.map((r) => String(r).toLowerCase()) : [];
        if (rawRole === "admin" || roles.includes("admin") || result.user?.is_admin === true) {
          window.yaoxiSyncCredentials().catch(() => {});
        }

        window.dispatchEvent(
          new CustomEvent("yaoxi:auth:change", {
            detail: { isAuthenticated: true, user: result.user, token: result.accessToken },
          })
        );
        return result;
      } catch (err) {
        console.warn("[YaoxiAuth] 登录失败或用户取消:", err.message);
        throw err;
      }
    };

    window.yaoxiLogout = function () {
      window.yaoxiAuth.logout();
      syncAuthState();
      window.dispatchEvent(
        new CustomEvent("yaoxi:auth:change", {
          detail: { isAuthenticated: false, user: null, token: null },
        })
      );
      console.log("[YaoxiAuth] 已退出登录并清除本地凭证");
    };

    window.getYaoxiUser = function () {
      return window.yaoxiAuth ? window.yaoxiAuth.getUser() : null;
    };

    // 同步 DOM 状态（Navbar 与用户控制面板）
    function syncAuthState() {
      const isAuthed = window.yaoxiAuth && window.yaoxiAuth.isAuthenticated();
      const user = isAuthed ? window.yaoxiAuth.getUser() : null;

      // 1. Navbar 头像 / 游客切换
      const guestNavEl = document.getElementById("auth-nav-guest");
      const userNavEl = document.getElementById("auth-nav-user");
      const avatarNavEl = document.getElementById("auth-nav-avatar");

      if (guestNavEl && userNavEl) {
        if (isAuthed && user) {
          guestNavEl.classList.add("hidden");
          userNavEl.classList.remove("hidden");
          userNavEl.classList.add("flex");
          if (avatarNavEl) {
            const initial = (user.name || user.sub || "Y").trim().charAt(0).toUpperCase();
            avatarNavEl.textContent = initial;
          }
        } else {
          userNavEl.classList.add("hidden");
          userNavEl.classList.remove("flex");
          guestNavEl.classList.remove("hidden");
        }
      }

      // 2. 悬浮面板内容切换
      const guestPanelEl = document.getElementById("auth-panel-guest");
      const userPanelEl = document.getElementById("auth-panel-user");
      const userNameEl = document.getElementById("auth-panel-username");
      const userEmailEl = document.getElementById("auth-panel-email");
      const userRoleBadgeEl = document.getElementById("auth-panel-role-badge");
      const userPanelAvatarEl = document.getElementById("auth-panel-avatar");

      if (guestPanelEl && userPanelEl) {
        if (isAuthed && user) {
          guestPanelEl.classList.add("hidden");
          userPanelEl.classList.remove("hidden");
          const rawRole = String(user.role || "").toLowerCase();
          const roles = Array.isArray(user.roles) ? user.roles.map((r) => String(r).toLowerCase()) : [];
          const isAdmin = rawRole === "admin" || roles.includes("admin") || user.is_admin === true;

          if (userNameEl) userNameEl.textContent = user.name || user.username || user.sub || "用户";
          if (userEmailEl) userEmailEl.textContent = user.email || user.sub || "accounts.yaoxi.cloud";
          if (userPanelAvatarEl) {
            const initial = (user.name || user.username || user.sub || "U").trim().charAt(0).toUpperCase();
            userPanelAvatarEl.textContent = initial;
          }
          if (userRoleBadgeEl) {
            userRoleBadgeEl.textContent = isAdmin ? "管理员" : "成员";
            userRoleBadgeEl.className = isAdmin
              ? "text-[10px] px-1.5 py-0.5 rounded bg-primary/10 text-primary font-medium"
              : "text-[10px] px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 font-medium";
          }
        } else {
          userPanelEl.classList.add("hidden");
          guestPanelEl.classList.remove("hidden");
        }
      }

      // 3. 通用 data-yaoxi-user 容器更新
      const currentRole = isAuthed && user ? (String(user.role || "").toLowerCase()) : "";
      const currentRoles = isAuthed && user && Array.isArray(user.roles) ? user.roles.map((r) => String(r).toLowerCase()) : [];
      const isCurrentAdmin = isAuthed && user && (currentRole === "admin" || currentRoles.includes("admin") || user.is_admin === true);

      document.querySelectorAll("[data-yaoxi-user-name]").forEach((el) => {
        el.textContent = isAuthed && user ? (user.name || user.username || user.sub || "") : "";
      });
      document.querySelectorAll("[data-yaoxi-authed-only]").forEach((el) => {
        if (isAuthed) {
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      });
      document.querySelectorAll("[data-yaoxi-admin-only]").forEach((el) => {
        if (isAuthed && isCurrentAdmin) {
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      });
      document.querySelectorAll("[data-yaoxi-member-only]").forEach((el) => {
        if (isAuthed && !isCurrentAdmin) {
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      });
      document.querySelectorAll("[data-yaoxi-guest-only]").forEach((el) => {
        if (isAuthed) {
          el.classList.add("hidden");
        } else {
          el.classList.remove("hidden");
        }
      });
    }

    // 绑定带 data-yaoxi-login / data-yaoxi-logout 的交互元素
    function bindAuthElements() {
      document.querySelectorAll("[data-yaoxi-login]").forEach((btn) => {
        if (btn.dataset.yaoxiBound) return;
        btn.dataset.yaoxiBound = "true";
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          const mode = btn.getAttribute("data-yaoxi-login") || "popup";
          window.yaoxiLogin(mode);
        });
      });

      document.querySelectorAll("[data-yaoxi-logout]").forEach((btn) => {
        if (btn.dataset.yaoxiBound) return;
        btn.dataset.yaoxiBound = "true";
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          window.yaoxiLogout();
        });
      });
    }

    syncAuthState();
    bindAuthElements();

    // 管理员登录态自动预取并下发运维凭据 (GitHub PAT / CF Token / Zone ID)
    if (window.yaoxiAuth && window.yaoxiAuth.isAuthenticated()) {
      const currentUser = window.yaoxiAuth.getUser();
      const currentRole = String(currentUser?.role || "").toLowerCase();
      const roles = Array.isArray(currentUser?.roles) ? currentUser.roles.map((r) => String(r).toLowerCase()) : [];
      const isAdmin = currentRole === "admin" || roles.includes("admin") || currentUser?.is_admin === true;
      if (isAdmin && (!localStorage.getItem("yaoxi_github_pat") || !localStorage.getItem("yaoxi_ddos_cf_token"))) {
        window.yaoxiSyncCredentials().catch(() => {});
      }
    }

    // 通知外部认证状态就绪
    window.dispatchEvent(
      new CustomEvent("yaoxi:auth:ready", {
        detail: {
          isAuthenticated: window.yaoxiAuth.isAuthenticated(),
          user: window.yaoxiAuth.getUser(),
        },
      })
    );
  }

  // 页面加载及 Swup 路由更新事件监听
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initYaoxiSSO);
  } else {
    initYaoxiSSO();
  }

  document.addEventListener("swup:page:view", () => {
    initYaoxiSSO();
  });
})();
</script>
