---
import { Icon } from "astro-icon/components";

interface Props {
	src: string;
	title: string;
	artist: string;
	cover?: string;
	lrc?: string;
}

const { src, title, artist, cover, lrc } = Astro.props;
---

<music-player class="music-player" data-lrc={lrc}>
	<div class="music-deck">
		<div class="music-art">
			{cover
				? <img src={cover} alt="" width="360" height="360" fetchpriority="high" />
				: <Icon name="material-symbols:music-note-rounded" />}
		</div>
		<div class="music-track-title">
			<h1>{title}</h1>
			<p>{artist}</p>
		</div>
		<audio src={src} preload="metadata"></audio>
		<div class="music-seek">
			<input data-seek type="range" min="0" max="1" value="0" step="0.1" aria-label="播放进度" disabled />
			<div><span data-current>00:00</span><span data-duration>00:00</span></div>
		</div>
		<div class="music-controls">
			<button type="button" data-skip="-5" aria-label="后退 5 秒" title="后退 5 秒">
				<Icon name="material-symbols:replay-5-rounded" />
			</button>
			<button type="button" class="music-play" data-play aria-label="播放" title="播放">
				<Icon name="material-symbols:play-arrow-rounded" />
				<Icon name="material-symbols:pause-rounded" />
			</button>
			<button type="button" data-skip="5" aria-label="快进 5 秒" title="快进 5 秒">
				<Icon name="material-symbols:forward-5-rounded" />
			</button>
		</div>
		<p class="music-status" data-status role="status" hidden></p>
	</div>
	<section class="music-lyrics" aria-labelledby="music-lyrics-heading">
		<div class="music-lyrics-head">
			<h2 id="music-lyrics-heading">同步歌词</h2>
			<Icon name="material-symbols:lyrics-rounded" />
		</div>
		<div class="music-lyrics-scroll" data-lyrics>
			<p class="music-lyric-message">{lrc ? "正在加载歌词…" : "暂无歌词"}</p>
		</div>
	</section>
</music-player>

<script>
	function parseLrc(raw: string) {
		const normalized = raw.replace(/\\n/g, "\n").replace(/&amp;/g, "&");
		const offset = Number(normalized.match(/\[offset:\s*([+-]?\d+)\]/i)?.[1] ?? 0) / 1000;
		const timestamp = /\[(\d+):(\d{2})(?:\.(\d{1,3}))?\]/g;
		return normalized.split(/\r?\n/).flatMap((line) => {
			const text = line.replace(timestamp, "").trim();
			return [...line.matchAll(timestamp)].map(([, minutes, seconds, fraction]) => ({
				time: Math.max(0, Number(minutes) * 60 + Number(seconds) + Number(`0.${fraction ?? 0}`) + offset),
				text: text || "♪",
			}));
		}).sort((a, b) => a.time - b.time);
	}

	function formatTime(seconds: number) {
		const whole = Number.isFinite(seconds) ? Math.floor(seconds) : 0;
		return [Math.floor(whole / 60), whole % 60].map((part) => String(part).padStart(2, "0")).join(":");
	}

	class MusicPlayer extends HTMLElement {
		private lifecycle: AbortController | undefined;

		connectedCallback() {
			if (this.lifecycle) return;
			const audio = this.querySelector("audio")!;
			const seek = this.querySelector<HTMLInputElement>("[data-seek]")!;
			const play = this.querySelector<HTMLButtonElement>("[data-play]")!;
			const current = this.querySelector<HTMLElement>("[data-current]")!;
			const duration = this.querySelector<HTMLElement>("[data-duration]")!;
			const lyrics = this.querySelector<HTMLElement>("[data-lyrics]")!;
			const status = this.querySelector<HTMLElement>("[data-status]")!;
			this.lifecycle = new AbortController();
			const { signal } = this.lifecycle;
			const options = { signal };
			let lines: HTMLButtonElement[] = [];
			let times: number[] = [];
			let active = -1;

			const showStatus = (message: string) => {
				status.textContent = message;
				status.hidden = !message;
			};
			const startPlayback = () => {
				showStatus("");
				void audio.play().catch((error: unknown) => {
					if (!signal.aborted && !(error instanceof DOMException && error.name === "AbortError")) {
						showStatus("音频暂时无法播放，请再试一次。");
					}
				});
			};
			const syncPlayback = () => {
				const playing = !audio.paused && !audio.ended;
				this.toggleAttribute("data-playing", playing);
				const label = playing ? "暂停" : "播放";
				play.setAttribute("aria-label", label);
				play.title = label;
			};
			const syncProgress = () => {
				seek.value = String(audio.currentTime);
				const progress = seek.disabled ? 0 : Math.min(audio.currentTime / audio.duration, 1);
				seek.style.setProperty("--music-progress", `${progress * 100}%`);
				current.textContent = formatTime(audio.currentTime);
				let index = times.length - 1;
				while (index >= 0 && times[index] > audio.currentTime) index--;
				if (index === active) return;
				lines[active]?.removeAttribute("aria-current");
				active = index;
				const line = lines[active];
				if (line) {
					line.setAttribute("aria-current", "true");
					lyrics.scrollTop = line.offsetTop - (lyrics.clientHeight - line.offsetHeight) / 2;
				} else {
					lyrics.scrollTop = 0;
				}
			};
			const syncDuration = () => {
				const ready = Number.isFinite(audio.duration) && audio.duration > 0;
				seek.disabled = !ready;
				seek.max = ready ? String(audio.duration) : "1";
				duration.textContent = formatTime(audio.duration);
				syncProgress();
			};

			play.addEventListener("click", () => {
				if (audio.paused) startPlayback();
				else audio.pause();
			}, options);
			seek.addEventListener("input", () => { audio.currentTime = seek.valueAsNumber; }, options);
			for (const button of this.querySelectorAll<HTMLButtonElement>("[data-skip]")) {
				button.addEventListener("click", () => {
					if (!seek.disabled) audio.currentTime = Math.max(0, Math.min(audio.duration, audio.currentTime + Number(button.dataset.skip)));
				}, options);
			}
			for (const event of ["play", "pause", "ended"]) audio.addEventListener(event, syncPlayback, options);
			audio.addEventListener("durationchange", syncDuration, options);
			audio.addEventListener("timeupdate", syncProgress, options);
			audio.addEventListener("error", () => showStatus("音频加载失败，请稍后重试。"), options);
			syncDuration();
			syncPlayback();

			const loadLyrics = async (source: string) => {
				try {
					let raw = source;
					if (/^(https?:\/\/|\/)/i.test(source) || /\.lrc(?:[?#]|$)/i.test(source)) {
						const response = await fetch(source, options);
						if (!response.ok) throw new Error("Lyrics unavailable");
						raw = await response.text();
					}
					if (signal.aborted) return;
					const entries = parseLrc(raw);
					times = entries.map(({ time }) => time);
					lines = entries.map(({ time, text }) => {
						const line = document.createElement("button");
						line.type = "button";
						line.className = "music-lyric-line";
						line.textContent = text;
						line.addEventListener("click", () => {
							audio.currentTime = time;
							if (audio.paused) startPlayback();
						}, options);
						return line;
					});
					lyrics.replaceChildren(...lines);
					if (!lines.length) lyrics.textContent = "暂无歌词";
					syncProgress();
				} catch {
					if (!signal.aborted) lyrics.textContent = "歌词加载失败";
				}
			};
			if (this.dataset.lrc) void loadLyrics(this.dataset.lrc);
		}

		disconnectedCallback() {
			this.lifecycle?.abort();
			this.lifecycle = undefined;
			this.querySelector("audio")?.pause();
		}
	}

	if (!customElements.get("music-player")) customElements.define("music-player", MusicPlayer);
</script>
