---
// StatusWidget.astro — 快猫星云状态页接入组件
// 客户端 fetch https://status.yaoxi.wiki/api/widget/v1/summary.json
// 展示整体状态 + 进行中的故障，并按 API 建议的 poll_after_seconds 轮询刷新
import { Icon } from "astro-icon/components";

const STATUS_API = "https://status.yaoxi.wiki/api/widget/v1/summary.json";
const STATUS_PAGE = "https://status.yaoxi.wiki";
---

<div id="status-widget" class="card-base p-5 relative w-full mt-6 mb-6">
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2 font-bold text-[var(--primary)]">
            <Icon name="material-symbols:monitor-heart-rounded" class="text-xl" />
            <span>站点状态</span>
        </div>
        <a
            href={STATUS_PAGE}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-[var(--text-color-light)] hover:text-[var(--primary)] transition"
        >
            查看状态页 →
        </a>
    </div>

    <div id="status-widget-body" class="text-sm">
        <div class="flex items-center gap-2 py-1">
            <span
                id="status-dot"
                class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--text-color-light)] animate-pulse"
            ></span>
            <span id="status-text" class="text-[var(--text-color-light)]">正在获取状态…</span>
        </div>
        <div id="status-incidents" class="mt-3 flex-col gap-2"></div>
    </div>
</div>

<script define:vars={{ STATUS_API, STATUS_PAGE }}>
(() => {
    'use strict';

    /** 全局轮询定时器：swup 导航替换 DOM 后由新实例接管，避免旧定时器泄漏 */
    let timer = null;

    /** 快猫星云 widget 规范的整体状态映射 */
    const STATUS_MAP = {
        operational: { label: "全部系统运行正常", color: "#22c55e", dot: "🟢" },
        degraded_performance: { label: "部分服务性能下降", color: "#eab308", dot: "🟡" },
        partial_outage: { label: "部分服务故障", color: "#f97316", dot: "🟠" },
        major_outage: { label: "重大故障", color: "#ef4444", dot: "🔴" },
        full_outage: { label: "服务完全故障", color: "#dc2626", dot: "🔴" },
    };

    const PHASE_MAP = {
        investigating: "调查中",
        identified: "已定位",
        monitoring: "监控中",
        resolved: "已恢复",
    };

    function esc(s) {
        return String(s ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function fmtTime(iso) {
        if (!iso) return "";
        try {
            const d = new Date(iso);
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(
                d.getDate()
            ).padStart(2, "0")} ${String(d.getHours()).padStart(2, "0")}:${String(
                d.getMinutes()
            ).padStart(2, "0")}`;
        } catch {
            return iso;
        }
    }

    function render(data) {
        const dot = document.getElementById("status-dot");
        const text = document.getElementById("status-text");
        const incidents = document.getElementById("status-incidents");
        if (!dot || !text || !incidents) return;

        const overall = data?.overall?.status || "unknown";
        const meta = STATUS_MAP[overall] || { label: "状态未知", color: "#6b7280", dot: "⚪" };

        dot.style.background = meta.color;
        dot.classList.remove("animate-pulse");
        text.textContent = `${meta.dot} ${meta.label}`;
        text.style.color = "var(--text-color)";

        const incidentsList = Array.isArray(data?.ongoing_incidents)
            ? data.ongoing_incidents
            : [];

        if (incidentsList.length === 0) {
            incidents.classList.add("hidden");
            incidents.innerHTML = "";
            return;
        }

        incidents.classList.remove("hidden");
        incidents.innerHTML = incidentsList
            .map((inc) => {
                const phase = PHASE_MAP[inc.phase] || inc.phase || "进行中";
                const last = inc.last_update?.message || "";
                const comps = (inc.affected_components || [])
                    .map((c) => c.name)
                    .filter(Boolean)
                    .join("、");
                return `
                <div class="rounded-lg border border-red-500/20 bg-red-500/5 px-3 py-2.5">
                    <div class="flex items-center gap-2 text-[13px] font-semibold text-red-600 dark:text-red-400">
                        <span>🔴</span>
                        <span>${esc(inc.title || "服务故障")}</span>
                        <span class="ml-auto text-[11px] font-normal text-[var(--text-color-light)]">${esc(
                            phase
                        )}</span>
                    </div>
                    ${comps ? `<div class="mt-1 text-xs text-[var(--text-color-light)]">影响：${esc(comps)} · ${esc(fmtTime(inc.started_at))}</div>` : ""}
                    ${last ? `<div class="mt-1 text-xs text-[var(--text-color-light)] line-clamp-2">${esc(last)}</div>` : ""}
                </div>`;
            })
            .join("");
    }

    function loadStatus() {
        fetch(STATUS_API, { signal: AbortSignal.timeout(10000) })
            .then((res) => {
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return res.json();
            })
            .then((data) => {
                render(data);
                // 按 API 建议的轮询间隔刷新（下限 30s，上限 5min）
                const poll =
                    Math.min(
                        Math.max(Number(data?.poll_after_seconds) || 60, 30),
                        300
                    ) * 1000;
                if (timer) clearInterval(timer);
                timer = setInterval(loadStatus, poll);
            })
            .catch((err) => {
                const text = document.getElementById("status-text");
                const dot = document.getElementById("status-dot");
                if (text && dot) {
                    dot.style.background = "#6b7280";
                    dot.classList.remove("animate-pulse");
                    text.textContent = "⚪ 状态服务暂时不可用";
                    text.style.color = "var(--text-color-light)";
                }
                console.error("[status-widget]", err);
            });
    }

    function initStatusWidget() {
        const body = document.getElementById("status-widget-body");
        if (!body || body.dataset.initialized) return;
        body.dataset.initialized = "true";
        loadStatus();
    }

    document.addEventListener("DOMContentLoaded", initStatusWidget);
    document.addEventListener("swup:contentReplaced", initStatusWidget);
})();
</script>
