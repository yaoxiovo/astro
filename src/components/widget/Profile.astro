---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { profileConfig, quotes, siteConfig, umamiConfig } from "../../config";

const config = profileConfig;
const allPosts = await getCollection("posts");
const postCount = allPosts.length;
---
<div class="card-base p-3 border border-black/10 dark:border-white/10">
    <div class="relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3 max-w-[12rem] lg:max-w-none rounded-xl overflow-hidden" style={`--theme-hue: ${siteConfig.themeColor.hue}`}>
        <div class="loading-bar absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-32 h-1 bg-gray-200 dark:bg-gray-700 z-10 rounded-full overflow-hidden">
            <div class="loading-progress h-full w-8 bg-[oklch(0.70_0.14_var(--theme-hue))] animate-loading-progress rounded-full"></div>
        </div>
        <img src={config.avatar} alt="Profile Image of the Author" class="w-full h-full object-cover opacity-0 transition-opacity duration-500" onload="this.style.opacity='1'; this.parentElement.querySelector('.loading-bar').style.opacity='0';"/>
    </div>
    <div class="px-2">
        <div class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{config.name}</div>
        <div class="h-1 w-5 bg-[var(--primary)] mx-auto rounded-full mb-2 transition"></div>
        <div id="profile-bio" class="text-center text-neutral-400 mb-2.5 transition" data-quotes={JSON.stringify(quotes)}>{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                <Icon name={config.links[0].icon} class="text-[1.5rem]"></Icon>
                {config.links[0].name}
            </a>}
        </div>
        
        <!-- 全站访问量统计 -->
        <div class="grid grid-cols-3 mt-3 pt-3 border-t border-neutral-300 dark:border-neutral-700">
            <div class="text-center">
                <div class="text-xs text-neutral-500 mb-1 flex items-center justify-center gap-1">
                    <Icon name="material-symbols:visibility-outline" class="text-base"></Icon>
                    <span class="text-xs">访问量</span>
                </div>
                <div id="site-views" class="font-bold text-lg text-neutral-700 dark:text-neutral-300">0</div>
            </div>
            <div class="text-center border-l border-neutral-300 dark:border-neutral-700">
                <div class="text-xs text-neutral-500 mb-1 flex items-center justify-center gap-1">
                    <Icon name="material-symbols:person" class="text-base"></Icon>
                    <span class="text-xs">访客数</span>
                </div>
                <div id="site-visitors" class="font-bold text-lg text-neutral-700 dark:text-neutral-300">0</div>
            </div>
            <div class="text-center border-l border-neutral-300 dark:border-neutral-700">
                <div class="text-xs text-neutral-500 mb-1 flex items-center justify-center gap-1">
                    <Icon name="material-symbols:article-outline" class="text-base"></Icon>
                    <span class="text-xs">文章数</span>
                </div>
                <div class="font-bold text-lg text-neutral-700 dark:text-neutral-300">{postCount}</div>
            </div>
        </div>
        
        <!-- 早午晚问候与专属音乐播放器 -->
        <div class="mt-3 pt-3 border-t border-neutral-300 dark:border-neutral-700 flex flex-col gap-3">
            <div id="dynamic-greeting" class="text-center text-sm font-medium text-black/70 dark:text-white/70">
                🌞 正在载入时间...
            </div>
            <!-- 本地自托管迷你播放器（无外部 CDN / 无第三方音乐接口） -->
            <div
                class="sidebar-player w-full rounded-xl overflow-hidden shadow-sm border border-black/5 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.03] p-2.5"
                data-src="/music/mp3/literature.mp3"
                data-title="リテラチュア"
                data-artist="上田麗奈 · 魔女之旅 OP"
                data-href="/music/literature/"
            >
                <audio class="sidebar-audio" src="/music/mp3/literature.mp3" preload="metadata"></audio>
                <div class="flex items-center gap-2.5">
                    <button
                        class="sidebar-cover-btn relative w-10 h-10 flex-shrink-0 rounded-full overflow-hidden ring-1 ring-black/10 dark:ring-white/15 active:scale-95 transition"
                        title="播放/暂停"
                        aria-label="播放或暂停"
                    >
                        <img
                            src="/music/literature_cover.jpg"
                            alt="专辑封面"
                            class="sidebar-cover w-full h-full object-cover"
                            loading="lazy"
                        />
                    </button>
                    <div class="flex-1 min-w-0">
                        <div class="sidebar-title text-xs font-semibold text-black/80 dark:text-white/85 truncate">リテラチュア</div>
                        <div class="sidebar-artist text-[10px] text-neutral-500 dark:text-neutral-400 truncate">上田麗奈 · 魔女之旅 OP</div>
                    </div>
                    <button
                        class="sidebar-play-btn w-8 h-8 flex-shrink-0 rounded-full flex items-center justify-center bg-[var(--primary)] text-white hover:scale-105 active:scale-95 transition"
                        title="播放/暂停"
                        aria-label="播放或暂停"
                    >
                        <Icon name="material-symbols:play-arrow-rounded" class="sidebar-play-icon text-[1.15rem]"></Icon>
                        <Icon name="material-symbols:pause-rounded" class="sidebar-pause-icon text-[1.15rem] hidden"></Icon>
                    </button>
                </div>
                <div class="flex items-center gap-2 mt-2">
                    <span class="sidebar-time-current text-[9px] font-mono text-neutral-500 dark:text-neutral-400 w-7 text-right">00:00</span>
                    <div class="sidebar-progress h-1 flex-1 rounded-full bg-black/10 dark:bg-white/15 overflow-hidden cursor-pointer">
                        <div class="sidebar-progress-bar h-full w-0 rounded-full bg-[var(--primary)] transition-[width] duration-100"></div>
                    </div>
                    <span class="sidebar-time-total text-[9px] font-mono text-neutral-500 dark:text-neutral-400 w-7">00:00</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .loading-bar {
        transition: opacity 0.5s ease-out;
    }

    @keyframes loading-progress {
        0% {
            transform: translateX(-100%);
        }
        100% {
            transform: translateX(400%);
        }
    }

    .animate-loading-progress {
        animation: loading-progress 1.5s ease-in-out infinite;
    }
</style>

<script define:vars={{ umamiConfig}}>
    // 数字动画函数
    function animateValue(obj, start, end, duration) {
        let startTimestamp = null;
        const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            obj.innerHTML = Math.floor(progress * (end - start) + start);
            if (progress < 1) {
                window.requestAnimationFrame(step);
            } else {
                obj.innerHTML = end;
            }
        };
        window.requestAnimationFrame(step);
    }

    // 获取全站访问量统计
    async function loadSiteStats() {
        if (!umamiConfig.enable) return;
        try {
            const statsData = await fetchUmamiStats(umamiConfig.baseUrl, umamiConfig.shareId, {
                timezone: umamiConfig.timezone
            });
            
            const pageviews = statsData.pageviews || 0;
            const visitors = statsData.visitors || 0;
            
            const viewsElement = document.getElementById('site-views');
            const visitorsElement = document.getElementById('site-visitors');
            
            if (viewsElement) {
                const startVal = parseInt(viewsElement.textContent) || 0;
                // 如果当前值已经是目标值，就不执行动画
                if (startVal !== pageviews) {
                    animateValue(viewsElement, startVal, pageviews, 1000);
                }
            }
            
            if (visitorsElement) {
                const startVal = parseInt(visitorsElement.textContent) || 0;
                // 如果当前值已经是目标值，就不执行动画
                if (startVal !== visitors) {
                    animateValue(visitorsElement, startVal, visitors, 1000);
                }
            }
        } catch (error) {
            console.error('获取全站统计失败:', error);
        }
    }

    // 随机更新人物金句
    function updateRandomQuote() {
        const bioEl = document.getElementById('profile-bio');
        if (!bioEl) return;
        try {
            const quotes = JSON.parse(bioEl.getAttribute('data-quotes') || '[]');
            if (quotes && quotes.length > 0) {
                const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
                // 为了有动效，先淡出再淡入
                bioEl.style.opacity = '0';
                setTimeout(() => {
                    bioEl.textContent = randomQuote;
                    bioEl.style.opacity = '1';
                }, 200);
            }
        } catch (e) {
            console.error('Failed to parse quotes', e);
        }
    }

    // 根据时间更新问候语
    function updateGreeting() {
        const greetingEl = document.getElementById('dynamic-greeting');
        if (!greetingEl) return;
        const hour = new Date().getHours();
        let text = '';
        if (hour < 5) text = '🌃 夜深了，注意休息喵~';
        else if (hour < 9) text = '🌅 早上好！开启新的一天喵~';
        else if (hour < 12) text = '🌞 上午好！要保持好心情喵~';
        else if (hour < 14) text = '🍜 中午好！记得按时干饭喵~';
        else if (hour < 18) text = '☕ 下午好！喝杯咖啡提提神喵~';
        else text = '🌙 晚上好！今天辛苦了喵~';
        
        greetingEl.textContent = text;
    }

    // 侧边栏本地迷你播放器（Swup 友好，可重复初始化）
    function formatClock(seconds) {
        if (!Number.isFinite(seconds) || seconds < 0) return '00:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function initSidebarPlayer() {
        const player = document.querySelector('.sidebar-player');
        if (!player || player.dataset.initialized === 'true') return;
        player.dataset.initialized = 'true';

        const audio = player.querySelector('.sidebar-audio');
        const playBtn = player.querySelector('.sidebar-play-btn');
        const coverBtn = player.querySelector('.sidebar-cover-btn');
        const playIcon = player.querySelector('.sidebar-play-icon');
        const pauseIcon = player.querySelector('.sidebar-pause-icon');
        const cover = player.querySelector('.sidebar-cover');
        const bar = player.querySelector('.sidebar-progress-bar');
        const track = player.querySelector('.sidebar-progress');
        const cur = player.querySelector('.sidebar-time-current');
        const total = player.querySelector('.sidebar-time-total');

        if (!audio || !playBtn) return;

        const toggle = () => {
            if (audio.paused) {
                // 暂停页面上其它音频，避免叠播
                document.querySelectorAll('audio').forEach((other) => {
                    if (other !== audio && !other.paused) other.pause();
                });
                audio.play().catch((err) => console.error('Sidebar audio play failed:', err));
            } else {
                audio.pause();
            }
        };

        playBtn.addEventListener('click', toggle);
        coverBtn?.addEventListener('click', toggle);

        audio.addEventListener('play', () => {
            playIcon?.classList.add('hidden');
            pauseIcon?.classList.remove('hidden');
            cover?.classList.add('animate-[spin_12s_linear_infinite]');
        });

        audio.addEventListener('pause', () => {
            playIcon?.classList.remove('hidden');
            pauseIcon?.classList.add('hidden');
            cover?.classList.remove('animate-[spin_12s_linear_infinite]');
        });

        audio.addEventListener('loadedmetadata', () => {
            if (total) total.textContent = formatClock(audio.duration);
        });

        audio.addEventListener('timeupdate', () => {
            const duration = audio.duration || 0;
            if (bar && duration > 0) bar.style.width = `${(audio.currentTime / duration) * 100}%`;
            if (cur) cur.textContent = formatClock(audio.currentTime);
        });

        track?.addEventListener('click', (event) => {
            const rect = track.getBoundingClientRect();
            const duration = audio.duration || 0;
            if (duration > 0 && rect.width > 0) {
                audio.currentTime = ((event.clientX - rect.left) / rect.width) * duration;
            }
        });
    }

    // 页面加载完成后获取统计数据并更新组件
    document.addEventListener('DOMContentLoaded', () => {
        loadSiteStats();
        updateRandomQuote();
        updateGreeting();
        initSidebarPlayer();
    });
    // 监听 Swup 内容替换事件，确保页面切换后重新获取数据
    document.addEventListener('swup:contentReplaced', () => {
        loadSiteStats();
        updateRandomQuote();
        updateGreeting();
        initSidebarPlayer();
    });
</script>