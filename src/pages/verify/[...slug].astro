---
import crypto from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { buildPayloadFromRaw } from "@utils/seal-core.mjs";
import { getSealManifest } from "@utils/seal-loader";

export async function getStaticPaths() {
	const manifest = getSealManifest();
	return manifest.seals.map((seal) => ({
		params: { slug: seal.slug },
		props: { seal },
	}));
}

const { seal } = Astro.props;
const manifest = getSealManifest();

let canonical = "";
let buildVerifyOk = false;
let buildVerifyError = "";
try {
	const raw = fs.readFileSync(
		path.join(process.cwd(), "src/content/posts", `${seal.slug}.md`),
		"utf-8",
	);
	canonical = buildPayloadFromRaw(seal.slug, raw).canonical;
	if (manifest.publicKeyPem) {
		const publicKey = crypto.createPublicKey(manifest.publicKeyPem);
		buildVerifyOk = crypto.verify(
			null,
			Buffer.from(canonical, "utf-8"),
			publicKey,
			Buffer.from(seal.signature, "base64"),
		);
	} else {
		buildVerifyError = "公钥缺失，无法校验";
	}
} catch (e: any) {
	buildVerifyError = e?.message || String(e);
}

const payloadJson = JSON.stringify({
	canonical,
	signature: seal.signature,
	publicKeyJwk: manifest.publicKeyJwk,
	hash: seal.hash,
}).replace(/</g, "\\u003c");
---

<MainGridLayout title={`官印验证 · ${seal.title}`} noindex>
    <div class="card-base p-6 md:p-8">
        <div class="flex items-center gap-2 mb-2">
            <div class="h-8 w-8 rounded-lg bg-[#c0392b] flex items-center justify-center text-white">
                <Icon name="material-symbols:verified-outline" class="text-[1.35rem]" />
            </div>
            <h1 class="text-2xl font-bold text-black dark:text-white">官印验证</h1>
        </div>
        <p class="text-black/60 dark:text-white/60 text-sm mb-6">
            本页对文章《<a href={`/posts/${seal.slug}/`} class="text-[var(--primary)] hover:underline">{seal.title}</a>》的
            Ed25519 官印进行公开验证。校验在您的浏览器本地完成，不依赖本站服务器。
        </p>

        <!-- 双通道验证状态 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="p-4 rounded-xl border border-[var(--line-divider)] bg-black/[0.02] dark:bg-white/[0.02]">
                <div class="text-xs text-black/40 dark:text-white/40 mb-1">构建时校验（签发方）</div>
                {buildVerifyError ? (
                    <div class="flex items-center gap-2 text-amber-500 font-bold text-sm">
                        <Icon name="material-symbols:warning-outline" /> {buildVerifyError}
                    </div>
                ) : buildVerifyOk ? (
                    <div class="flex items-center gap-2 text-emerald-500 font-bold text-sm">
                        <Icon name="material-symbols:check-circle-outline" /> 签名有效
                    </div>
                ) : (
                    <div class="flex items-center gap-2 text-red-500 font-bold text-sm">
                        <Icon name="material-symbols:cancel-outline" /> 签名不匹配！
                    </div>
                )}
            </div>
            <div class="p-4 rounded-xl border border-[var(--line-divider)] bg-black/[0.02] dark:bg-white/[0.02]">
                <div class="text-xs text-black/40 dark:text-white/40 mb-1">浏览器实时校验（您的设备）</div>
                <div id="seal-live-status" class="flex items-center gap-2 text-black/50 dark:text-white/50 font-bold text-sm">
                    <span class="animate-pulse">校验中…</span>
                </div>
            </div>
        </div>

        <!-- 指纹与签名详情 -->
        <div class="space-y-3 text-sm mb-6">
            <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-3">
                <span class="text-black/50 dark:text-white/50 shrink-0 md:w-28">内容指纹 (SHA-256)</span>
                <code class="px-2 py-1 rounded bg-black/5 dark:bg-white/10 font-mono text-xs break-all select-all">{seal.hash}</code>
            </div>
            <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-3">
                <span class="text-black/50 dark:text-white/50 shrink-0 md:w-28">数字签名 (Ed25519)</span>
                <code class="px-2 py-1 rounded bg-black/5 dark:bg-white/10 font-mono text-xs break-all select-all">{seal.signature}</code>
            </div>
            <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-3">
                <span class="text-black/50 dark:text-white/50 shrink-0 md:w-28">公钥指纹</span>
                <code class="px-2 py-1 rounded bg-black/5 dark:bg-white/10 font-mono text-xs break-all select-all">{manifest.keyFingerprint}</code>
            </div>
            <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-3">
                <span class="text-black/50 dark:text-white/50 shrink-0 md:w-28">签发时间</span>
                <span class="font-mono text-xs">{seal.published}</span>
                <span class="text-black/40 dark:text-white/40 text-xs">（内容发布日期）</span>
            </div>
        </div>

        <!-- 离线复核指引 -->
        <details class="p-4 rounded-xl border border-[var(--line-divider)] bg-black/[0.02] dark:bg-white/[0.02] mb-4">
            <summary class="cursor-pointer text-sm font-bold text-black/80 dark:text-white/80 select-none">
                🔍 如何离线独立复核该签名？
            </summary>
            <div class="mt-3 text-xs text-black/60 dark:text-white/60 space-y-2">
                <p>本页已把 canonical 载荷（签名原文）与签名内嵌在页面源码中，校验你的浏览器本地完成、不经过服务器。完整离线复核脚本见
                    <a href="/verify/" class="text-[var(--primary)] hover:underline">验证中心首页</a>；公钥可从
                    <a href="/api/seal/pubkey.pem" class="text-[var(--primary)] hover:underline">/api/seal/pubkey.pem</a> 下载，
                    签名总清单见
                    <a href="/api/seal/manifest.json" class="text-[var(--primary)] hover:underline">/api/seal/manifest.json</a>。</p>
            </div>
        </details>
    </div>

    <script type="application/json" id="seal-payload" set:html={payloadJson}></script>
    <script>
        function b64ToBytes(b64: string): Uint8Array {
            const bin = atob(b64);
            const bytes = new Uint8Array(bin.length);
            for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
            return bytes;
        }

        async function runSealVerify() {
            const statusEl = document.getElementById("seal-live-status");
            const payloadEl = document.getElementById("seal-payload");
            if (!statusEl || !payloadEl) return;

            statusEl.innerHTML = '<span class="animate-pulse">校验中…</span>';

            try {
                const data = JSON.parse(payloadEl.textContent || "{}");
                if (!data.publicKeyJwk) throw new Error("no-key");
                const subtle = window.crypto?.subtle;
                if (!subtle) throw new Error("no-subtle");

                const key = await subtle.importKey(
                    "jwk",
                    data.publicKeyJwk,
                    { name: "Ed25519" },
                    false,
                    ["verify"],
                );
                const dataBytes = new TextEncoder().encode(data.canonical);
                const sigOk = await subtle.verify("Ed25519", key, b64ToBytes(data.signature), dataBytes);

                const digest = await subtle.digest("SHA-256", dataBytes);
                const hex = Array.from(new Uint8Array(digest))
                    .map((b) => b.toString(16).padStart(2, "0"))
                    .join("");
                const hashOk = hex === data.hash;

                if (sigOk && hashOk) {
                    statusEl.innerHTML =
                        '<span class="flex items-center gap-2 text-emerald-500"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>签名有效 · 内容未被篡改</span>';
                } else if (!sigOk) {
                    statusEl.innerHTML =
                        '<span class="flex items-center gap-2 text-red-500"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>签名不匹配，内容可能被篡改！</span>';
                } else {
                    statusEl.innerHTML =
                        '<span class="flex items-center gap-2 text-amber-500"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>签名有效但指纹不一致，请警惕</span>';
                }
            } catch (e) {
                statusEl.innerHTML =
                    '<span class="text-black/40 dark:text-white/40">当前浏览器不支持 Ed25519 在线验签，请参考下方离线复核方法</span>';
            }
        }

        document.addEventListener("DOMContentLoaded", runSealVerify);
        document.addEventListener("swup:page:view", runSealVerify);
    </script>
</MainGridLayout>
