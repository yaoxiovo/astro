---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@components/misc/Markdown.astro";
import { formatDateToYYYYMMDD } from "@utils/date-utils";

export async function getStaticPaths() {
	const novels = await getCollection("novels", ({ data }) => !data.draft);
	return novels.map((novel) => ({
		params: { slug: novel.slug },
		props: { novel },
	}));
}

const { novel } = Astro.props;
const { Content } = await novel.render();
---

<MainGridLayout
  title={`${novel.data.title} - 小说专栏`}
  description={novel.data.description || novel.data.title}
>
  <div class="space-y-6">
    <!-- 顶部导航与元信息 -->
    <div class="card-base px-6 md:px-8 py-6 bg-[var(--card-bg)] border border-black/5 dark:border-white/10 rounded-2xl shadow-sm">
      <div class="flex items-center justify-between pb-4 border-b border-[var(--line-divider)] mb-4">
        <a
          href="/novels/"
          class="inline-flex items-center gap-1.5 text-xs md:text-sm font-semibold text-black/60 dark:text-white/60 hover:text-[var(--primary)] transition-colors"
        >
          <Icon name="material-symbols:arrow-back-rounded" class="text-base" />
          返回小说书架
        </a>
        <div class="flex items-center gap-2">
          <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${
            novel.data.status === 'completed'
              ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20'
              : 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20'
          }`}>
            {novel.data.status === 'completed' ? '已完结' : '连载中'}
          </span>
          {novel.data.category && (
            <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/60">
              {novel.data.category}
            </span>
          )}
        </div>
      </div>

      <h1 class="text-2xl md:text-3xl font-black text-black/90 dark:text-white/90 tracking-tight mb-3">
        {novel.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs text-black/50 dark:text-white/50 mb-3">
        <div class="flex items-center gap-1">
          <Icon name="material-symbols:person-rounded" class="text-sm" />
          <span>作者：{novel.data.author || "瑶曦"}</span>
        </div>
        <div class="flex items-center gap-1">
          <Icon name="material-symbols:calendar-today-rounded" class="text-sm" />
          <span>更新于：{formatDateToYYYYMMDD(novel.data.updated || novel.data.published)}</span>
        </div>
        {novel.data.wordsCount ? (
          <div class="flex items-center gap-1">
            <Icon name="material-symbols:format-size-rounded" class="text-sm" />
            <span>约 {novel.data.wordsCount} 字</span>
          </div>
        ) : null}
      </div>

      {novel.data.description && (
        <p class="text-xs md:text-sm text-black/70 dark:text-white/70 bg-black/5 dark:bg-white/5 p-3.5 rounded-xl border border-black/5 dark:border-white/5 leading-relaxed">
          {novel.data.description}
        </p>
      )}

      {novel.data.tags && novel.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {novel.data.tags.map((tag: string) => (
            <span class="text-[10px] px-2 py-0.5 rounded-md bg-[var(--primary)]/10 text-[var(--primary)]">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- 正文阅读容器 -->
    <article class="card-base px-6 md:px-10 py-8 bg-[var(--card-bg)] border border-black/5 dark:border-white/10 rounded-2xl shadow-sm leading-loose">
      <Markdown class="novel-content text-[15px] md:text-base selection:bg-[var(--primary)]/20">
        <Content />
      </Markdown>
    </article>
  </div>
</MainGridLayout>
