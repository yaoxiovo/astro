<script define:vars={{ rawPostMarkdown, articleTitle, postId }}>
    function initArticleTools() {
        const progressBar = document.getElementById('reading-progress-bar');
        const backToTopBtn = document.getElementById('btn-back-to-top');
        const percentageEl = document.getElementById('scroll-percentage');

        function updateProgress() {
            const docEl = document.documentElement;
            const scrollTop = window.scrollY || docEl.scrollTop;
            const scrollHeight = docEl.scrollHeight - docEl.clientHeight;

            if (scrollHeight <= 0) return;

            const progress = Math.min(100, Math.max(0, Math.round((scrollTop / scrollHeight) * 100)));

            if (progressBar) {
                progressBar.style.width = `${progress}%`;
                progressBar.style.opacity = scrollTop > 20 ? '1' : '0';
            }

            if (backToTopBtn) {
                if (scrollTop > 280) {
                    backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
                } else {
                    backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
                }
            }

            if (percentageEl) {
                percentageEl.textContent = `${progress}%`;
            }
        }

        window.removeEventListener('scroll', updateProgress);
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();

        backToTopBtn?.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        let toastTimer = null;
        function showToast(msg) {
            const toast = document.getElementById('copy-toast');
            const text = document.getElementById('copy-toast-text');
            if (!toast || !text) return;
            text.textContent = msg;
            toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
            }, 2000);
        }

        const btnCopyMd = document.getElementById('btn-copy-md');
        btnCopyMd?.addEventListener('click', async () => {
            try {
                if (!rawPostMarkdown) {
                    showToast('该文章不支持复制源码 喵！');
                    return;
                }
                await navigator.clipboard.writeText(rawPostMarkdown);
                showToast('已复制文章 Markdown 源码 喵！');
            } catch (e) {
                showToast('复制失败，请手动选取 喵！');
            }
        });

        const btnCopyLink = document.getElementById('btn-copy-link');
        btnCopyLink?.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(window.location.href);
                showToast('已复制文章分享链接 喵！');
            } catch (e) {
                showToast('复制链接失败 喵！');
            }
        });

        // ============================================================
        // 1. 原生 Web Speech API 文章智能语音朗读器 (TTS)
        // ============================================================
        let ttsParagraphs = [];
        let ttsIndex = 0;
        let isTTSPlaying = false;
        const ttsRates = [1.0, 1.25, 1.5, 0.8];
        let currentRateIndex = 0;

        const btnTtsListen = document.getElementById('btn-tts-listen');
        const ttsPlayerBar = document.getElementById('tts-player-bar');
        const ttsProgressInfo = document.getElementById('tts-progress-info');
        const ttsBtnToggle = document.getElementById('tts-btn-toggle');
        const ttsBtnStop = document.getElementById('tts-btn-stop');
        const ttsBtnRate = document.getElementById('tts-btn-rate');
        const ttsBtnClose = document.getElementById('tts-btn-close');
        const ttsIconPause = document.getElementById('tts-icon-pause');
        const ttsIconPlay = document.getElementById('tts-icon-play');
        const ttsPulseDot = document.getElementById('tts-pulse-dot');

        function collectTTSParagraphs() {
            const rawNodes = Array.from(document.querySelectorAll('#post-container .markdown-content > p, #post-container .markdown-content > h2, #post-container .markdown-content > h3, #post-container .markdown-content > blockquote, #post-container .markdown-content > ul > li, #post-container .markdown-content > ol > li'));
            return rawNodes.filter(el => {
                if (el.closest('pre') || el.closest('code') || el.closest('.katex') || el.closest('#mindmap-container')) return false;
                const txt = el.textContent ? el.textContent.trim() : '';
                return txt.length > 1;
            });
        }

        function highlightTTSParagraph(idx) {
            ttsParagraphs.forEach((p, i) => {
                if (i === idx) {
                    p.style.transition = 'all 0.3s ease';
                    p.style.backgroundColor = 'rgba(var(--primary-rgb, 59, 130, 246), 0.12)';
                    p.style.borderLeft = '3px solid var(--primary)';
                    p.style.paddingLeft = '10px';
                    p.style.borderRadius = '4px';
                    p.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } else {
                    p.style.backgroundColor = '';
                    p.style.borderLeft = '';
                    p.style.paddingLeft = '';
                }
            });
        }

        function clearTTSHighlight() {
            ttsParagraphs.forEach(p => {
                p.style.backgroundColor = '';
                p.style.borderLeft = '';
                p.style.paddingLeft = '';
            });
        }

        function speakTTSParagraph(index) {
            if (!('speechSynthesis' in window)) return;
            if (index < 0 || index >= ttsParagraphs.length) {
                stopTTS();
                showToast('文章朗读已完毕 喵！');
                return;
            }

            ttsIndex = index;
            highlightTTSParagraph(ttsIndex);

            if (ttsProgressInfo) {
                ttsProgressInfo.textContent = `第 ${ttsIndex + 1} / ${ttsParagraphs.length} 段`;
            }

            window.speechSynthesis.cancel();
            const textToSpeak = ttsParagraphs[ttsIndex].textContent.trim();
            const utterance = new SpeechSynthesisUtterance(textToSpeak);
            utterance.rate = ttsRates[currentRateIndex];
            utterance.lang = 'zh-CN';

            utterance.onend = () => {
                if (isTTSPlaying) {
                    if (ttsIndex + 1 < ttsParagraphs.length) {
                        speakTTSParagraph(ttsIndex + 1);
                    } else {
                        stopTTS();
                        showToast('文章朗读完毕 喵！');
                    }
                }
            };

            utterance.onerror = (e) => {
                if (e.error !== 'canceled' && e.error !== 'interrupted') {
                    console.error('[TTS Error]', e);
                    stopTTS();
                }
            };

            window.speechSynthesis.speak(utterance);
            isTTSPlaying = true;
            ttsIconPause?.classList.remove('hidden');
            ttsIconPlay?.classList.add('hidden');
            ttsPulseDot?.classList.remove('hidden');
        }

        function startTTS() {
            if (!('speechSynthesis' in window)) {
                showToast('当前浏览器不支持 Web Speech 语音朗读 喵！');
                return;
            }
            ttsParagraphs = collectTTSParagraphs();
            if (ttsParagraphs.length === 0) {
                showToast('未找到可朗读的正文段落 喵！');
                return;
            }
            ttsPlayerBar?.classList.remove('hidden');
            speakTTSParagraph(0);
        }

        function pauseTTS() {
            if (window.speechSynthesis.speaking && !window.speechSynthesis.paused) {
                window.speechSynthesis.pause();
                isTTSPlaying = false;
                ttsIconPause?.classList.add('hidden');
                ttsIconPlay?.classList.remove('hidden');
                ttsPulseDot?.classList.add('hidden');
            }
        }

        function resumeTTS() {
            if (window.speechSynthesis.paused) {
                window.speechSynthesis.resume();
                isTTSPlaying = true;
                ttsIconPause?.classList.remove('hidden');
                ttsIconPlay?.classList.add('hidden');
                ttsPulseDot?.classList.remove('hidden');
            } else {
                speakTTSParagraph(ttsIndex);
            }
        }

        function stopTTS() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
            }
            isTTSPlaying = false;
            clearTTSHighlight();
            ttsIconPause?.classList.add('hidden');
            ttsIconPlay?.classList.remove('hidden');
            ttsPulseDot?.classList.add('hidden');
            if (ttsProgressInfo) ttsProgressInfo.textContent = '已暂停';
        }

        btnTtsListen?.addEventListener('click', () => {
            if (ttsPlayerBar && !ttsPlayerBar.classList.contains('hidden') && isTTSPlaying) {
                pauseTTS();
            } else {
                startTTS();
            }
        });

        ttsBtnToggle?.addEventListener('click', () => {
            if (isTTSPlaying) {
                pauseTTS();
            } else {
                resumeTTS();
            }
        });

        ttsBtnStop?.addEventListener('click', stopTTS);

        ttsBtnRate?.addEventListener('click', () => {
            currentRateIndex = (currentRateIndex + 1) % ttsRates.length;
            const newRate = ttsRates[currentRateIndex];
            if (ttsBtnRate) ttsBtnRate.textContent = `${newRate}x`;
            if (isTTSPlaying) {
                speakTTSParagraph(ttsIndex);
            }
        });

        ttsBtnClose?.addEventListener('click', () => {
            stopTTS();
            ttsPlayerBar?.classList.add('hidden');
        });

        window.addEventListener('beforeunload', stopTTS);

        // ============================================================
        // 2. 划词智能操作胶囊工具条 (Selection Floating Toolbar)
        // ============================================================
        const selectionToolbar = document.getElementById('selection-action-toolbar');
        const selBtnQuote = document.getElementById('sel-btn-quote');
        const selBtnSearch = document.getElementById('sel-btn-search');
        const selBtnComment = document.getElementById('sel-btn-comment');

        let activeSelectedText = '';

        function handleTextSelection() {
            const sel = window.getSelection();
            const text = sel ? sel.toString().trim() : '';
            const postContainer = document.getElementById('post-container');

            if (!selectionToolbar) return;

            if (text.length >= 2 && postContainer && sel.rangeCount > 0) {
                const range = sel.getRangeAt(0);
                if (postContainer.contains(range.commonAncestorContainer)) {
                    activeSelectedText = text;
                    const rect = range.getBoundingClientRect();
                    selectionToolbar.classList.remove('hidden');
                    const top = Math.max(12, rect.top - 46);
                    const left = Math.min(window.innerWidth - 190, Math.max(10, rect.left + rect.width / 2 - 85));
                    selectionToolbar.style.top = `${top}px`;
                    selectionToolbar.style.left = `${left}px`;
                    return;
                }
            }
            selectionToolbar.classList.add('hidden');
        }

        document.addEventListener('selectionchange', handleTextSelection);

        selBtnQuote?.addEventListener('click', async (e) => {
            e.stopPropagation();
            if (!activeSelectedText) return;
            const quoteContent = `> ${activeSelectedText}\n>\n> —— 摘自瑶曦《${articleTitle}》\n> 原文直达: ${window.location.href}`;
            try {
                await navigator.clipboard.writeText(quoteContent);
                showToast('已复制金句引用与出处 喵！');
            } catch {
                showToast('复制失败，请手动选取 喵！');
            }
            selectionToolbar?.classList.add('hidden');
            window.getSelection()?.removeAllRanges();
        });

        selBtnSearch?.addEventListener('click', (e) => {
            e.stopPropagation();
            if (!activeSelectedText) return;
            const query = activeSelectedText;
            selectionToolbar?.classList.add('hidden');
            window.dispatchEvent(new CustomEvent('yaoxi:search', { detail: { query } }));
        });

        selBtnComment?.addEventListener('click', (e) => {
            e.stopPropagation();
            selectionToolbar?.classList.add('hidden');
            const giscus = document.getElementById('giscus-container');
            giscus?.scrollIntoView({ behavior: 'smooth' });
            showToast('已跳转至评论探讨区 喵！');
        });

    }

    document.addEventListener('DOMContentLoaded', initArticleTools);
    document.addEventListener('swup:page:view', initArticleTools);
</script>
</MainGridLayout>
)}