---
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import SeriesNav from "@components/SeriesNav.astro";
import CyberSummary from "@components/CyberSummary.astro";
import PosterGenerator from "@components/PosterGenerator.astro";
import EncryptedReader from "@components/EncryptedReader.svelte";
import DanmakuLayer from "@components/DanmakuLayer.astro";
import PresenceWidget from "@components/PresenceWidget.astro";
import WikiHistoryPage from "@components/wiki/WikiHistoryPage.astro";
import WikiRevisionPage from "@components/wiki/WikiRevisionPage.astro";
import WikiHistoryTable from "@components/wiki/WikiHistoryTable.svelte";
import BacklinksPanel from "@components/wiki/BacklinksPanel.astro";
import RelatedArticles from "@components/wiki/RelatedArticles.astro";
import RelatedReading from "@components/wiki/RelatedReading.astro";
import LinkSuggestionsPanel from "@components/wiki/LinkSuggestionsPanel.astro";
import CiteThisArticle from "@components/wiki/CiteThisArticle.svelte";
import LongPressTextMenu from "@components/widget/LongPressTextMenu.astro";
import OfficialSealBadge from "@components/misc/OfficialSealBadge.astro";
import { getPostWikiHistorySync } from "@utils/wiki-history-loader";
// KaTeX 样式仅在文章页加载（避免全站阻塞渲染）
import "katex/dist/katex.css";

import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { gitHubEditConfig, licenseConfig } from "src/config";
import PostMetadata from "../../components/PostMeta.astro";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import { profileConfig, siteConfig, umamiConfig, authorRoles } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	const paths = [];

	for (const entry of blogEntries) {
		const slug = entry.id.replace(/\.[^/.]+$/, "");
		const history = getPostWikiHistorySync(slug);

		// 1. 常规文章页面
		paths.push({
			params: { slug },
			props: { entry, mode: "article", historyData: history },
		});

		// 2. 独立维基百科历史版本页面 (/posts/[slug]/history/)
		paths.push({
			params: { slug: `${slug}/history` },
			props: { entry, mode: "history", historyData: history },
		});

		// 3. 历史快照永久链接页面 (/posts/[slug]/revision/[sha]/)
		if (history?.revisions) {
			for (const rev of history.revisions) {
				paths.push({
					params: { slug: `${slug}/revision/${rev.shortSha}` },
					props: { entry, mode: "revision", revision: rev, historyData: history },
				});
			}
		}
	}

	return paths;
}

const { entry, mode = "article", revision, historyData } = Astro.props;
const slug = entry.id.replace(/\.[^/.]+$/, "");
const siteUrlBase = (Astro.site ?? new URL("https://blog.yaoxi.wiki")).href.replace(/\/$/, "");
const latestRevisionShortSha = historyData?.revisions?.[0]?.shortSha || "";
const latestRevisionDateISO = historyData?.revisions?.[0]?.date || "";

let Content: any = null;
let headings: any[] = [];
let remarkPluginFrontmatter: any = { words: 0, minutes: 0 };
let mindmapData = "{}";
let rawPostMarkdown = "";
let articleTitle = entry.data.title;
let postId = entry.id;
let seriesPosts: any[] = [];
let seriesName: any = undefined;
let articlePosts: any[] = [];
let articleImageUrl = "";
let datePublishedISO = "";
let dateModifiedISO = "";
let authorName = "";
let authorRole: any = null;
let isOrg = false;
let jsonLd: any = {};
let encryptedPayloadJson = "";

if (mode === "article") {
	const renderResult = await entry.render();
	Content = renderResult.Content;
	headings = renderResult.headings;
	remarkPluginFrontmatter = renderResult.remarkPluginFrontmatter;

	// 组装思维导图数据
	let mindmapMd = `# ${entry.data.title.replace(/"/g, '')}\n`;
	headings.forEach((h: any) => {
		// 过滤太深的层级，保持脑图清爽
		if (h.depth <= 4) {
			mindmapMd += `${'#'.repeat(h.depth + 1)} ${h.text.replace(/"/g, '')}\n`;
		}
	});
	mindmapData = JSON.stringify(mindmapMd);
	rawPostMarkdown = entry.data.encrypted ? "" : (entry.body || "");

	// 获取同系列文章
	const allPosts = await getSortedPosts();
	articlePosts = allPosts;
	seriesName = entry.data.series;
	seriesPosts = seriesName
		? allPosts
			.filter(p => p.data.series === seriesName)
			.map(p => ({ title: p.data.title, slug: p.id, published: p.data.published }))
		: [];

	articleImageUrl = entry.data.image
		? (entry.data.image.startsWith("http") ? entry.data.image : new URL(entry.data.image, Astro.site).href)
		: new URL(profileConfig.avatar, Astro.site).href;

	datePublishedISO = entry.data.published.toISOString();
	dateModifiedISO = entry.data.updated
		? entry.data.updated.toISOString()
		: datePublishedISO;

	authorName = profileConfig.name;
	authorRole = authorRoles[authorName];
	isOrg = authorRole?.verifyType === "blue";

	jsonLd = {
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		headline: entry.data.title,
		description: entry.data.description || entry.data.title,
		image: articleImageUrl,
		author: {
			"@type": isOrg ? "Organization" : "Person",
			name: authorName,
			url: Astro.site,
			...(isOrg ? { logo: profileConfig.avatar } : { image: profileConfig.avatar })
		},
		publisher: {
			"@type": "Organization",
			name: siteConfig.title,
			logo: {
				"@type": "ImageObject",
				url: new URL(profileConfig.avatar, Astro.site).href
			}
		},
		datePublished: datePublishedISO,
		dateModified: dateModifiedISO,
		inLanguage: entry.data.lang
			? entry.data.lang.replace("_", "-")
			: siteConfig.lang.replace("_", "-"),
		mainEntityOfPage: {
			"@type": "WebPage",
			"@id": new URL(Astro.url.pathname, Astro.site).href,
		},
		...(entry.data.tags?.length
			? { keywords: entry.data.tags.join(", ") }
			: {}),
		...(entry.data.category ? { articleSection: entry.data.category } : {}),
	};

	if (entry.data.encrypted && (entry as any).body) {
		const match = ((entry as any).body as string).match(/```encrypted-payload\s*\n([\s\S]*?)\n```/);
		encryptedPayloadJson = match ? match[1].trim() : "";
	}
}
---
{mode === "history" && (
    <WikiHistoryPage entry={entry} history={historyData} />
)}
{mode === "revision" && (
    <WikiRevisionPage entry={entry} revision={revision} history={historyData} />
)}
{mode === "article" && (
<MainGridLayout banner={entry.data.image} image={articleImageUrl} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings} keywords={entry.data.tags} publishedTime={datePublishedISO} modifiedTime={dateModifiedISO} author={authorName}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <!-- 顶部极细平滑渐变阅读进度指示条 -->
    <div id="reading-progress-bar" class="fixed top-0 left-0 h-[3px] z-[100] bg-gradient-to-r from-[var(--primary)] via-emerald-400 to-[var(--primary)] transition-all duration-75 ease-out pointer-events-none opacity-0" style="width: 0%;"></div>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.words} 字</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">{remarkPluginFrontmatter.minutes} 分钟</div>
                </div>
                <a
                    href={`/posts/${slug}/history/`}
                    class="flex flex-row items-center hover:text-[var(--primary)] text-black/40 dark:text-white/40 transition-colors group cursor-pointer"
                    title="查看此文章的完整维基百科修订历史与版本比对"
                >
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 group-hover:bg-[var(--primary)]/10 text-black/50 dark:text-white/50 group-hover:text-[var(--primary)] flex items-center justify-center mr-2">
                        <Icon name="material-symbols:history"></Icon>
                    </div>
                    <div class="text-sm font-medium">{historyData?.totalRevisions || 1} 次修订</div>
                </a>
                <OfficialSealBadge slug={slug} />
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <h1
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full flex items-center font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    <span>{entry.data.title}</span>
                </h1>
            </div>

            <!-- description/excerpt -->
            {(entry.data.description || remarkPluginFrontmatter.excerpt) && (
                <div class="onload-animation mb-4">
                    <CyberSummary summary={entry.data.description || remarkPluginFrontmatter.excerpt} />
                </div>
            )}

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        slug={entry.id}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} class="mb-8 rounded-xl banner-container onload-animation"/>
            }

            {/* 系列导航 */}
            {seriesName && seriesPosts.length > 1 && (
                <SeriesNav series={seriesName} posts={seriesPosts} currentSlug={entry.id} />
            )}

            {entry.data.encrypted ? (
                <EncryptedReader client:only="svelte" rawPayloadJson={encryptedPayloadJson} />
            ) : (
                <>
                    <Markdown class="mb-6 markdown-content onload-animation">
                        <Content />
                    </Markdown>
                    <DanmakuLayer slug={slug} />
                    <PresenceWidget slug={slug} />
                </>
            )}

            <!-- 文章反馈与编辑区域 -->
            <div class="mb-4 p-4 rounded-lg bg-[var(--license-block-bg)] border border-[var(--line-divider)] onload-animation">
                <!-- 反馈区域 -->
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-3">
                        <div class="h-5 w-5 rounded bg-[var(--primary)] flex items-center justify-center">
                            <Icon name="material-symbols:help-outline" class="text-[0.75rem] text-white dark:text-black/70"></Icon>
                        </div>
                        <p class="text-black/80 dark:text-white/80 text-sm">这篇文章是否对你有帮助？</p>
                    </div>
                    <div class="flex gap-2 flex-wrap items-center">
                        <button id="btn-tts-listen" class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] text-[var(--btn-content)] text-xs font-medium transition-all active:scale-95 cursor-pointer" title="智能语音朗读全文">
                            <Icon name="material-symbols:headphones-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform"></Icon>
                            <span id="tts-btn-text">朗读</span>
                        </button>
                        <button id="btn-copy-md" class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] text-[var(--btn-content)] text-xs font-medium transition-all active:scale-95 cursor-pointer" title="复制文章 Markdown 源码">
                            <Icon name="material-symbols:content-copy-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform"></Icon>
                            <span>复制 MD</span>
                        </button>
                        <button id="btn-copy-link" class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] text-[var(--btn-content)] text-xs font-medium transition-all active:scale-95 cursor-pointer" title="复制文章直达链接">
                            <Icon name="material-symbols:share-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform"></Icon>
                            <span>分享</span>
                        </button>
                        <a href="/posts/pin/" class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] text-[var(--btn-content)] text-xs font-medium transition-all active:scale-95">
                            <Icon name="material-symbols:contact-mail-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform"></Icon>
                            联系
                        </a>
                        <a href="/donate/" class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--primary)] hover:bg-[oklch(0.65_0.16_var(--hue))] active:bg-[oklch(0.60_0.18_var(--hue))] text-white dark:text-black/80 text-xs font-medium transition-all active:scale-95">
                            <Icon name="material-symbols:favorite-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform"></Icon>
                            赞助
                        </a>
                        <!-- 脑图切换按钮 -->
                        <button id="toggle-mindmap-btn" class="group flex items-center gap-1 px-3 py-1.5 rounded bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] text-[var(--btn-content)] text-xs font-medium transition-all active:scale-95">
                            <Icon name="material-symbols:account-tree-outline" class="text-[0.875rem] group-hover:scale-110 transition-transform"></Icon>
                            脑图
                        </button>
                        <!-- 海报生成器 -->
                        <PosterGenerator 
                          title={entry.data.title} 
                          excerpt={entry.data.description || remarkPluginFrontmatter.excerpt} 
                          coverImage={entry.data.image && path.join("/content/posts/", getDir(entry.id), entry.data.image)} 
                          author={profileConfig.name} 
                        />
                    </div>
                </div>

                <!-- 思维导图容器 (默认隐藏) -->
                <div id="mindmap-container" class="hidden w-full h-[500px] border border-[var(--primary)]/20 rounded-xl bg-black/5 dark:bg-white/5 overflow-hidden relative mb-4 transition-all duration-300">
                    <svg id="markmap-svg" class="w-full h-full"></svg>
                    <div class="absolute bottom-2 right-2 flex gap-2">
                        <button id="mindmap-zoom-in" class="p-1.5 bg-white/80 dark:bg-black/80 rounded border border-black/10 dark:border-white/10 hover:text-[var(--primary)]"><Icon name="material-symbols:zoom-in" /></button>
                        <button id="mindmap-zoom-out" class="p-1.5 bg-white/80 dark:bg-black/80 rounded border border-black/10 dark:border-white/10 hover:text-[var(--primary)]"><Icon name="material-symbols:zoom-out" /></button>
                        <button id="mindmap-fit" class="p-1.5 bg-white/80 dark:bg-black/80 rounded border border-black/10 dark:border-white/10 hover:text-[var(--primary)]"><Icon name="material-symbols:center-focus-strong-outline" /></button>
                    </div>
                </div>
                
                <script id="mindmap-data" type="application/json" set:html={mindmapData}></script>
                <script>
                    function loadExternalScript(src: string): Promise<void> {
                        return new Promise((resolve, reject) => {
                            const existing = document.querySelector(`script[src="${src}"]`) as HTMLScriptElement;
                            if (existing) {
                                if (existing.dataset.loaded === 'true') {
                                    resolve();
                                    return;
                                }
                                existing.addEventListener('load', () => resolve(), { once: true });
                                existing.addEventListener('error', (e) => reject(e), { once: true });
                                return;
                            }
                            const s = document.createElement('script');
                            s.src = src;
                            s.onload = () => {
                                s.dataset.loaded = 'true';
                                resolve();
                            };
                            s.onerror = (err) => reject(err);
                            document.head.appendChild(s);
                        });
                    }

                    function initMindmap() {
                        const btn = document.getElementById('toggle-mindmap-btn');
                        const container = document.getElementById('mindmap-container');
                        const dataEl = document.getElementById('mindmap-data');
                        
                        if (!btn || !container || !dataEl) return;
                        
                        let markmapInstance: any = null;
                        
                        btn.addEventListener('click', async () => {
                            const isHidden = container.classList.contains('hidden');
                            if (isHidden) {
                                container.classList.remove('hidden');
                                // 初次渲染按需加载依赖
                                if (!markmapInstance) {
                                    if (!(window as any).markmap) {
                                        const originalText = btn.innerHTML;
                                        btn.innerHTML = '<span class="animate-spin inline-block w-3 h-3 border-2 border-current border-t-transparent rounded-full mr-1"></span> 脑图载入中...';
                                        btn.style.pointerEvents = 'none';

                                        try {
                                            await loadExternalScript('https://cdn.jsdelivr.net/npm/d3@7');
                                            await loadExternalScript('https://cdn.jsdelivr.net/npm/markmap-view');
                                            await loadExternalScript('https://cdn.jsdelivr.net/npm/markmap-lib');
                                        } catch (err) {
                                            console.error('Failed to load markmap scripts', err);
                                            alert('思维导图组件加载失败，请检查网络后重试');
                                            container.classList.add('hidden');
                                            btn.innerHTML = originalText;
                                            btn.style.pointerEvents = 'auto';
                                            return;
                                        } finally {
                                            btn.innerHTML = originalText;
                                            btn.style.pointerEvents = 'auto';
                                        }
                                    }

                                    const windowAny = window as any;
                                    if (windowAny.markmap) {
                                        const { Transformer, Markmap, loadCSS, loadJS } = windowAny.markmap;
                                        const transformer = new Transformer();
                                        const { root, features } = transformer.transform(JSON.parse(dataEl.textContent || '""'));
                                        const { styles, scripts } = transformer.getUsedAssets(features);
                                        if (styles) loadCSS(styles);
                                        if (scripts) loadJS(scripts, { getMarkmap: () => windowAny.markmap });
                                        
                                        markmapInstance = Markmap.create('#markmap-svg', {
                                            color: () => 'var(--primary)',
                                            autoFit: true
                                        }, root);
                                        
                                        // 绑定控件
                                        document.getElementById('mindmap-zoom-in')?.addEventListener('click', () => {
                                            markmapInstance.transition(markmapInstance.svg.transition().duration(500)).scaleBy(markmapInstance.zoom, 1.2);
                                        });
                                        document.getElementById('mindmap-zoom-out')?.addEventListener('click', () => {
                                            markmapInstance.transition(markmapInstance.svg.transition().duration(500)).scaleBy(markmapInstance.zoom, 0.8);
                                        });
                                        document.getElementById('mindmap-fit')?.addEventListener('click', () => {
                                            markmapInstance.fit();
                                        });
                                    }
                                }
                            } else {
                                container.classList.add('hidden');
                            }
                        });
                    }
                    
                    document.addEventListener('DOMContentLoaded', initMindmap);
                    document.addEventListener('swup:page:view', initMindmap);
                </script>
                
                {gitHubEditConfig.enable && (
                    <>
                        <!-- 分隔线 -->
                        <div class="border-t border-[var(--line-divider)] my-3"></div>
                        
                        <!-- GitHub编辑区域 -->
                        <div class="flex items-start gap-3">
                            <div class="h-5 w-5 rounded bg-[var(--primary)] flex items-center justify-center">
                                <Icon name="material-symbols:edit-outline" class="text-[0.875rem] text-white dark:text-black/70"></Icon>
                            </div>
                            <div class="flex-1">
                                <p class="text-black/80 dark:text-white/80 text-sm mb-1">发现错误或想要改进这篇文章？</p>
                                <a 
                                    href={`${gitHubEditConfig.baseUrl}/${entry.id}.md`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1 text-[var(--primary)] hover:text-[oklch(0.65_0.16_var(--hue))] text-sm font-medium transition-colors"
                                >
                                    <Icon name="fa6-brands:github" class="text-[0.875rem]"></Icon>
                                    在 GitHub 上编辑此页
                                    <Icon name="material-symbols:open-in-new" class="text-[0.75rem]"></Icon>
                                </a>
                            </div>
                        </div>
                    </>
                )}
            </div>

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.id} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

            <!-- 引用此文 (Cite this article) -->
            <CiteThisArticle
                title={entry.data.title}
                author={profileConfig.name}
                siteTitle={siteConfig.title}
                siteUrl={siteUrlBase}
                slug={slug}
                publishedISO={datePublishedISO}
                updatedISO={dateModifiedISO}
                revisionShortSha={latestRevisionShortSha}
                revisionDateISO={latestRevisionDateISO}
                client:visible
            />

            <!-- 维基百科风格修订历史折叠组件 -->
            <div class="mb-6 p-5 rounded-2xl border border-[var(--line-divider)] bg-black/[0.02] dark:bg-white/[0.02] shadow-sm onload-animation">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-[var(--line-divider)]">
                    <div class="flex items-center gap-2">
                        <Icon name="material-symbols:history" class="text-lg text-[var(--primary)]" />
                        <h3 class="text-sm font-bold text-black/90 dark:text-white/90">文章修订历史版本 (Git Revision History)</h3>
                        <span class="px-2 py-0.5 rounded-full text-[10px] bg-black/5 dark:bg-white/10 font-mono text-black/50 dark:text-white/50">
                            {historyData?.totalRevisions || 1} 次版本
                        </span>
                    </div>
                    <a href={`/posts/${slug}/history/`} class="text-xs text-[var(--primary)] hover:underline flex items-center gap-1 font-medium">
                        <span>打开独立全屏页面</span>
                        <Icon name="material-symbols:open-in-new" class="text-xs" />
                    </a>
                </div>
                <WikiHistoryTable history={historyData} slug={slug} standalone={false} client:idle />
            </div>

            <!-- 链入页面 (What links here) -->
            <BacklinksPanel slug={slug} />

            <!-- 编辑编排的延伸阅读指引（互链 / 单向） -->
            <RelatedReading slug={slug} related={entry.data.related} allPosts={articlePosts} />

            <!-- 相关文章推荐 (Related pages) -->
            <RelatedArticles slug={slug} exclude={entry.data.related} />

            <!-- 编辑工具：可补链接雷达（无建议时自动隐藏） -->
            <LinkSuggestionsPanel slug={slug} />

