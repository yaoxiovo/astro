---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import RecentChangesFeed from "@components/wiki/RecentChangesFeed.svelte";
import { getRecentChangesSync } from "@utils/wiki-special-loader";

const data = getRecentChangesSync();
const totalEntries = data?.totalEntries || 0;
const totalArticles = data ? Object.keys(data.articles).length : 0;
const generatedAt = data?.generatedAt
	? new Date(data.generatedAt).toLocaleString("zh-CN")
	: "—";

const pageTitle = "全站最近更改 - Special:RecentChanges";
const pageDescription =
	"维基百科式全站修订流：集中查看所有条目的最新 Git 修订、贡献者、编辑摘要与行内差异比对";
---

<MainGridLayout title={pageTitle} description={pageDescription} noindex>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 pt-6 pb-6 relative w-full">
            <!-- 顶部标题与快捷导航 -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-[var(--line-divider)]">
                <div>
                    <a href="/" class="text-xs text-[var(--primary)] hover:underline inline-flex items-center gap-1 font-medium mb-1.5">
                        <Icon name="material-symbols:arrow-back" class="text-sm" />
                        <span>返回首页</span>
                    </a>
                    <h1 class="text-2xl md:text-3xl font-bold text-black/90 dark:text-white/90 flex items-center gap-2">
                        <span>全站最近更改</span>
                        <span class="text-xs font-mono font-normal text-black/40 dark:text-white/40 mt-1.5">Special:RecentChanges</span>
                    </h1>
                </div>

                <div class="flex items-center gap-2.5">
                    <a
                        href="/wiki/maintenance/"
                        class="px-3 py-1.5 rounded-lg text-xs font-medium border border-[var(--line-divider)] hover:bg-black/5 dark:hover:bg-white/10 transition-colors inline-flex items-center gap-1.5 text-black/70 dark:text-white/70"
                    >
                        <Icon name="material-symbols:handyman-outline" class="text-sm" />
                        <span>维护仪表盘</span>
                    </a>
                    <a
                        href="/wiki/recent-changes.xml"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-3 py-1.5 rounded-lg text-xs font-medium border border-[var(--line-divider)] hover:bg-black/5 dark:hover:bg-white/10 transition-colors inline-flex items-center gap-1.5 text-black/70 dark:text-white/70"
                    >
                        <Icon name="material-symbols:rss-feed" class="text-sm" />
                        <span>RSS 订阅</span>
                    </a>
                </div>
            </div>

            <!-- 统计条与说明引言 -->
            <div class="mb-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-black/60 dark:text-white/60">
                <span>共收录 <strong class="text-[var(--primary)] font-mono">{totalEntries}</strong> 条修订</span>
                <span>覆盖 <strong class="text-[var(--primary)] font-mono">{totalArticles}</strong> 篇条目</span>
                <span class="text-black/40 dark:text-white/40 font-mono">索引生成于 {generatedAt}</span>
            </div>
            <div class="mb-5 p-3.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.02] border border-[var(--line-divider)] text-xs text-black/60 dark:text-white/60 leading-relaxed">
                <p>
                    本页汇总全站所有条目的 Git 修订记录，按时间倒序排列，可通过时间范围、贡献者、条目与关键词自由过滤。
                    点击<strong>「差异」</strong>可直接展开与上一版本的行内字符级比对（相邻版本自动命中 RFC 6902 增量热补丁，仅需数百字节流量）；
                    点击<strong>「快照」</strong>可进入该修订的永久链接。数据来自构建期生成的静态索引，完全无后端依赖 喵~
                </p>
            </div>

            <!-- 最近更改流核心组件 -->
            <RecentChangesFeed client:load />
        </div>
    </div>
</MainGridLayout>
