<script is:inline>
  (function initAdminStudio() {
    const STORAGE_KEY = 'yaoxi_admin_post_draft';
    const API_ENDPOINT_KEY = 'yaoxi_worker_api_base';
    const TOKEN_CANDIDATE_KEYS = [
      'yaoxi_auth_token',     // yaoxi-auth.js SSO 核心 Token
      'yaoxi_client_token',    // yaoxi-auth.js 客户端备用 Token
      'yaoxi_access_token',    // admin 历史保存 Token
      'access_token',          // 标准 OAuth 2.0 Token
      'token',
    ];

    // DOM 元素获取
    const titleEl = document.getElementById('post-title');
    const slugEl = document.getElementById('post-slug');
    const tagsEl = document.getElementById('post-tags');
    const categoryEl = document.getElementById('post-category');
    const descEl = document.getElementById('post-desc');
    const contentEl = document.getElementById('post-content');

    const draftStatusEl = document.getElementById('draft-status');
    const draftTimeTextEl = document.getElementById('draft-time-text');
    const btnClearDraft = document.getElementById('btn-clear-draft');
    const btnToggleAutoSlug = document.getElementById('btn-toggle-auto-slug');

    const statWords = document.getElementById('stat-words');
    const statMinutes = document.getElementById('stat-minutes');
    const statLines = document.getElementById('stat-lines');

    const btnPublish = document.getElementById('btn-publish');
    const btnPublishText = document.getElementById('btn-publish-text');
    const publishSpinner = document.getElementById('publish-spinner');
    const publishIcon = document.getElementById('publish-icon');

    // 部署看板元素
    const deployPanel = document.getElementById('deploy-panel');
    const deployTitle = document.getElementById('deploy-title');
    const deploySubtitle = document.getElementById('deploy-subtitle');
    const deployBadge = document.getElementById('deploy-badge');
    const deployProgressBar = document.getElementById('deploy-progress-bar');
    const deployStageInfo = document.getElementById('deploy-stage-info');
    const deployTimer = document.getElementById('deploy-timer');
    const deploySuccessLinks = document.getElementById('deploy-success-links');
    const linkLivePost = document.getElementById('link-live-post');
    const linkPreviewUrl = document.getElementById('link-preview-url');
    const btnContinueWriting = document.getElementById('btn-continue-writing');

    // Modal 元素
    const btnAuthConfig = document.getElementById('btn-auth-config');
    const authStatusText = document.getElementById('auth-status-text');
    const modalAuth = document.getElementById('modal-auth');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnSaveAuth = document.getElementById('btn-save-auth');
    const inputApiEndpoint = document.getElementById('input-api-endpoint');
    const inputAccessToken = document.getElementById('input-access-token');
    const inputGithubToken = document.getElementById('input-github-token');
    const badgeGithubPatAuto = document.getElementById('badge-github-pat-auto');
    const btnSyncCredsSso = document.getElementById('btn-sync-creds-sso');
    const GITHUB_PAT_KEY = 'yaoxi_github_pat';

    // 智能解析 GitHub PAT：优先读取统一认证中心官方下发的 platform_tokens.github
    function resolveGithubPat() {
      if (typeof window !== 'undefined' && window.yaoxiAuth && typeof window.yaoxiAuth.getPlatformToken === 'function') {
        const pt = window.yaoxiAuth.getPlatformToken('github');
        if (pt) return pt;
      }
      return localStorage.getItem(GITHUB_PAT_KEY) || localStorage.getItem('yaoxi_admin_github_pat') || (inputGithubToken ? inputGithubToken.value.trim() : '');
    }

    // SSO 身份联动元素
    const modalSsoIndicator = document.getElementById('modal-sso-indicator');
    const modalSsoName = document.getElementById('modal-sso-name');
    const modalSsoSub = document.getElementById('modal-sso-sub');
    const btnModalSsoLogin = document.getElementById('btn-modal-sso-login');
    const btnModalSsoLogout = document.getElementById('btn-modal-sso-logout');

    // 工作台模式切换与文章管理状态
    let currentEditorMode = 'post'; // 'post' | 'manage' | 'moment' | 'analytics'
    let isEditingMode = false;
    let editingSlug = '';
    let editingOriginalTitle = '';
    let postsData = [];

    try {
      const initialDataEl = document.getElementById('initial-posts-data');
      if (initialDataEl && initialDataEl.textContent) {
        postsData = JSON.parse(initialDataEl.textContent);
      }
    } catch (e) {
      console.warn('[Admin] Failed to parse initial posts data:', e);
    }

    const tabModePost = document.getElementById('tab-mode-post');
    const tabModeManage = document.getElementById('tab-mode-manage');
    const tabModeMoment = document.getElementById('tab-mode-moment');
    const tabModeAnalytics = document.getElementById('tab-mode-analytics');
    const panelPostEditor = document.getElementById('panel-post-editor');
    const panelPostManage = document.getElementById('panel-post-manage');
    const panelMomentEditor = document.getElementById('panel-moment-editor');
    const panelAnalytics = document.getElementById('panel-analytics');

    // 编辑模式指示横幅 DOM 元素
    const editingModeBanner = document.getElementById('editing-mode-banner');
    const editingBannerTitle = document.getElementById('editing-banner-title');
    const editingBannerSlug = document.getElementById('editing-banner-slug');
    const btnCancelEditing = document.getElementById('btn-cancel-editing');

    // 文章管理面板 DOM 元素
    const managePostsList = document.getElementById('manage-posts-list');
    const managePostsCount = document.getElementById('manage-posts-count');
    const manageSearchInput = document.getElementById('manage-search-input');
    const manageFilterCategory = document.getElementById('manage-filter-category');
    const manageEmptyState = document.getElementById('manage-empty-state');
    const btnSyncGithubPosts = document.getElementById('btn-sync-github-posts');
    const syncSpinner = document.getElementById('sync-spinner');
    const syncIcon = document.getElementById('sync-icon');
    const syncText = document.getElementById('sync-text');
    const btnManageNewPost = document.getElementById('btn-manage-new-post');

    // 朋友圈动态 DOM 元素
    const momentSlugEl = document.getElementById('moment-slug');
    const momentAuthorEl = document.getElementById('moment-author');
    const momentSourceEl = document.getElementById('moment-source');
    const momentIsCapsuleEl = document.getElementById('moment-is-capsule');
    const momentCapsuleDateContainer = document.getElementById('moment-capsule-date-container');
    const momentCapsuleDateEl = document.getElementById('moment-capsule-date');
    const momentPinnedEl = document.getElementById('moment-pinned');
    const momentReplyToEl = document.getElementById('moment-reply-to');
    const momentImagesEl = document.getElementById('moment-images');
    const momentVideosEl = document.getElementById('moment-videos');
    const momentContentEl = document.getElementById('moment-content');
    const btnClearMoment = document.getElementById('btn-clear-moment');
    const previewMomentAuthor = document.getElementById('preview-moment-author');
    const previewMomentText = document.getElementById('preview-moment-text');
    const previewCapsuleBadge = document.getElementById('preview-capsule-badge');

    let isAutoSlug = true;
    let saveTimeout = null;
    let deployPollTimer = null;
    let deploySeconds = 0;
    let timerInterval = null;

    // 0. JWT 解析与 URL 回调提取引擎
    function parseJwtPayload(jwtToken) {
      if (!jwtToken || typeof jwtToken !== 'string') return null;
      try {
        const parts = jwtToken.split('.');
        if (parts.length >= 2) {
          const base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
          const jsonStr = decodeURIComponent(escape(atob(base64)));
          return JSON.parse(jsonStr);
        }
      } catch (e) {
        try {
          const base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
          return JSON.parse(atob(base64));
        } catch (err) {}
      }
      return null;
    }

    function saveCallbackToken(token, expiresInSec) {
      if (!token) return;
      const exp = parseInt(expiresInSec, 10) || 7200;
      const expTime = Date.now() + exp * 1000;
      localStorage.setItem('yaoxi_auth_token', token);
      localStorage.setItem('yaoxi_access_token', token);
      localStorage.setItem('access_token', token);
      localStorage.setItem('yaoxi_auth_exp', expTime.toString());

      const user = parseJwtPayload(token);
      if (user) {
        localStorage.setItem('yaoxi_auth_user', JSON.stringify(user));
        localStorage.setItem('user_profile', JSON.stringify(user));
      }
    }

    function handleUrlCallback() {
      // 1. 优先捕获 hash 模式回调 (#access_token=...)
      if (window.location.hash && window.location.hash.includes('access_token')) {
        const hash = window.location.hash.substring(1);
        const params = new URLSearchParams(hash);
        const accessToken = params.get('access_token');
        if (accessToken) {
          saveCallbackToken(accessToken, params.get('expires_in'));
          if (window.history && window.history.replaceState) {
            window.history.replaceState(null, document.title, window.location.pathname + window.location.search);
          }
          return true;
        }
      }
      // 2. 检查 query 模式回调 (?access_token=... 或 ?token=...)
      if (window.location.search && (window.location.search.includes('access_token') || window.location.search.includes('token'))) {
        const params = new URLSearchParams(window.location.search);
        const accessToken = params.get('access_token') || params.get('token');
        if (accessToken) {
          saveCallbackToken(accessToken, params.get('expires_in'));
          if (window.history && window.history.replaceState) {
            params.delete('access_token');
            params.delete('token');
            params.delete('expires_in');
            const newSearch = params.toString() ? '?' + params.toString() : '';
            window.history.replaceState(null, document.title, window.location.pathname + newSearch + window.location.hash);
          }
          return true;
        }
      }
      return false;
    }

    // 1. 统一 Token 与鉴权状态感知（自动打通主站 SSO 与本地 Storage）
    function getAdminToken() {
      if (window.yaoxiAuth && typeof window.yaoxiAuth.getToken === 'function') {
        const sdkToken = window.yaoxiAuth.getToken();
        if (sdkToken) return sdkToken;
      }
      const expStr = localStorage.getItem('yaoxi_auth_exp');
      if (expStr && Date.now() >= parseInt(expStr, 10)) {
        return null;
      }
      for (const k of TOKEN_CANDIDATE_KEYS) {
        const val = localStorage.getItem(k) || sessionStorage.getItem(k);
        if (val && typeof val === 'string' && val.trim().length > 10) {
          return val.trim();
        }
      }
      return null;
    }

    function getAdminUser() {
      if (window.yaoxiAuth && typeof window.yaoxiAuth.getUser === 'function') {
        const u = window.yaoxiAuth.getUser();
        if (u) return u;
      }
      const userKeys = ['yaoxi_auth_user', 'yaoxi_client_user', 'user_profile'];
      for (const k of userKeys) {
        const raw = localStorage.getItem(k) || sessionStorage.getItem(k);
        if (raw) {
          try {
            return JSON.parse(raw);
          } catch (e) {}
        }
      }
      const token = getAdminToken();
      if (token) {
        return parseJwtPayload(token);
      }
      return null;
    }

    /**
     * 校验当前用户是否具备系统管理员 (admin) 权限
     * 权限严格由认证中心 (accounts.yaoxi.cloud) 下发，绝不自行越权！
     */
    function checkUserIsAdmin(user) {
      if (!user || typeof user !== 'object') return false;
      const rawRole = String(user.role || '').toLowerCase().trim();
      let roles = [];
      if (Array.isArray(user.roles)) {
        roles = user.roles.map((r) => String(r).toLowerCase().trim());
      } else if (typeof user.roles === 'string') {
        roles = user.roles.toLowerCase().split(',').map((r) => r.trim());
      }
      return (
        rawRole === 'admin' ||
        rawRole === 'administrator' ||
        roles.includes('admin') ||
        roles.includes('administrator') ||
        user.is_admin === true ||
        user.isAdmin === true
      );
    }

    const SSO_HANDSHAKE_SECRET = 'yaoxi_sso_handshake_secret_key_v1_auth_guard_2026';

    async function createSignedHandshakeToken(targetDomain) {
      const timestamp = Date.now().toString();
      const nonce = Math.random().toString(36).substring(2, 10);
      const domain = targetDomain || window.location.hostname;
      const payload = `v1.${timestamp}.${nonce}.${domain}`;

      if (window.crypto && window.crypto.subtle) {
        try {
          const enc = new TextEncoder();
          const key = await crypto.subtle.importKey(
            'raw',
            enc.encode(SSO_HANDSHAKE_SECRET),
            { name: 'HMAC', hash: 'SHA-256' },
            false,
            ['sign']
          );
          const sigBuf = await crypto.subtle.sign('HMAC', key, enc.encode(payload));
          const sigHex = Array.from(new Uint8Array(sigBuf))
            .map(b => b.toString(16).padStart(2, '0'))
            .join('')
            .substring(0, 32);

          return `crt.v1.${timestamp}.${nonce}.${sigHex}`;
        } catch (e) {}
      }
      return `crt.v1.${timestamp}.${nonce}.sigfallback`;
    }

    async function buildSsoLoginUrl() {
      const authUrl = 'https://accounts.yaoxi.cloud';
      const clientId = 'yaoxi-blog';
      const targetDomain = window.location.hostname;
      const redirectUri = window.location.href.split('#')[0];
      const clientRequestToken = await createSignedHandshakeToken(targetDomain);

      try {
        sessionStorage.setItem('yaoxi_auth_pending_token', clientRequestToken);
      } catch (e) {}

      const params = new URLSearchParams({
        client_id: clientId,
        target_domain: targetDomain,
        redirect_uri: redirectUri,
        client_request_token: clientRequestToken,
        response_type: 'token',
        scope: 'openid profile email admin',
        state: 'st_' + Math.random().toString(36).substring(2, 10),
      });
      return `${authUrl}/accounts-login.html?${params.toString()}`;
    }

    async function triggerSsoLoginRedirect() {
      if (window.yaoxiAuth && typeof window.yaoxiAuth.login === 'function') {
        try {
          await window.yaoxiAuth.login({ mode: 'redirect' });
          return;
        } catch (e) {}
      }
      const ssoLoginUrl = await buildSsoLoginUrl();
      const btnManualLogin = document.getElementById('btn-manual-login');
      if (btnManualLogin) btnManualLogin.href = ssoLoginUrl;
      window.location.replace(ssoLoginUrl);
    }

    /**
     * 前置安全门禁与拦截器 (Gatekeeper & Interceptor)
     * 1. 检测到未登录 -> 自动跳转到登录页
     * 2. 检测到不是管理员权限 -> 直接拦截 (403 Forbidden)
     * 3. 确认为管理员 -> 放行进入后台 Studio
     */
    function enforceAdminAuthGuard() {
      handleUrlCallback();

      const guardContainer = document.getElementById('admin-guard-container');
      const guardChecking = document.getElementById('guard-state-checking');
      const guardRedirecting = document.getElementById('guard-state-redirecting');
      const guardForbidden = document.getElementById('guard-state-forbidden');
      const studioRoot = document.getElementById('admin-studio-root');

      const forbiddenUserName = document.getElementById('forbidden-user-name');
      const forbiddenUserUid = document.getElementById('forbidden-user-uid');
      const forbiddenUserRole = document.getElementById('forbidden-user-role');
      const btnManualLogin = document.getElementById('btn-manual-login');

      const token = getAdminToken();
      const user = getAdminUser();

      // 场景 1: 未登录 -> 拦截并自动跳转登录页
      if (!token) {
        if (studioRoot) studioRoot.style.display = 'none';
        if (guardContainer) guardContainer.style.display = 'flex';
        if (guardChecking) guardChecking.classList.add('hidden');
        if (guardForbidden) guardForbidden.classList.add('hidden');
        if (guardRedirecting) guardRedirecting.classList.remove('hidden');

        // 异步签发防伪 token 并预填备用手动登录链接
        buildSsoLoginUrl().then((ssoLoginUrl) => {
          if (btnManualLogin) btnManualLogin.href = ssoLoginUrl;
        });

        // 延迟 220ms 执行重定向，保证过渡自然且给用户清晰引导
        setTimeout(() => {
          if (!getAdminToken()) {
            triggerSsoLoginRedirect();
          }
        }, 220);
        return false;
      }

      // 场景 2: 已登录，但缺乏管理员权限 -> 直接拦截 (403 Forbidden)
      const isAdmin = checkUserIsAdmin(user);
      if (!isAdmin) {
        if (studioRoot) studioRoot.style.display = 'none';
        if (guardContainer) guardContainer.style.display = 'flex';
        if (guardChecking) guardChecking.classList.add('hidden');
        if (guardRedirecting) guardRedirecting.classList.add('hidden');
        if (guardForbidden) guardForbidden.classList.remove('hidden');

        const displayName = (user && (user.name || user.username || user.email)) || '成员用户';
        const uid = (user && (user.sub || user.id)) || '未知 UID';
        const rawRole = (user && (user.role || (Array.isArray(user.roles) ? user.roles.join(', ') : ''))) || 'member';

        if (forbiddenUserName) forbiddenUserName.textContent = displayName;
        if (forbiddenUserUid) forbiddenUserUid.textContent = String(uid);
        if (forbiddenUserRole) forbiddenUserRole.textContent = `${rawRole} (无管理员权限)`;

        return false;
      }

      // 场景 3: 校验通过（管理员身份）-> 放行进入 Studio
      if (guardContainer) guardContainer.style.display = 'none';
      if (studioRoot) studioRoot.style.display = 'block';

      // 管理员登录态下，若本地未缓存 GitHub PAT，自动随统一认证中心静默下发凭据
      const cachedPat = resolveGithubPat();
      if (!cachedPat && typeof window.yaoxiSyncCredentials === 'function') {
        window.yaoxiSyncCredentials().catch(() => {});
      }

      return true;
    }

