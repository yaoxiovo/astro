    // ============================================================
    // Umami 流量统计大盘自动化处理
    // ============================================================
    let umamiWebsiteId = null;
    let umamiToken = null;
    let analyticsRange = '7d';
    let isFetchingAnalytics = false;

    const rootEl = document.getElementById('admin-studio-root');
    const umamiBaseUrl = rootEl?.getAttribute('data-umami-base') || 'https://umami.yaoxi.cloud';
    const umamiShareId = rootEl?.getAttribute('data-umami-share') || 'CLGxRecPqPn9IidK';

    async function ensureUmamiAuth() {
      if (umamiWebsiteId && umamiToken) return { websiteId: umamiWebsiteId, token: umamiToken };
      const res = await fetch(`${umamiBaseUrl}/api/share/${umamiShareId}`);
      if (!res.ok) throw new Error(`Umami Share 认证失败: HTTP ${res.status}`);
      const data = await res.json();
      umamiWebsiteId = data.websiteId;
      umamiToken = data.token;
      return { websiteId: umamiWebsiteId, token: umamiToken };
    }

    async function loadUmamiAnalytics() {
      if (isFetchingAnalytics) return;
      isFetchingAnalytics = true;
      const refreshIcon = document.getElementById('analytics-refresh-icon');
      refreshIcon?.classList.add('animate-spin');

      const elActive = document.getElementById('umami-active-visitors');
      const elPv = document.getElementById('stat-pv');
      const elUv = document.getElementById('stat-uv');
      const elVisits = document.getElementById('stat-visits');
      const elBounce = document.getElementById('stat-bounce');
      const elTopPages = document.getElementById('analytics-top-pages');
      const elTopReferrers = document.getElementById('analytics-top-referrers');
      const elTopCountries = document.getElementById('analytics-top-countries');

      try {
        const { websiteId, token } = await ensureUmamiAuth();
        const headers = { 'x-umami-share-token': token };

        const now = Date.now();
        let days = 7;
        if (analyticsRange === 'today') days = 1;
        else if (analyticsRange === '30d') days = 30;
        const startAt = now - days * 86400000;

        const [activeRes, statsRes, pagesRes, refRes, countryRes] = await Promise.allSettled([
          fetch(`${umamiBaseUrl}/api/websites/${websiteId}/active`, { headers }).then(r => r.json()),
          fetch(`${umamiBaseUrl}/api/websites/${websiteId}/stats?startAt=${startAt}&endAt=${now}`, { headers }).then(r => r.json()),
          fetch(`${umamiBaseUrl}/api/websites/${websiteId}/metrics?startAt=${startAt}&endAt=${now}&type=path&limit=7`, { headers }).then(r => r.json()),
          fetch(`${umamiBaseUrl}/api/websites/${websiteId}/metrics?startAt=${startAt}&endAt=${now}&type=referrer&limit=5`, { headers }).then(r => r.json()),
          fetch(`${umamiBaseUrl}/api/websites/${websiteId}/metrics?startAt=${startAt}&endAt=${now}&type=country&limit=5`, { headers }).then(r => r.json()),
        ]);

        if (activeRes.status === 'fulfilled' && activeRes.value) {
          if (elActive) elActive.textContent = activeRes.value.visitors ?? 0;
        }

        if (statsRes.status === 'fulfilled' && statsRes.value) {
          const s = statsRes.value;
          if (elPv) elPv.textContent = (s.pageviews ?? 0).toLocaleString();
          if (elUv) elUv.textContent = (s.visitors ?? 0).toLocaleString();
          if (elVisits) elVisits.textContent = (s.visits ?? 0).toLocaleString();
          const bounceRate = s.visits ? Math.round(((s.bounces ?? 0) / s.visits) * 100) : 0;
          if (elBounce) elBounce.textContent = `${bounceRate}%`;
        }

        if (pagesRes.status === 'fulfilled' && Array.isArray(pagesRes.value)) {
          const pages = pagesRes.value;
          if (pages.length === 0) {
            if (elTopPages) elTopPages.innerHTML = '<div class="text-xs text-black/40 dark:text-white/40 text-center py-6">暂无访问页面记录 喵~</div>';
          } else {
            const maxViews = Math.max(...pages.map(p => p.y || 1));
            if (elTopPages) {
              elTopPages.innerHTML = pages.map((p, idx) => {
                const percent = Math.round(((p.y || 0) / maxViews) * 100);
                return `
                  <div class="p-2.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.03] hover:bg-black/[0.05] dark:hover:bg-white/[0.06] transition-all">
                    <div class="flex items-center justify-between text-xs mb-1.5">
                      <div class="flex items-center gap-2 truncate pr-2">
                        <span class="w-5 h-5 rounded-md flex items-center justify-center text-[10px] font-mono font-bold ${idx < 3 ? 'bg-[var(--primary)] text-white dark:text-black' : 'bg-black/10 dark:bg-white/10 text-black/60 dark:text-white/60'} shrink-0">${idx + 1}</span>
                        <a href="${p.x}" target="_blank" class="truncate font-mono text-black/85 dark:text-white/85 hover:text-[var(--primary)]">${p.x}</a>
                      </div>
                      <span class="font-mono font-bold text-black/80 dark:text-white/80 shrink-0">${p.y} 次</span>
                    </div>
                    <div class="w-full bg-black/5 dark:bg-white/10 h-1.5 rounded-full overflow-hidden">
                      <div class="h-full bg-[var(--primary)] rounded-full transition-all duration-500" style="width: ${percent}%;"></div>
                    </div>
                  </div>
                `;
              }).join('');
            }
          }
        }

        if (refRes.status === 'fulfilled' && Array.isArray(refRes.value)) {
          const refs = refRes.value;
          if (elTopReferrers) {
            if (refs.length === 0) {
              elTopReferrers.innerHTML = '<div class="text-xs text-black/40 dark:text-white/40 text-center py-4">直接访问 (Direct) 或暂无外链</div>';
            } else {
              elTopReferrers.innerHTML = refs.map(r => `
                <div class="flex items-center justify-between py-1 border-b border-[var(--line-divider)]/40 last:border-none">
                  <span class="truncate font-mono text-black/70 dark:text-white/70">${r.x || '直接访问 (Direct)'}</span>
                  <span class="font-mono font-bold text-[var(--primary)] shrink-0">${r.y}</span>
                </div>
              `).join('');
            }
          }
        }

        if (countryRes.status === 'fulfilled' && Array.isArray(countryRes.value)) {
          const countries = countryRes.value;
          if (elTopCountries) {
            if (countries.length === 0) {
              elTopCountries.innerHTML = '<div class="text-xs text-black/40 dark:text-white/40 text-center py-4">暂无地域统计数据</div>';
            } else {
              elTopCountries.innerHTML = countries.map(c => `
                <div class="flex items-center justify-between py-1 border-b border-[var(--line-divider)]/40 last:border-none">
                  <span class="font-mono text-black/70 dark:text-white/70">${c.x || '未知'}</span>
                  <span class="font-mono font-bold text-emerald-500 shrink-0">${c.y}</span>
                </div>
              `).join('');
            }
          }
        }

      } catch (err) {
        console.error('[Umami Analytics Error]', err);
        if (elTopPages) elTopPages.innerHTML = `<div class="text-xs text-red-500 text-center py-6">无法连接至 Umami 节点: ${err.message || '网络连接异常'} 喵！</div>`;
      } finally {
        isFetchingAnalytics = false;
        refreshIcon?.classList.remove('animate-spin');
      }
    }

