    // 8.5 核心发布朋友圈动态流程
    async function publishMoment() {
      const content = momentContentEl ? momentContentEl.value.trim() : '';
      const slug = momentSlugEl ? momentSlugEl.value.trim() : '';
      const author = (momentAuthorEl ? momentAuthorEl.value.trim() : '') || '瑶曦';
      const source = (momentSourceEl ? momentSourceEl.value.trim() : '') || 'Astro Web Studio';
      const isCapsule = momentIsCapsuleEl ? momentIsCapsuleEl.checked : false;
      const capsuleDate = momentCapsuleDateEl ? momentCapsuleDateEl.value : '';
      const pinned = momentPinnedEl ? momentPinnedEl.checked : false;
      const replyTo = momentReplyToEl ? momentReplyToEl.value.trim() : '';
      const rawImages = momentImagesEl ? momentImagesEl.value.trim() : '';
      const rawVideos = momentVideosEl ? momentVideosEl.value.trim() : '';

      if (!content) {
        alert('请填写朋友圈动态的正文内容 喵！');
        return;
      }

      if (isCapsule && !capsuleDate) {
        alert('勾选了设为时间胶囊，请选择解封时间 喵！');
        return;
      }

      const token = getAdminToken();
      if (!token) {
        alert('尚未获取到有效认证 Token！请先一键登录或在“鉴权凭据”中填入 Token 喵！');
        modalAuth.classList.remove('hidden');
        return;
      }

      const user = getAdminUser();
      if (user) {
        const rawRole = String(user.role || '').toLowerCase();
        const roles = Array.isArray(user.roles) ? user.roles.map((r) => String(r).toLowerCase()) : [];
        const isAdmin = rawRole === 'admin' || roles.includes('admin') || user.is_admin === true;
        if (!isAdmin) {
          alert('权限不足：发布动态仅限认证中心授权的【管理员 (admin)】喵！');
          return;
        }
      }

      const apiBase = (localStorage.getItem(API_ENDPOINT_KEY) || 'https://zk-api.yaoxi.cloud').replace(/\/$/, '');
      let githubPat = resolveGithubPat();

      if (!githubPat && typeof window.yaoxiSyncCredentials === 'function') {
        try {
          const creds = await window.yaoxiSyncCredentials();
          if (creds && creds.github_pat) {
            githubPat = creds.github_pat;
            if (inputGithubToken) inputGithubToken.value = creds.github_pat;
          }
        } catch (e) {}
      }

      btnPublish.disabled = true;
      publishSpinner.classList.remove('hidden');
      publishIcon.classList.add('hidden');
      btnPublishText.textContent = '正在发布动态...';

      deployPanel.classList.remove('hidden');
      deploySuccessLinks.classList.add('hidden');
      deployProgressBar.style.width = '20%';
      deployProgressBar.className = 'h-full bg-[var(--primary)] transition-all duration-500 ease-out rounded-full';
      deployTitle.textContent = '正在向 GitHub 提交朋友圈动态 Commit...';
      deploySubtitle.textContent = '生成符合 Astro Moments 规范的 Markdown 产物';
      deployBadge.textContent = 'PUBLISHING';
      deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-blue-500/10 text-blue-500 border border-blue-500/20';
      deployStageInfo.textContent = githubPat ? '阶段: GitHub API 直连提交' : '阶段: Worker BFF 代理提交';

      deploySeconds = 0;
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        deploySeconds++;
        deployTimer.textContent = `耗时: ${deploySeconds}s`;
      }, 1000);

      try {
        let commitSha = '';
        let momentSlug = slug || `m-${Date.now()}`;

        if (githubPat) {
          deployStageInfo.textContent = '阶段: GitHub API 直连提交';
          const nowIso = new Date().toISOString();
          const imgList = rawImages ? rawImages.split(/[\n,]+/).map(s => s.trim()).filter(Boolean) : [];
          const videoList = rawVideos ? rawVideos.split(/[\n,]+/).map(s => s.trim()).filter(Boolean) : [];

          const imagesYaml = imgList.length > 0
            ? `images:\n${imgList.map(img => `  - "${img.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`).join('\n')}\n`
            : '';
          const videosYaml = videoList.length > 0
            ? `videos:\n${videoList.map(v => `  - "${v.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`).join('\n')}\n`
            : '';
          const capsuleYaml = isCapsule && capsuleDate ? `capsule: ${new Date(capsuleDate).toISOString()}\n` : '';
          const replyToYaml = replyTo ? `replyTo: "${String(replyTo).replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"\n` : '';

          const momentFile = `---
published: ${nowIso}
author: "${(author || '瑶曦').replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"
source: "${(source || 'Astro Web Studio').replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"
pinned: ${Boolean(pinned)}
${capsuleYaml}${replyToYaml}${imagesYaml}${videosYaml}---

${content.trim()}
`;
          const res = await commitDirectToGitHub(githubPat, `src/content/moments/${momentSlug}.md`, momentFile, `docs(moment): publish moment ${momentSlug} via Admin Studio`);
          commitSha = res.commit_sha;
        } else {
          deployStageInfo.textContent = '阶段: Worker BFF 代理提交';
          const headers = {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          };
          const payload = {
            content,
            slug: slug || undefined,
            author,
            source,
            pinned,
            replyTo: replyTo || undefined,
            capsule: isCapsule ? new Date(capsuleDate).toISOString() : undefined,
            images: rawImages ? rawImages.split(/[\n,]+/).map(s => s.trim()).filter(Boolean) : [],
            videos: rawVideos ? rawVideos.split(/[\n,]+/).map(s => s.trim()).filter(Boolean) : [],
            githubToken: undefined,
          };

          try {
            const res = await fetch(`${apiBase}/api/publish-moment`, {
              method: 'POST',
              headers,
              body: JSON.stringify(payload)
            });

            if (!res.ok) {
              let errData = {};
              try { errData = await res.json(); } catch (e) {
                errData = { message: `网络请求失败 (HTTP ${res.status})` };
              }
              const fullMsg = [errData.message, errData.details].filter(Boolean).join(' - ') || `HTTP ${res.status}`;
              const customErr = new Error(fullMsg);
              customErr.stage = errData.error || `HTTP ${res.status}`;
              throw customErr;
            }

            const data = await res.json();
            commitSha = data.commit_sha;
            momentSlug = data.slug || momentSlug;
          } catch (fetchErr) {
            if (fetchErr.name === 'TypeError' || String(fetchErr.message).includes('fetch')) {
              const err = new Error(`无法连接到 Worker BFF 网关 (${apiBase})，且尚未配置 GitHub PAT！请在右上角【鉴权凭据】中填入具备 contents:write 权限的 GitHub PAT，即可启用浏览器客户端直连提交 喵！`);
              err.stage = 'BFF 网关离线 / 未配置 PAT';
              throw err;
            }
            throw fetchErr;
          }
        }

        deployProgressBar.style.width = '40%';
        deployTitle.textContent = `GitHub 动态提交成功 (${commitSha.substring(0, 7)})`;
        deploySubtitle.textContent = '等待 Cloudflare Pages 启动自动化构建流水线...';
        deployBadge.textContent = 'QUEUED';
        deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-amber-500/10 text-amber-500 border border-amber-500/20';

        pollDeployStatus(apiBase, token, commitSha, momentSlug, 'moment');

      } catch (err) {
        clearInterval(timerInterval);
        console.error('[Moment Publish Error]', err);

        deployTitle.textContent = '动态提交失败 喵！';
        deployBadge.textContent = 'ERROR';
        deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-red-500/10 text-red-500 border border-red-500/20';
        deployProgressBar.style.width = '100%';
        deployProgressBar.className = 'h-full bg-red-500 rounded-full';
        deployStageInfo.textContent = `失败原因: ${err.stage || '网络或接口异常'}`;

        const isAuthErr = String(err.message).includes('Token') ||
          String(err.message).includes('GitHub') ||
          String(err.message).includes('credentials') ||
          String(err.message).includes('401') ||
          String(err.message).includes('403') ||
          String(err.message).includes('Unauthorized') ||
          String(err.message).includes('Forbidden') ||
          String(err.message).includes('PAT');

        if (isAuthErr) {
          deploySubtitle.innerHTML = `<span class="break-all">${err.message}</span><br/><button type="button" id="btn-fix-auth-err-moment" class="mt-2.5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-black/10 dark:bg-white/15 text-xs font-semibold text-[var(--primary)] hover:opacity-80 transition-all cursor-pointer"><span>🔐 打开【鉴权凭据】配置或更新有效 GitHub PAT</span></button>`;
          document.getElementById('btn-fix-auth-err-moment')?.addEventListener('click', () => {
            modalAuth.classList.remove('hidden');
          });
        } else {
          deploySubtitle.textContent = err.message || '未知异常，请检查网络或控制台输出';
        }

        btnPublish.disabled = false;
        publishSpinner.classList.add('hidden');
        publishIcon.classList.remove('hidden');
        btnPublishText.textContent = '重新发布';
      }
    }

    // 9. 智能多通道部署状态探测引擎 (Multi-Engine Deploy Probe)
    function pollDeployStatus(apiBase, token, commitSha, slug, targetType = 'post') {
      if (deployPollTimer) clearInterval(deployPollTimer);

      const githubPat = resolveGithubPat();
      const cleanSlug = String(slug || '').replace(/\.md$/, '').replace(/^\/+/, '');
      let pollAttempts = 0;

      deployPollTimer = setInterval(async () => {
        pollAttempts++;
        let status = null; // 'queued' | 'active' | 'success' | 'failure'
        let stage = 'build';
        let previewUrl = '';

        // 通道 1: 若配置了自建 BFF Worker，且不是无效的默认域名，尝试通过 Worker 查询
        if (apiBase && !apiBase.includes('zk-api.yaoxi.cloud')) {
          try {
            const activeToken = token || getAdminToken();
            const res = await fetch(`${apiBase}/api/deploy-status?commit=${commitSha}`, {
              headers: { 'Authorization': `Bearer ${activeToken}` }
            });
            if (res.ok) {
              const data = await res.json();
              status = data.status;
              stage = data.stage || 'pages';
              previewUrl = data.preview_url;
            }
          } catch (e) {
            // Worker 离线，静默跳过走后续通道
          }
        }

        // 通道 2: 客户端 GitHub 官方 Check Runs & Status API 探针 (直连 GitHub，0 中间件)
        if (!status && githubPat && commitSha) {
          try {
            // 2.1 检查 Check Runs (Cloudflare Pages 与 GitHub Actions 标准构建上报接口)
            const checkRes = await fetch(`https://api.github.com/repos/yaoxiovo/astro/commits/${commitSha}/check-runs`, {
              headers: {
                'Authorization': `Bearer ${githubPat}`,
                'Accept': 'application/vnd.github.v3+json',
              }
            });

            if (checkRes.ok) {
              const checkData = await checkRes.json();
              const runs = checkData.check_runs || [];
              if (runs.length > 0) {
                // 查找 Cloudflare Pages 或主要工作流
                const pagesRun = runs.find((r) => {
                  const n = String(r.name || '').toLowerCase();
                  return n.includes('cloudflare') || n.includes('pages');
                }) || runs[0];

                if (pagesRun.status === 'completed') {
                  if (pagesRun.conclusion === 'success') {
                    status = 'success';
                    stage = pagesRun.name || 'Cloudflare Pages';
                    previewUrl = pagesRun.details_url || pagesRun.html_url;
                  } else if (pagesRun.conclusion === 'failure') {
                    status = 'failure';
                    stage = pagesRun.name || 'Cloudflare Pages';
                  }
                } else if (pagesRun.status === 'in_progress') {
                  status = 'active';
                  stage = pagesRun.name || '构建编译中';
                } else if (pagesRun.status === 'queued') {
                  status = 'queued';
                  stage = '排队准备中';
                }
              }
            }

            // 2.2 若 Check Runs 暂无结果，检查 Combined Status
            if (!status) {
              const statusRes = await fetch(`https://api.github.com/repos/yaoxiovo/astro/commits/${commitSha}/status`, {
                headers: {
                  'Authorization': `Bearer ${githubPat}`,
                  'Accept': 'application/vnd.github.v3+json',
                }
              });
              if (statusRes.ok) {
                const combined = await statusRes.json();
                if (combined.state === 'success') {
                  status = 'success';
                  stage = 'GitHub Status Verified';
                } else if (combined.state === 'failure' || combined.state === 'error') {
                  status = 'failure';
                  stage = 'GitHub Status Failed';
                } else if (combined.state === 'pending' && combined.total_count > 0) {
                  status = 'active';
                  stage = '构建中 (Pending)';
                }
              }
            }
          } catch (ghErr) {
            console.warn('[Probe GitHub Check Error]', ghErr);
          }
        }

        // 通道 3: 目标页面 HTTP 原生端到端探活 (Live Edge Probe)
        // 直接向 blog.yaoxi.wiki 发起带时间戳无缓存请求，检测页面是否已在 CDN 边缘生效
        if (status !== 'success' && status !== 'failure' && cleanSlug && targetType === 'post') {
          try {
            const probeTarget = `/posts/${cleanSlug}/?_edge_probe=${Date.now()}`;
            const liveRes = await fetch(probeTarget, {
              method: 'GET',
              cache: 'no-store',
              headers: { 'Cache-Control': 'no-cache, no-store' }
            });
            // 只要返回 200 且不是 404 错误页，证明页面已完成静态编译并发布上线
            if (liveRes.ok && liveRes.status === 200) {
              const htmlText = await liveRes.text();
              if (!htmlText.includes('404') && !htmlText.includes('页面未找到')) {
                status = 'success';
                stage = 'CDN Edge Live 200 OK';
              }
            }
          } catch (liveErr) {
            // ignore
          }
        }

        // 文章删除的原生端到端探活 (检测是否已返回 404 或下线)
        if (status !== 'success' && status !== 'failure' && cleanSlug && targetType === 'delete') {
          try {
            const probeTarget = `/posts/${cleanSlug}/?_edge_probe=${Date.now()}`;
            const liveRes = await fetch(probeTarget, {
              method: 'GET',
              cache: 'no-store',
              headers: { 'Cache-Control': 'no-cache, no-store' }
            });
            if (liveRes.status === 404) {
              status = 'success';
              stage = 'CDN Edge 404 (Removed)';
            } else if (liveRes.ok) {
              const htmlText = await liveRes.text();
              if (htmlText.includes('404') || htmlText.includes('页面未找到') || htmlText.includes('Page Not Found')) {
                status = 'success';
                stage = 'CDN Edge 404 (Removed)';
              }
            }
          } catch (e) {}
        }

        // 朋友圈动态的端到端探活 (通过 /api/moments.json 检查是否收录)
        if (status !== 'success' && status !== 'failure' && targetType === 'moment' && cleanSlug) {
          try {
            const momentsRes = await fetch(`/api/moments.json?_edge_probe=${Date.now()}`, {
              cache: 'no-store'
            });
            if (momentsRes.ok) {
              const momentsList = await momentsRes.json();
              if (Array.isArray(momentsList) && momentsList.some((m) => m.slug === cleanSlug)) {
                status = 'success';
                stage = 'CDN Moments Live';
              }
            }
          } catch (e) {}
        }

        // 状态平滑渲染
        if (status === 'queued') {
          deployProgressBar.style.width = '35%';
          deployBadge.textContent = 'QUEUED';
          deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-amber-500/10 text-amber-500 border border-amber-500/20';
          deployTitle.textContent = 'Cloudflare Pages 构建排队中...';
          deployStageInfo.textContent = `阶段: ${stage} · 探测第 ${pollAttempts} 次`;
        } else if (status === 'active') {
          deployProgressBar.style.width = '70%';
          deployBadge.textContent = 'ACTIVE';
          deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-blue-500/10 text-blue-500 border border-blue-500/20 animate-pulse';
          deployTitle.textContent = 'Cloudflare Pages 正在构建与静态编译中...';
          deployStageInfo.textContent = `阶段: ${stage} · 持续探测中 (${deploySeconds}s)`;
        } else if (status === 'success') {
          // 部署成功！
          clearInterval(deployPollTimer);
          clearInterval(timerInterval);

          deployProgressBar.style.width = '100%';
          deployProgressBar.className = 'h-full bg-emerald-500 rounded-full transition-all';
          deployBadge.textContent = 'SUCCESS';
          deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-emerald-500/10 text-emerald-500 border border-emerald-500/20';
          deploySubtitle.textContent = `Commit: ${commitSha ? commitSha.substring(0, 7) : 'HEAD'} · 全球 Anycast CDN 缓存已就绪 喵！`;
          deployStageInfo.textContent = `阶段: 验证通过 (${stage})`;

          if (targetType === 'moment') {
            deployTitle.textContent = '🎉 全球边缘发布完成！朋友圈动态已正式上线 喵！';
            linkLivePost.href = `/moments/`;
            const liveText = linkLivePost.querySelector('span');
            if (liveText) liveText.textContent = '前往朋友圈查看动态';
          } else if (targetType === 'delete') {
            deployTitle.textContent = '🎉 全球边缘更新完成！文章已成功从线上彻底移除 喵！';
            linkLivePost.href = `/admin/`;
            const liveText = linkLivePost.querySelector('span');
            if (liveText) liveText.textContent = '返回后台文章管理列表';
          } else {
            deployTitle.textContent = '🎉 全球边缘发布完成！文章已正式上线 喵！';
            localStorage.removeItem(STORAGE_KEY);
            draftStatusEl.classList.add('hidden');
            linkLivePost.href = `/posts/${cleanSlug}/`;
            const liveText = linkLivePost.querySelector('span');
            if (liveText) liveText.textContent = '在新标签页阅读新文章';
          }

          linkPreviewUrl.href = previewUrl || `https://blog.yaoxi.wiki`;
          linkPreviewUrl.textContent = previewUrl ? `预览节点 (${previewUrl.replace('https://', '').substring(0, 20)}...)` : '线上正式节点';
          deploySuccessLinks.classList.remove('hidden');

          btnPublish.disabled = false;
          publishSpinner.classList.add('hidden');
          publishIcon.classList.remove('hidden');
          btnPublishText.textContent = targetType === 'delete' ? '已删除下线' : '已发布上线';
        } else if (status === 'failure') {
          clearInterval(deployPollTimer);
          clearInterval(timerInterval);

          deployProgressBar.style.width = '100%';
          deployProgressBar.className = 'h-full bg-red-500 rounded-full';
          deployBadge.textContent = 'FAILURE';
          deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-red-500/10 text-red-500 border border-red-500/20';
          deployTitle.textContent = 'Cloudflare Pages 构建失败 喵！';
          deploySubtitle.textContent = '构建管道返回异常状态，请前往 GitHub/Cloudflare 控制台查看详细构建日志。';

          btnPublish.disabled = false;
          publishSpinner.classList.add('hidden');
          publishIcon.classList.remove('hidden');
          btnPublishText.textContent = '重试发布';
        } else {
          // 兜底心跳态：逐步动态增加进度条，让用户明确感知探针在积极探活
          const estimatedProgress = Math.min(85, 30 + Math.floor(pollAttempts * 2));
          deployProgressBar.style.width = `${estimatedProgress}%`;
          deployBadge.textContent = 'PROBING';
          deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-blue-500/10 text-blue-500 border border-blue-500/20 animate-pulse';
          deployTitle.textContent = 'GitHub Commit 提交成功，正在探活 Cloudflare Pages 编译状态...';
          deployStageInfo.textContent = `探针第 ${pollAttempts} 次轮询 (${deploySeconds}s) · 正在多通道验证`;

          // 超时（例如 90s 以上）提供直接验证跳转兜底
          if (pollAttempts >= 30) {
            const directTarget = targetType === 'moment' ? '/moments/' : (targetType === 'delete' ? '/admin/' : `/posts/${cleanSlug}/`);
            deploySubtitle.innerHTML = `Commit: ${commitSha ? commitSha.substring(0, 7) : 'HEAD'} · Pages 正在后台编译分发中。<br/><a href="${directTarget}" target="_blank" class="mt-2 inline-flex items-center gap-1 text-[var(--primary)] font-bold underline hover:opacity-80"><span>🚀 探活超时，点击直接打开目标页面验证 喵</span></a>`;
          }
        }
      }, 3000);
    }

    // 再写一篇 / 再发一条
    btnContinueWriting.addEventListener('click', () => {
      if (currentEditorMode === 'post') {
        exitEditingMode();
        titleEl.value = '';
        slugEl.value = '';
        tagsEl.value = '';
        descEl.value = '';
        contentEl.value = '';
        isAutoSlug = true;
        btnPublishText.textContent = '发布文章并构建';
      } else {
        if (momentContentEl) momentContentEl.value = '';
        if (momentSlugEl) momentSlugEl.value = '';
        if (momentImagesEl) momentImagesEl.value = '';
        if (momentVideosEl) momentVideosEl.value = '';
        btnPublishText.textContent = '发布动态并构建';
        syncMomentPreview();
      }
      deployPanel.classList.add('hidden');
      deploySuccessLinks.classList.add('hidden');
      updateStats();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    btnPublish.addEventListener('click', () => {
      if (!checkUserIsAdmin(getAdminUser())) {
        alert('权限不足：当前账号不是系统管理员，已被禁止提交发布 喵！');
        enforceAdminAuthGuard();
        return;
      }
      if (currentEditorMode === 'post') {
        publishPost();
      } else {
        publishMoment();
      }
    });

    // 绑定拦截页交互按钮
    const btnForbiddenSwitch = document.getElementById('btn-forbidden-switch');
    if (btnForbiddenSwitch) {
      btnForbiddenSwitch.addEventListener('click', async () => {
        if (window.yaoxiAuth && typeof window.yaoxiAuth.logout === 'function') {
          window.yaoxiAuth.logout();
        } else {
          TOKEN_CANDIDATE_KEYS.forEach((k) => localStorage.removeItem(k));
          localStorage.removeItem('yaoxi_auth_user');
          localStorage.removeItem('user_profile');
          localStorage.removeItem('yaoxi_auth_exp');
        }
        await triggerSsoLoginRedirect();
      });
    }

    const btnManualLogin = document.getElementById('btn-manual-login');
    if (btnManualLogin) {
      btnManualLogin.addEventListener('click', (e) => {
        e.preventDefault();
        triggerSsoLoginRedirect();
      });
    }

    const btnForbiddenLogout = document.getElementById('btn-forbidden-logout');
    if (btnForbiddenLogout) {
      btnForbiddenLogout.addEventListener('click', () => {
        if (typeof window.yaoxiLogout === 'function') {
          window.yaoxiLogout();
        } else if (window.yaoxiAuth && typeof window.yaoxiAuth.logout === 'function') {
          window.yaoxiAuth.logout();
        } else {
          TOKEN_CANDIDATE_KEYS.forEach((k) => localStorage.removeItem(k));
          localStorage.removeItem('yaoxi_auth_user');
          localStorage.removeItem('user_profile');
          localStorage.removeItem('yaoxi_auth_exp');
        }
        window.location.reload();
      });
    }

    // 监听全局 SSO 状态变化广播
    window.addEventListener('yaoxi:auth:change', () => {
      if (enforceAdminAuthGuard()) {
        syncAuthUI();
      }
    });

    // 监听跨标签页 Storage 变更（例如在主站或其他标签页完成登录）
    window.addEventListener('storage', (e) => {
      if (!e.key || e.key.includes('auth') || e.key.includes('token') || e.key.includes('user')) {
        if (enforceAdminAuthGuard()) {
          syncAuthUI();
        }
      }
    });

    // 监听单页应用路由与页面加载
    document.addEventListener('swup:page:view', () => {
      if (enforceAdminAuthGuard()) {
        syncAuthUI();
      }
    });
    document.addEventListener('astro:page-load', () => {
      if (enforceAdminAuthGuard()) {
        syncAuthUI();
      }
    });

    // =====================================================================
    // ▓▓ 视觉工坊扩展模块：预览 / 图片直传 / 质量预检 / 版本回滚 / Wiki 洞察 ▓▓
    // =====================================================================

    // ---------- [A] Markdown 实时预览 (Live Preview) ----------
    const previewPane = document.getElementById('post-preview');
    const btnTogglePreview = document.getElementById('btn-toggle-preview');
    let isPreviewMode = false;

    // 补全历史遗留调用点：内容变化时若处于预览模式则刷新渲染
    function updateLivePreview() {
      if (isPreviewMode) renderPostPreview();
    }

    function renderPostPreview() {
      if (!previewPane) return;
      const source = contentEl.value;
      if (!source.trim()) {
        previewPane.innerHTML = '<p class="opacity-40 italic">正文还是空白的喵~ 先在编辑区写点什么吧！</p>';
        return;
      }
      if (typeof window.__adminMdRender === 'function') {
        previewPane.innerHTML = window.__adminMdRender(source);
      } else {
        const pre = document.createElement('pre');
        pre.className = 'whitespace-pre-wrap font-mono text-xs opacity-70';
        pre.textContent = source;
        previewPane.replaceChildren(pre);
      }
    }

    function setPreviewMode(enabled) {
      isPreviewMode = enabled;
      if (!previewPane) return;
      if (enabled) {
        previewPane.classList.remove('hidden');
        contentEl.classList.add('hidden');
        if (btnTogglePreview) {
          btnTogglePreview.textContent = '✍️ 编辑';
          btnTogglePreview.classList.add('bg-[var(--primary)]/10');
        }
        renderPostPreview();
      } else {
        previewPane.classList.add('hidden');
        contentEl.classList.remove('hidden');
        if (btnTogglePreview) {
          btnTogglePreview.textContent = '👁 预览';
          btnTogglePreview.classList.remove('bg-[var(--primary)]/10');
        }
      }
    }

    btnTogglePreview?.addEventListener('click', () => setPreviewMode(!isPreviewMode));

    // ---------- [B] GitHub 图片直传通道 (Image Pipeline) ----------
    const btnUploadImage = document.getElementById('btn-upload-image');
    const imageUploadInput = document.getElementById('image-upload-input');
    let isImageUploading = false;

    // 二进制安全：直接取 dataURL 的原始 base64（不可复用文本版 toBase64Utf8）
    function blobToBase64Raw(blob) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || '').split(',')[1] || '');
        reader.onerror = () => reject(new Error('文件读取失败 喵！'));
        reader.readAsDataURL(blob);
      });
    }

    // 长边压缩至 1920px 内并转 WebP；GIF 原样直传保留动画
    async function compressImageFile(file) {
      if (file.type === 'image/gif') return { blob: file, ext: 'gif' };
      const dataUrl = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(new Error('图片读取失败 喵！'));
        reader.readAsDataURL(file);
      });
      const img = await new Promise((resolve, reject) => {
        const el = new Image();
        el.onload = () => resolve(el);
        el.onerror = () => reject(new Error('图片解码失败，可能不是有效图片 喵！'));
        el.src = dataUrl;
      });
      const MAX_DIM = 1920;
      const scale = Math.min(1, MAX_DIM / Math.max(img.width || 1, img.height || 1));
      const width = Math.max(1, Math.round((img.width || 1) * scale));
      const height = Math.max(1, Math.round((img.height || 1) * scale));
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      canvas.getContext('2d').drawImage(img, 0, 0, width, height);
      const toBlob = (mime) => new Promise((resolve) => canvas.toBlob(resolve, mime, 0.85));
      let blob = await toBlob('image/webp');
      let ext = 'webp';
      if (!blob) { blob = await toBlob('image/jpeg'); ext = 'jpg'; }
      if (!blob) throw new Error('图片压缩失败 喵！');
      return { blob, ext };
    }

    async function uploadImageToGitHub(blob, ext) {
      const pat = resolveGithubPat();
      if (!pat) {
        alert('缺少 GitHub PAT！请先在右上角“鉴权凭据”中填入具备 contents:write 权限的 Token 喵！');
        modalAuth.classList.remove('hidden');
        return null;
      }
      const now = new Date();
      const stamp = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, '0')}${String(now.getDate()).padStart(2, '0')}`;
      const fileName = `admin-${stamp}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
      const filePath = `src/content/assets/images/${fileName}`;
      const res = await fetch(`https://api.github.com/repos/yaoxiovo/astro/contents/${filePath}`, {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${pat}`,
          'Accept': 'application/vnd.github.v3+json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message: `assets: upload ${fileName} via Admin Studio`,
          content: await blobToBase64Raw(blob),
          branch: 'main',
        }),
      });
      if (!res.ok) {
        let msg = `HTTP ${res.status}`;
        try { const j = await res.json(); if (j && j.message) msg = j.message; } catch (e) {}
        throw new Error(`图片上传失败 (${res.status})：${msg}`);
      }
      return fileName;
    }

    function insertImageSyntax(fileName) {
      const snippet = `\n![图片](../assets/images/${fileName})\n`;
      const start = contentEl.selectionStart;
      const end = contentEl.selectionEnd;
      contentEl.setRangeText(snippet, start, end, 'end');
      contentEl.focus();
      updateStats();
      updateLivePreview();
    }

    async function handleImageUpload(file) {
      if (!file || !file.type || !file.type.startsWith('image/')) {
        alert('请选择图片文件喵！');
        return;
      }
      if (isImageUploading) return;
      isImageUploading = true;
      const btnOriginalText = btnUploadImage ? btnUploadImage.textContent : '';
      if (btnUploadImage) {
        btnUploadImage.textContent = '⏳ 上传中…';
        btnUploadImage.disabled = true;
      }
      try {
        const { blob, ext } = await compressImageFile(file);
        const fileName = await uploadImageToGitHub(blob, ext);
        if (fileName) insertImageSyntax(fileName);
      } catch (err) {
        console.error('[Admin] 图片上传失败:', err);
        alert(`图片上传失败：${err && err.message ? err.message : err}`);
      } finally {
        isImageUploading = false;
        if (btnUploadImage) {
          btnUploadImage.textContent = btnOriginalText;
          btnUploadImage.disabled = false;
        }
        if (imageUploadInput) imageUploadInput.value = '';
      }
    }

    btnUploadImage?.addEventListener('click', () => imageUploadInput?.click());
    imageUploadInput?.addEventListener('change', () => {
      const file = imageUploadInput.files && imageUploadInput.files[0];
      if (file) handleImageUpload(file);
    });

    // 截图直接 Ctrl+V 粘贴进编辑区即可上传
    contentEl.addEventListener('paste', (e) => {
      const items = Array.from((e.clipboardData && e.clipboardData.items) || []);
      const imageItem = items.find((item) => item.kind === 'file' && item.type && item.type.startsWith('image/'));
      if (!imageItem) return;
      e.preventDefault();
      const file = imageItem.getAsFile();
      if (file) handleImageUpload(file);
    });

    // ---------- [C] 发布前质量预检 (Pre-flight Quality Check) ----------
    const modalPreflight = document.getElementById('modal-preflight');
    const preflightSummary = document.getElementById('preflight-summary');
    const preflightList = document.getElementById('preflight-list');
    const btnPreflightCancel = document.getElementById('btn-preflight-cancel');
    const btnPreflightContinue = document.getElementById('btn-preflight-continue');

    // 与补链雷达同款思路：遮蔽代码块/行内代码/链接语法，防止未链提及误报
    function maskPreflightAreas(md) {
      let masked = String(md || '');
      masked = masked.replace(/```[\s\S]*?```/g, (m) => m.replace(/[^\n]/g, ' '));
      masked = masked.replace(/`[^`\n]*`/g, (m) => ' '.repeat(m.length));
      masked = masked.replace(/!?\[[^\]]*\]\([^)\s]*\)/g, (m) => ' '.repeat(m.length));
      masked = masked.replace(/!?\[[^\]]*\]\[[^\]]*\]/g, (m) => ' '.repeat(m.length));
      return masked;
    }

    function runPreflight({ slug, description, content }) {
      const errors = [];
      const warnings = [];

      // 1) 站内死链：链接目标必须在现有文章索引中
      const knownSlugs = new Set(postsData.map((p) => p.slug));
      const brokenLinks = new Set();
      const linkRe = /\]\(\s*(\/posts\/([^)\s#?]+)|https?:\/\/blog\.yaoxi\.wiki\/posts\/([^)\s#?]+))/g;
      let m;
      while ((m = linkRe.exec(content)) !== null) {
        let target = m[2] || m[3] || '';
        try { target = decodeURIComponent(target); } catch (e) {}
        target = target.replace(/\/+$/, '');
        if (target && !knownSlugs.has(target)) brokenLinks.add(target);
      }
      brokenLinks.forEach((target) => {
        errors.push({ level: 'error', icon: '🔗', text: `站内链接指向不存在的条目：/posts/${target}/` });
      });

      // 2) Slug 规范与占用
      if (!/^[a-z0-9][a-z0-9-]*$/.test(slug)) {
        warnings.push({ level: 'warning', icon: '🧭', text: `Slug「${slug}」含大写字母或特殊字符，建议只用小写字母、数字与连字符` });
      }
      const slugTaken = postsData.find((p) => p.slug === slug && !(isEditingMode && slug === editingSlug));
      if (slugTaken) {
        errors.push({ level: 'error', icon: '🚧', text: `Slug「${slug}」已被《${slugTaken.title}》占用，继续发布会覆盖该文（如需更新请使用编辑模式）` });
      }

      // 3) 摘要健康度
      if (!description) {
        warnings.push({ level: 'warning', icon: '📝', text: '缺少摘要（description）：列表页与社交分享卡片将没有预览文案' });
      } else if (description.length < 20) {
        warnings.push({ level: 'warning', icon: '📝', text: `摘要仅 ${description.length} 字符，建议扩充到 20 字以上` });
      } else if (description.length > 200) {
        warnings.push({ level: 'warning', icon: '📝', text: `摘要 ${description.length} 字符偏长，建议压缩至 200 字以内` });
      }

      // 4) 图片路径约定
      const badImages = new Set();
      const imgRe = /!\[[^\]]*\]\(\s*([^)\s]+)/g;
      let im;
      while ((im = imgRe.exec(content)) !== null) {
        const src = im[1];
        if (/^https?:\/\//.test(src) || src.startsWith('data:')) continue;
        if (!src.startsWith('../assets/images/')) badImages.add(src);
      }
      badImages.forEach((src) => {
        warnings.push({ level: 'warning', icon: '🖼️', text: `图片路径「${src}」不在 ../assets/images/ 约定目录下，构建时可能解析失败` });
      });

      // 5) 正文健康度
      if (content.length < 300) {
        warnings.push({ level: 'warning', icon: '📄', text: `正文仅 ${content.length} 字符，内容偏单薄，确认不是误发半成品？` });
      }
      if (content.length > 800 && !/^#{1,6}\s+\S/m.test(content)) {
        warnings.push({ level: 'warning', icon: '🏷️', text: '长文没有任何标题层级（#/##），建议补充分节标题提升可读性' });
      }
      if (/TODO|FIXME|待补充|待完善|占位/.test(content)) {
        warnings.push({ level: 'warning', icon: '🚧', text: '正文残留 TODO / 待补充 / 占位标记，发布前记得清理' });
      }

      // 6) 未链接标题提及（轻量补链雷达）
      const masked = maskPreflightAreas(content);
      const titleOwners = new Map();
      for (const p of postsData) {
        if (p.slug === slug || p.encrypted || p.draft) continue;
        const t = String(p.title || '').trim();
        if (t.length < 2 || /^\d+$/.test(t)) continue;
        if (titleOwners.has(t)) {
          titleOwners.set(t, null); // 同名标题存在歧义，整体弃用
        } else {
          titleOwners.set(t, p.slug);
        }
      }
      const unlinkedMentions = [];
      for (const [t, ownerSlug] of titleOwners) {
        if (!ownerSlug) continue;
        if (masked.includes(t)) unlinkedMentions.push(t);
      }
      if (unlinkedMentions.length) {
        warnings.push({
          level: 'info',
          icon: '🧲',
          text: `正文提及 ${unlinkedMentions.length} 个未建立链接的条目：${unlinkedMentions.slice(0, 5).map((t) => `《${t}》`).join('、')}${unlinkedMentions.length > 5 ? ' 等' : ''}，可前往 /wiki/ 补链雷达查看详情`,
        });
      }

      return { errors, warnings };
    }

    function renderPreflightRow(item) {
      const tone = item.level === 'error'
        ? 'border-red-500/40 bg-red-500/[0.06] text-red-600 dark:text-red-400'
        : item.level === 'info'
          ? 'border-sky-500/40 bg-sky-500/[0.06] text-sky-600 dark:text-sky-400'
          : 'border-amber-500/40 bg-amber-500/[0.06] text-amber-600 dark:text-amber-400';
      return `<li class="px-3 py-2.5 rounded-xl border ${tone} text-xs leading-relaxed">`
        + `<span class="mr-1.5">${item.icon || '•'}</span>${escapeHtml(item.text)}</li>`;
    }

    function showPreflightModal({ errors, warnings }) {
      if (!modalPreflight || !preflightList) return Promise.resolve(true);
      return new Promise((resolve) => {
        if (preflightSummary) {
          preflightSummary.innerHTML = errors.length
            ? `<span class="text-red-500 font-bold">${errors.length} 个阻断级问题</span> · <span class="text-amber-500 font-bold">${warnings.length} 条建议</span> — 仍可强制发布，但强烈建议先修复喵`
            : `未发现阻断级问题 · ${warnings.length} 条优化建议（不强制修正，确认无误即可继续）`;
        }
        preflightList.innerHTML = errors.concat(warnings).map(renderPreflightRow).join('');

        function finish(proceed) {
          modalPreflight.classList.add('hidden');
          btnPreflightCancel?.removeEventListener('click', onCancel);
          btnPreflightContinue?.removeEventListener('click', onContinue);
          resolve(proceed);
        }
        const onCancel = () => finish(false);
        const onContinue = () => finish(true);
        btnPreflightCancel?.addEventListener('click', onCancel);
        btnPreflightContinue?.addEventListener('click', onContinue);
        modalPreflight.classList.remove('hidden');
      });
    }

    // ---------- [D] 历史版本回滚 (Revision Rollback) ----------
    const modalHistory = document.getElementById('modal-history');
    const historyModalSlug = document.getElementById('history-modal-slug');
    const historyList = document.getElementById('history-list');
    const btnCloseHistory = document.getElementById('btn-close-history');
    let historyCurrentSlug = '';

    function decodeBase64Utf8(b64) {
      const binary = atob(String(b64 || '').replace(/\s+/g, ''));
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      return new TextDecoder('utf-8').decode(bytes);
    }

    async function githubApiFetch(pat, url) {
      const res = await fetch(url, {
        headers: {
          'Authorization': `Bearer ${pat}`,
          'Accept': 'application/vnd.github.v3+json',
        },
      });
      if (!res.ok) {
        let msg = `HTTP ${res.status}`;
        try { const j = await res.json(); if (j && j.message) msg = j.message; } catch (e) {}
        throw new Error(`GitHub 查询失败 (${res.status})：${msg}`);
      }
      return res.json();
    }

    async function openPostHistory(slug) {
      const pat = resolveGithubPat();
      if (!pat) {
        alert('查看历史版本需要 GitHub PAT！请先在右上角“鉴权凭据”中配置 喵！');
        modalAuth.classList.remove('hidden');
        return;
      }
      historyCurrentSlug = slug;
      if (historyModalSlug) historyModalSlug.textContent = `/posts/${slug}/`;
      if (!modalHistory || !historyList) return;
      modalHistory.classList.remove('hidden');
      historyList.innerHTML = '<li class="text-xs text-black/50 dark:text-white/50 py-6 text-center animate-pulse">正在拉取 GitHub 提交历史…</li>';
      try {
        const commits = await githubApiFetch(pat, `https://api.github.com/repos/yaoxiovo/astro/commits?path=src/content/posts/${encodeURIComponent(slug)}.md&per_page=20`);
        if (!Array.isArray(commits) || !commits.length) {
          historyList.innerHTML = '<li class="text-xs text-black/50 dark:text-white/50 py-6 text-center">该条目暂无提交历史喵？</li>';
          return;
        }
        historyList.innerHTML = commits.map((c) => {
          const raw = c.commit || {};
          const msg = escapeHtml(String((raw.message || '').split('\n')[0] || '(无提交信息)'));
          const author = escapeHtml((raw.author && raw.author.name) || 'unknown');
          const dateText = raw.author && raw.author.date ? new Date(raw.author.date).toLocaleString('zh-CN', { hour12: false }) : '';
          const sha = String(c.sha || '');
          return `<li class="flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-[var(--line-divider)]">`
            + `<div class="min-w-0">`
            + `<p class="text-xs font-medium text-black/80 dark:text-white/80 truncate" title="${msg}">${msg}</p>`
            + `<p class="text-[10px] font-mono text-black/40 dark:text-white/40 mt-0.5">${sha.slice(0, 7)} · ${author} · ${dateText}</p>`
            + `</div>`
            + `<button type="button" class="btn-revert-commit shrink-0 px-3 py-1.5 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-600 dark:text-sky-400 text-[11px] font-semibold transition-all cursor-pointer" data-sha="${sha}">回滚到此版</button>`
            + `</li>`;
        }).join('');
      } catch (err) {
        historyList.innerHTML = `<li class="text-xs text-red-500 py-6 text-center">${escapeHtml(err && err.message ? err.message : String(err))}</li>`;
      }
    }

    async function revertPostToCommit(slug, sha) {
      const pat = resolveGithubPat();
      if (!pat) {
        alert('回滚操作需要 GitHub PAT，请先在“鉴权凭据”中配置 喵！');
        return;
      }
      const confirmed = window.confirm(`⚠️ 回滚确认：\n\n将 /posts/${slug}/ 的正文恢复到提交 ${sha.slice(0, 7)} 的状态，并以一条新 Commit 写回 main 分支。\n\n当前内容不会丢失（同样保存在提交历史中），确定继续喵？`);
      if (!confirmed) return;
      try {
        const fileData = await githubApiFetch(pat, `https://api.github.com/repos/yaoxiovo/astro/contents/src/content/posts/${encodeURIComponent(slug)}.md?ref=${sha}`);
        const content = decodeBase64Utf8(fileData.content || '');
        await commitDirectToGitHub(pat, `src/content/posts/${slug}.md`, content, `revert: /posts/${slug}/ 回滚至 ${sha.slice(0, 7)} via Admin Studio`);
        const target = postsData.find((p) => p.slug === slug);
        if (target) target.body = content;
        modalHistory?.classList.add('hidden');
        alert(`回滚提交完成喵！Cloudflare Pages 正在重新构建，稍后线上即可回到 ${sha.slice(0, 7)} 版本的内容。`);
      } catch (err) {
        alert(`回滚失败：${err && err.message ? err.message : err}`);
      }
    }

    historyList?.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-revert-commit');
      if (!btn) return;
      const sha = btn.getAttribute('data-sha');
      if (sha && historyCurrentSlug) revertPostToCommit(historyCurrentSlug, sha);
    });

    // 管理列表“历史”按钮（独立事件委托，与现有操作按钮互不干扰）
    managePostsList?.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-history-post');
      if (!btn) return;
      const slug = btn.getAttribute('data-slug');
      if (slug) openPostHistory(slug);
    });

    btnCloseHistory?.addEventListener('click', () => modalHistory?.classList.add('hidden'));
    modalHistory?.addEventListener('click', (e) => {
      if (e.target === modalHistory) modalHistory.classList.add('hidden');
    });

    // ---------- [E] 条目维护状态卡 (Wiki Insight，编辑既有文章时展示) ----------
    const editingInsightCard = document.getElementById('editing-insight-card');
    const editingInsightBody = document.getElementById('editing-insight-body');
    let wikiBaselineCache = null;

    function hideEditInsight() {
      editingInsightCard?.classList.add('hidden');
    }

    async function fetchWikiBaseline() {
      if (wikiBaselineCache) return wikiBaselineCache;
      const safeJson = (url) => fetch(url).then((r) => (r.ok ? r.json() : null)).catch(() => null);
      const [maintenance, backlinks, suggestions] = await Promise.all([
        safeJson('/api/wiki/maintenance.json'),
        safeJson('/api/wiki/backlinks.json'),
        safeJson('/api/wiki/link-suggestions.json'),
      ]);
      wikiBaselineCache = { maintenance, backlinks, suggestions };
      return wikiBaselineCache;
    }

    async function loadEditInsight(slug) {
      if (!editingInsightCard || !editingInsightBody) return;
      editingInsightCard.classList.add('hidden');
      const safeJson = (url) => fetch(url).then((r) => (r.ok ? r.json() : null)).catch(() => null);
      try {
        const [baseline, quality] = await Promise.all([
          fetchWikiBaseline(),
          safeJson(`/api/wiki/quality/${encodeURIComponent(slug)}.json`),
        ]);
        // 用户可能已切换/退出编辑，防止过期数据写入
        if (!isEditingMode || editingSlug !== slug) return;
        const rows = [];

        if (quality && typeof quality.score === 'number') {
          rows.push(`📈 质量评分 <span class="font-mono font-bold text-[var(--primary)]">${quality.score}</span>/100 · ${escapeHtml(quality.gradeLabel || quality.grade || '')} <span class="opacity-50">(${escapeHtml(String(quality.checkedAt || '').slice(0, 10))})</span>`);
        }

        const m = baseline.maintenance;
        if (m) {
          const inList = (arr) => Array.isArray(arr) && arr.some((item) => item && item.slug === slug);
          const flags = [];
          if (inList(m.orphans)) flags.push('🕸️ 孤儿页（无任何入链）');
          if (inList(m.deadEnds)) flags.push('🚪 死胡同（无任何出链）');
          const staleEntry = Array.isArray(m.stale) ? m.stale.find((item) => item && item.slug === slug) : null;
          if (staleEntry) flags.push(`⏳ 长期未更新（${staleEntry.daysSinceUpdate || '?'} 天）`);
          if (inList(m.lowQuality)) flags.push('📉 低质量标记');
          if (!flags.length) flags.push('✅ 健康度良好，未命中任何维护预警');
          rows.push(`🛡️ 维护状态：${flags.join('；')}`);
        }

        const backlinks = baseline.backlinks && baseline.backlinks.backlinks ? baseline.backlinks.backlinks[slug] : null;
        if (Array.isArray(backlinks) && backlinks.length) {
          const titles = backlinks.slice(0, 3).map((b) => `《${escapeHtml(b.title || b.slug)}》`).join('、');
          rows.push(`🔗 被引用 <span class="font-mono font-bold">${backlinks.length}</span> 处：${titles}${backlinks.length > 3 ? ' 等' : ''}`);
        } else if (baseline.backlinks) {
          rows.push('🔗 暂无其他文章链接到本条目（可考虑在相关文中补链）');
        }

        const sugg = baseline.suggestions && baseline.suggestions.suggestions ? baseline.suggestions.suggestions[slug] : null;
        if (Array.isArray(sugg) && sugg.length) {
          const items = sugg.slice(0, 3).map((s) => `《${escapeHtml(s.title || s.slug)}》×${s.count}`).join('、');
          rows.push(`🧲 补链机会 <span class="font-mono font-bold">${sugg.length}</span> 项：${items}${sugg.length > 3 ? ' 等' : ''}`);
        }

        if (!rows.length) return;
        editingInsightBody.innerHTML = rows.map((r) => `<div>${r}</div>`).join('');
        editingInsightCard.classList.remove('hidden');
      } catch (err) {
        console.warn('[Admin] Wiki 洞察加载失败:', err);
      }
    }

    // 页面启动时执行门禁校验
    function runInitialGuard() {
      if (enforceAdminAuthGuard()) {
        syncAuthUI();
        restoreDraft();
      }
    }

    runInitialGuard();
    setTimeout(runInitialGuard, 100);
    setTimeout(runInitialGuard, 300);
    setTimeout(runInitialGuard, 800);
  })();
</script>

<!-- 预览渲染引擎：构建期由 Vite 打包 markdown-it，向管理台内联逻辑暴露渲染入口 -->
<script>
  import MarkdownIt from "markdown-it";

  // html: true 与线上正文渲染保持一致（正文为作者本人内容，预览仅存在于本机管理台）
  const mdPreviewEngine = new MarkdownIt({ html: true, linkify: true, breaks: false });
  window.__adminMdRender = (src) => mdPreviewEngine.render(String(src || ""));
</script>
