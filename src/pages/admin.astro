    // UTF-8 安全 Base64 编码 (兼容中文字符与 Emoji)
    function toBase64Utf8(str) {
      return btoa(encodeURIComponent(str).replace(/%([0-9A-F]{2})/g, (match, p1) => {
        return String.fromCharCode(parseInt(p1, 16));
      }));
    }

    // 客户端直接调用 GitHub REST API 提交 Commit (免 Worker BFF 依赖)
    async function commitDirectToGitHub(pat, filePath, fileContent, commitMsg) {
      const owner = 'yaoxiovo';
      const repo = 'astro';
      const branch = 'main';
      const apiUrl = `https://api.github.com/repos/${owner}/${repo}/contents/${filePath}`;

      let existingSha = undefined;
      const getRes = await fetch(`${apiUrl}?ref=${branch}`, {
        headers: {
          'Authorization': `Bearer ${pat}`,
          'Accept': 'application/vnd.github.v3+json',
        }
      });

      if (getRes.status === 401) {
        const err = new Error('GitHub PAT 鉴权未通过 (401 Bad credentials)！请检查 Token 是否有效或已过期 喵！');
        err.stage = 'GitHub Token 鉴权失败 (401)';
        throw err;
      }
      if (getRes.status === 403) {
        const errText = await getRes.text();
        const msg = errText.includes('rate limit')
          ? 'GitHub API 访问频率超限 喵！'
          : 'GitHub Token 权限不足 (403)！请确保已勾选 contents:write 或 repo 写入权限 喵！';
        const err = new Error(msg);
        err.stage = 'GitHub 权限不足 (403)';
        throw err;
      }
      if (getRes.ok) {
        try {
          const existingData = await getRes.json();
          existingSha = existingData.sha;
        } catch (e) {}
      }

      const putRes = await fetch(apiUrl, {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${pat}`,
          'Accept': 'application/vnd.github.v3+json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message: commitMsg || (existingSha ? `docs: update ${filePath} via Admin Studio` : `docs: publish ${filePath} via Admin Studio`),
          content: toBase64Utf8(fileContent),
          sha: existingSha,
          branch: branch,
        })
      });

      if (!putRes.ok) {
        const errText = await putRes.text();
        let errJson = {};
        try { errJson = JSON.parse(errText); } catch(e) {}
        const msg = errJson.message || `HTTP ${putRes.status}`;
        const err = new Error(`GitHub 提交失败 (${putRes.status}): ${msg}`);
        err.stage = `GitHub API (${putRes.status})`;
        throw err;
      }

      const putData = await putRes.json();
      return {
        commit_sha: putData.commit.sha,
        commit_url: putData.commit.html_url
      };
    }

    // 客户端直接调用 GitHub REST API 删除文件 Commit (免 Worker BFF 依赖)
    async function deleteDirectFromGitHub(pat, filePath, commitMsg) {
      const owner = 'yaoxiovo';
      const repo = 'astro';
      const branch = 'main';
      const apiUrl = `https://api.github.com/repos/${owner}/${repo}/contents/${filePath}`;

      let existingSha = null;
      const getRes = await fetch(`${apiUrl}?ref=${branch}`, {
        headers: {
          'Authorization': `Bearer ${pat}`,
          'Accept': 'application/vnd.github.v3+json',
        }
      });

      if (getRes.status === 401) {
        const err = new Error('GitHub PAT 鉴权未通过 (401 Bad credentials)！请检查 Token 是否有效或已过期 喵！');
        err.stage = 'GitHub Token 鉴权失败 (401)';
        throw err;
      }
      if (getRes.status === 403) {
        const errText = await getRes.text();
        const msg = errText.includes('rate limit')
          ? 'GitHub API 访问频率超限 喵！'
          : 'GitHub Token 权限不足 (403)！请确保已勾选 contents:write 或 repo 写入权限 喵！';
        const err = new Error(msg);
        err.stage = 'GitHub 权限不足 (403)';
        throw err;
      }
      if (!getRes.ok) {
        const err = new Error(`未找到目标文件或已被删除 (${filePath}) 喵！`);
        err.stage = '文件不存在 (404)';
        throw err;
      }

      try {
        const existingData = await getRes.json();
        existingSha = existingData.sha;
      } catch (e) {}

      if (!existingSha) {
        const err = new Error(`无法获取文件 ${filePath} 的 SHA 校验值 喵！`);
        err.stage = '获取文件 SHA 失败';
        throw err;
      }

      const delRes = await fetch(apiUrl, {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${pat}`,
          'Accept': 'application/vnd.github.v3+json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message: commitMsg || `docs(post): delete ${filePath} via Admin Studio`,
          sha: existingSha,
          branch: branch,
        })
      });

      if (!delRes.ok) {
        const errText = await delRes.text();
        let errJson = {};
        try { errJson = JSON.parse(errText); } catch(e) {}
        const msg = errJson.message || `HTTP ${delRes.status}`;
        const err = new Error(`GitHub 删除失败 (${delRes.status}): ${msg}`);
        err.stage = `GitHub API (${delRes.status})`;
        throw err;
      }

      const delData = await delRes.json();
      return {
        commit_sha: delData.commit.sha,
        commit_url: delData.commit.html_url
      };
    }

    // 8. 核心发布流程与构建监听
    async function publishPost() {
      const title = titleEl.value.trim();
      const slug = slugEl.value.trim();
      const description = descEl.value.trim();
      const content = contentEl.value.trim();
      const tags = tagsEl.value.trim();
      const category = categoryEl.value.trim();

      if (!title || !slug || !content) {
        alert('请完整填写文章标题、Slug 路径以及 Markdown 正文内容 喵！');
        return;
      }

      // 发布前质量预检（可跳过的软门禁：错误/警告列出后由作者最终确认）
      try {
        const preflight = runPreflight({ title, slug, description, content });
        if (preflight.errors.length || preflight.warnings.length) {
          const proceed = await showPreflightModal(preflight);
          if (!proceed) return;
        }
      } catch (pfErr) {
        console.warn('[Admin] Pre-flight 检查异常，已跳过:', pfErr);
      }

      const token = getAdminToken();
      if (!token) {
        alert('尚未获取到有效认证 Token！请先一键登录或在“鉴权凭据”中填入 Token 喵！');
        modalAuth.classList.remove('hidden');
        return;
      }

      const user = getAdminUser();
      if (user) {
        const rawRole = String(user.role || '').toLowerCase();
        const roles = Array.isArray(user.roles) ? user.roles.map((r) => String(r).toLowerCase()) : [];
        const isAdmin = rawRole === 'admin' || roles.includes('admin') || user.is_admin === true;
        if (!isAdmin) {
          alert('权限不足：当前登录账户由认证中心标记为【成员 (member)】，无权发布文章！发布操作仅限【管理员 (admin)】喵！');
          return;
        }
      }

      const apiBase = (localStorage.getItem(API_ENDPOINT_KEY) || 'https://zk-api.yaoxi.cloud').replace(/\/$/, '');
      let githubPat = resolveGithubPat();

      // 若未配置 PAT，且属于管理员登录态，先尝试随认证中心自动下发
      if (!githubPat && typeof window.yaoxiSyncCredentials === 'function') {
        try {
          const creds = await window.yaoxiSyncCredentials();
          if (creds && creds.github_pat) {
            githubPat = creds.github_pat;
            if (inputGithubToken) inputGithubToken.value = creds.github_pat;
          }
        } catch (e) {}
      }

      // 进入发布状态
      btnPublish.disabled = true;
      publishSpinner.classList.remove('hidden');
      publishIcon.classList.add('hidden');
      btnPublishText.textContent = isEditingMode ? '正在保存修改...' : '正在发布...';

      // 呼出部署面板
      deployPanel.classList.remove('hidden');
      deploySuccessLinks.classList.add('hidden');
      deployProgressBar.style.width = '20%';
      deployProgressBar.className = 'h-full bg-[var(--primary)] transition-all duration-500 ease-out rounded-full';
      deployTitle.textContent = isEditingMode ? '正在向 GitHub 提交文章更新 Commit...' : '正在向 GitHub 提交新文章 Commit...';
      deploySubtitle.textContent = '生成符合 Astro Content Collections 规范的 Markdown 产物';
      deployBadge.textContent = 'PUBLISHING';
      deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-blue-500/10 text-blue-500 border border-blue-500/20';
      deployStageInfo.textContent = githubPat ? '阶段: GitHub API 直连提交' : '阶段: Worker BFF 代理提交';

      deploySeconds = 0;
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        deploySeconds++;
        deployTimer.textContent = `耗时: ${deploySeconds}s`;
      }, 1000);

      try {
        let commitSha = '';
        const cleanSlug = slug.replace(/\.md$/, '').replace(/^\/+/, '');
        const postTitle = title;
        const postDate = new Date().toISOString().split('T')[0];
        const postDesc = (description || postTitle).replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, ' ').trim();
        const postCategory = (category || '技术分享').replace(/\\/g, '\\\\').replace(/"/g, '\\"').trim();

        let tagList = [];
        if (tags) {
          tagList = tags.split(/[,，]/).map(t => t.trim()).filter(Boolean);
        }
        if (tagList.length === 0) tagList = ['博客'];

        if (githubPat) {
          // 若在编辑模式下更改了 Slug，先删除旧文件以防冗余
          if (isEditingMode && editingSlug && editingSlug !== cleanSlug) {
            try {
              await deleteDirectFromGitHub(githubPat, `src/content/posts/${editingSlug}.md`, `docs(post): rename ${editingSlug} to ${cleanSlug}`);
              postsData = postsData.filter((p) => p.slug !== editingSlug);
            } catch (renameErr) {
              console.warn('[Admin] Failed to remove old slug file on rename:', renameErr);
            }
          }

          // 客户端 GitHub API 直连通道 (免 BFF 中间件)
          deployStageInfo.textContent = '阶段: GitHub API 直连提交';
          const tagsYaml = tagList.map(t => `  - ${t.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}`).join('\n');

          const markdownFile = `---
title: "${postTitle.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"
published: ${postDate}
description: "${postDesc}"
tags:
${tagsYaml}
category: "${postCategory}"
draft: false
lang: "zh_CN"
---

${content.trim()}
`;
          const commitMsg = isEditingMode
            ? `docs(post): update ${title} via Admin Studio`
            : `docs(post): publish ${title} via Admin Studio`;
          const res = await commitDirectToGitHub(githubPat, `src/content/posts/${cleanSlug}.md`, markdownFile, commitMsg);
          commitSha = res.commit_sha;
        } else {
          // Worker BFF 代理通道
          deployStageInfo.textContent = '阶段: Worker BFF 代理提交';
          const headers = {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          };
          try {
            const res = await fetch(`${apiBase}/api/publish`, {
              method: 'POST',
              headers,
              body: JSON.stringify({
                title,
                slug,
                content,
                tags,
                description: description || title,
                category: category || '技术分享',
                githubToken: undefined,
              })
            });

            if (!res.ok) {
              let errData = {};
              try {
                errData = await res.json();
              } catch (e) {
                errData = { message: `网络请求失败 (HTTP ${res.status})` };
              }
              const detailStr = errData.details
                ? (typeof errData.details === 'object' ? JSON.stringify(errData.details) : String(errData.details))
                : '';
              const fullMsg = [errData.message, detailStr].filter(Boolean).join(' - ') || `HTTP ${res.status}`;
              const customErr = new Error(fullMsg);
              customErr.stage = errData.error || `HTTP ${res.status}`;
              customErr.errData = errData;
              throw customErr;
            }

            const data = await res.json();
            commitSha = data.commit_sha;
          } catch (fetchErr) {
            if (fetchErr.name === 'TypeError' || String(fetchErr.message).includes('fetch')) {
              const err = new Error(`无法连接到 Worker BFF 网关 (${apiBase})，且尚未配置 GitHub PAT！请在右上角【鉴权凭据】中填入具备 contents:write 权限的 GitHub PAT，即可启用浏览器客户端直连提交 喵！`);
              err.stage = 'BFF 网关离线 / 未配置 PAT';
              throw err;
            }
            throw fetchErr;
          }
        }

        // 无论直连还是 BFF，成功提交后同步更新本地 postsData
        const existingIdx = postsData.findIndex((p) => p.slug === cleanSlug || (isEditingMode && p.slug === editingSlug));
        const updatedItem = {
          slug: cleanSlug,
          title: postTitle,
          published: postDate,
          category: postCategory,
          tags: tagList,
          description: postDesc,
          encrypted: false,
          draft: false,
          body: content.trim(),
        };
        if (existingIdx >= 0) {
          postsData[existingIdx] = updatedItem;
        } else {
          postsData.unshift(updatedItem);
        }
        populateCategoryFilter();
        renderManagePostsList();
        exitEditingMode();

        deployProgressBar.style.width = '40%';
        deployTitle.textContent = `GitHub 提交成功 (${commitSha.substring(0, 7)})`;
        deploySubtitle.textContent = '等待 Cloudflare Pages 启动自动化构建流水线...';
        deployBadge.textContent = 'QUEUED';
        deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-amber-500/10 text-amber-500 border border-amber-500/20';

        // 启动 3 秒轮询 GET /api/deploy-status
        pollDeployStatus(apiBase, token, commitSha, slug);

      } catch (err) {
        clearInterval(timerInterval);
        console.error('[Admin Publish Error]', err);

        deployTitle.textContent = '发布提交失败 喵！';
        deployBadge.textContent = 'ERROR';
        deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-red-500/10 text-red-500 border border-red-500/20';
        deployProgressBar.style.width = '100%';
        deployProgressBar.className = 'h-full bg-red-500 rounded-full';
        deployStageInfo.textContent = `失败原因: ${err.stage || '网络或接口异常'}`;

        const isAuthErr = String(err.message).includes('Token') ||
          String(err.message).includes('GitHub') ||
          String(err.message).includes('credentials') ||
          String(err.message).includes('401') ||
          String(err.message).includes('403') ||
          String(err.message).includes('Unauthorized') ||
          String(err.message).includes('Forbidden') ||
          String(err.message).includes('PAT');

        if (isAuthErr) {
          deploySubtitle.innerHTML = `<span class="break-all">${err.message}</span><br/><button type="button" id="btn-fix-auth-err" class="mt-2.5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-black/10 dark:bg-white/15 text-xs font-semibold text-[var(--primary)] hover:opacity-80 transition-all cursor-pointer"><span>🔐 打开【鉴权凭据】配置或更新有效 GitHub PAT</span></button>`;
          document.getElementById('btn-fix-auth-err')?.addEventListener('click', () => {
            modalAuth.classList.remove('hidden');
          });
        } else {
          deploySubtitle.textContent = err.message || '未知异常，请检查网络或控制台输出';
        }

        btnPublish.disabled = false;
        publishSpinner.classList.add('hidden');
        publishIcon.classList.remove('hidden');
        btnPublishText.textContent = '重新发布';
      }
    }

    // ============================================================
    // 8.5 文章管理列表与快捷修改删除引擎
    // ============================================================
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function populateCategoryFilter() {
      if (!manageFilterCategory) return;
      const currentVal = manageFilterCategory.value;
      const categories = Array.from(new Set(postsData.map((p) => p.category).filter(Boolean)));

      manageFilterCategory.innerHTML = '<option value="all">全部分类</option>';
      categories.forEach((cat) => {
        const opt = document.createElement('option');
        opt.value = cat;
        opt.textContent = cat;
        if (cat === currentVal) opt.selected = true;
        manageFilterCategory.appendChild(opt);
      });
    }

    function renderManagePostsList() {
      if (!managePostsList) return;

      const query = (manageSearchInput?.value || '').toLowerCase().trim();
      const selectedCategory = manageFilterCategory?.value || 'all';

      const filtered = postsData.filter((p) => {
        const matchesCat = selectedCategory === 'all' || p.category === selectedCategory;
        if (!matchesCat) return false;
        if (!query) return true;
        const inTitle = (p.title || '').toLowerCase().includes(query);
        const inSlug = (p.slug || '').toLowerCase().includes(query);
        const inDesc = (p.description || '').toLowerCase().includes(query);
        const inTags = Array.isArray(p.tags) ? p.tags.some((t) => String(t).toLowerCase().includes(query)) : false;
        return inTitle || inSlug || inDesc || inTags;
      });

      if (managePostsCount) {
        managePostsCount.textContent = `${filtered.length} 篇`;
      }

      if (filtered.length === 0) {
        managePostsList.innerHTML = '';
        if (manageEmptyState) manageEmptyState.classList.remove('hidden');
        return;
      }

      if (manageEmptyState) manageEmptyState.classList.add('hidden');

      managePostsList.innerHTML = filtered.map((post) => {
        const safeTitle = escapeHtml(post.title || post.slug);
        const safeDesc = escapeHtml(post.description || '');
        const safeCategory = escapeHtml(post.category || '技术分享');
        const safeSlug = escapeHtml(post.slug);

        return `
          <div class="p-4 rounded-2xl bg-white/60 dark:bg-black/20 border border-[var(--line-divider)] hover:border-[var(--primary)]/50 transition-all flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="min-w-0 flex-1 space-y-1.5">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-medium font-mono">${safeCategory}</span>
                ${post.published ? `<span class="text-[11px] font-mono text-black/40 dark:text-white/40">📅 ${post.published}</span>` : ''}
                <span class="text-[11px] font-mono text-black/30 dark:text-white/30 truncate max-w-[200px]" title="src/content/posts/${safeSlug}.md">📄 ${safeSlug}.md</span>
                ${post.encrypted ? `<span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-mono">🔒 加密</span>` : ''}
                ${post.draft ? `<span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-500/10 text-zinc-500 font-mono">📝 草稿</span>` : ''}
              </div>
              <div class="text-sm font-bold text-black/90 dark:text-white/90 truncate cursor-pointer hover:text-[var(--primary)] transition-colors" data-action="edit" data-slug="${safeSlug}">
                ${safeTitle}
              </div>
              ${safeDesc ? `<p class="text-xs text-black/50 dark:text-white/50 line-clamp-1">${safeDesc}</p>` : ''}
            </div>
            <div class="flex items-center gap-2 shrink-0 self-end md:self-center">
              <a href="/posts/${encodeURIComponent(post.slug)}/" target="_blank" class="px-2.5 py-1.5 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-black/10 text-xs font-medium text-black/70 dark:text-white/70 transition-all flex items-center gap-1 cursor-pointer">
                <span>🌐 查看</span>
              </a>
              <button type="button" class="btn-history-post px-3 py-1.5 rounded-xl bg-sky-500/10 hover:bg-sky-500/20 text-sky-600 dark:text-sky-400 text-xs font-semibold transition-all flex items-center gap-1 cursor-pointer" data-slug="${safeSlug}">
                <span>🕘 历史</span>
              </button>
              <button type="button" class="btn-edit-post px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-semibold transition-all flex items-center gap-1 cursor-pointer" data-slug="${safeSlug}">
                <span>✏️ 编辑</span>
              </button>
              <button type="button" class="btn-delete-post px-3 py-1.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-500 text-xs font-semibold transition-all flex items-center gap-1 cursor-pointer" data-slug="${safeSlug}" data-title="${safeTitle}">
                <span>🗑️ 删除</span>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    function loadPostToEditor(slug) {
      const cleanSlug = String(slug).replace(/\.md$/, '').replace(/^\/+/, '');
      const post = postsData.find((p) => p.slug === cleanSlug || p.slug === slug);
      if (!post) {
        alert(`未找到该文章数据 (${slug}) 喵！`);
        return;
      }

      isEditingMode = true;
      editingSlug = post.slug;
      editingOriginalTitle = post.title;

      titleEl.value = post.title || '';
      slugEl.value = post.slug || '';
      descEl.value = post.description || '';
      contentEl.value = post.body || '';
      tagsEl.value = Array.isArray(post.tags) ? post.tags.join(', ') : (post.tags || '');
      categoryEl.value = post.category || '技术分享';
      isAutoSlug = false;

      if (editingModeBanner) {
        editingModeBanner.classList.remove('hidden');
        if (editingBannerTitle) editingBannerTitle.textContent = `正在修改: ${post.title}`;
        if (editingBannerSlug) editingBannerSlug.textContent = `文件: src/content/posts/${post.slug}.md`;
      }

      setEditorMode('post');
      btnPublishText.textContent = '保存修改并部署';

      updateStats();
      updateLivePreview();
      loadEditInsight(post.slug);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function exitEditingMode() {
      isEditingMode = false;
      editingSlug = '';
      editingOriginalTitle = '';
      if (editingModeBanner) {
        editingModeBanner.classList.add('hidden');
      }
      hideEditInsight();
      btnPublishText.textContent = '发布文章并构建';
    }

    async function handleDeletePost(slug, title) {
      if (!checkUserIsAdmin(getAdminUser())) {
        alert('权限不足：当前账号不是系统管理员，已被禁止删除文章 喵！');
        enforceAdminAuthGuard();
        return;
      }

      const confirmed = window.confirm(`⚠️ 危险操作确认：\n\n确定要从 GitHub 仓库彻底删除文章《${title}》(${slug}) 吗？\n\n此操作将提交 Git Commit 并在 Cloudflare Pages 重新编译下线，不可撤销 喵！`);
      if (!confirmed) return;

      const token = getAdminToken();
      let githubPat = resolveGithubPat();
      const apiBase = (localStorage.getItem(API_ENDPOINT_KEY) || 'https://zk-api.yaoxi.cloud').replace(/\/$/, '');

      if (!githubPat && typeof window.yaoxiSyncCredentials === 'function') {
        try {
          const creds = await window.yaoxiSyncCredentials();
          if (creds && creds.github_pat) {
            githubPat = creds.github_pat;
            if (inputGithubToken) inputGithubToken.value = creds.github_pat;
          }
        } catch (e) {}
      }

      if (!githubPat && !token) {
        alert('尚未获取到有效凭据！请在右上角“鉴权凭据”中填入具备 repo/contents:write 权限的 GitHub PAT 喵！');
        modalAuth.classList.remove('hidden');
        return;
      }

      // 呼出部署面板，指示正在执行删除操作
      deployPanel.classList.remove('hidden');
      deploySuccessLinks.classList.add('hidden');
      deployProgressBar.style.width = '20%';
      deployProgressBar.className = 'h-full bg-red-500 transition-all duration-500 ease-out rounded-full';
      deployTitle.textContent = `正在从仓库彻底删除文章《${title}》...`;
      deploySubtitle.textContent = '提交 Git Commit 并通知 Cloudflare Pages 触发全站重构下线';
      deployBadge.textContent = 'DELETING';
      deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-red-500/10 text-red-500 border border-red-500/20';
      deployStageInfo.textContent = githubPat ? '阶段: GitHub API 直连删除' : '阶段: Worker BFF 代理删除';

      deploySeconds = 0;
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        deploySeconds++;
        deployTimer.textContent = `耗时: ${deploySeconds}s`;
      }, 1000);

      window.scrollTo({ top: deployPanel.offsetTop - 80, behavior: 'smooth' });

      try {
        let commitSha = '';
        const cleanSlug = String(slug).replace(/\.md$/, '').replace(/^\/+/, '');
        const filePath = `src/content/posts/${cleanSlug}.md`;
        const commitMsg = `docs(post): delete ${cleanSlug} via Admin Studio`;

        if (githubPat) {
          const res = await deleteDirectFromGitHub(githubPat, filePath, commitMsg);
          commitSha = res.commit_sha;
        } else {
          const res = await fetch(`${apiBase}/api/post/${cleanSlug}`, {
            method: 'DELETE',
            headers: {
              'Authorization': `Bearer ${token}`
            }
          });
          if (!res.ok) {
            let errData = {};
            try { errData = await res.json(); } catch(e) {}
            throw new Error(errData.message || `HTTP ${res.status}`);
          }
          const data = await res.json();
          commitSha = data.commit_sha;
        }

        // 成功删除，从本地 postsData 列表中移除该文章并刷新视图
        postsData = postsData.filter((p) => p.slug !== cleanSlug && p.slug !== slug);
        populateCategoryFilter();
        renderManagePostsList();

        // 若当前正处于编辑此文章状态，退出编辑模式
        if (isEditingMode && (editingSlug === cleanSlug || editingSlug === slug)) {
          exitEditingMode();
        }

        deployProgressBar.style.width = '40%';
        deployTitle.textContent = `文章删除 Commit 已提交 (${commitSha.substring(0, 7)})`;
        deploySubtitle.textContent = '等待 Cloudflare Pages 启动自动化构建并下线页面...';
        deployBadge.textContent = 'QUEUED';
        deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-amber-500/10 text-amber-500 border border-amber-500/20';

        // 启动轮询，targetType 传 'delete'
        pollDeployStatus(apiBase, token, commitSha, cleanSlug, 'delete');

      } catch (err) {
        clearInterval(timerInterval);
        console.error('[Admin Delete Error]', err);

        deployTitle.textContent = '删除文章失败 喵！';
        deployBadge.textContent = 'ERROR';
        deployBadge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-red-500/10 text-red-500 border border-red-500/20';
        deployProgressBar.style.width = '100%';
        deployProgressBar.className = 'h-full bg-red-500 rounded-full';
        deployStageInfo.textContent = `失败原因: ${err.stage || '接口响应异常'}`;
        deploySubtitle.textContent = err.message || '未知异常，请检查网络或控制台输出';
      }
    }

    async function syncFromGitHub() {
      let githubPat = resolveGithubPat();

      // 若尚未获取到 PAT，且支持统一认证中心下发，先尝试静默下发拉取
      if (!githubPat && typeof window.yaoxiSyncCredentials === 'function') {
        try {
          const creds = await window.yaoxiSyncCredentials();
          if (creds && creds.github_pat) {
            githubPat = creds.github_pat;
            if (inputGithubToken) inputGithubToken.value = creds.github_pat;
          }
        } catch (e) {}
      }

      if (btnSyncGithubPosts) btnSyncGithubPosts.disabled = true;
      if (syncSpinner) syncSpinner.classList.remove('hidden');
      if (syncIcon) syncIcon.classList.add('hidden');
      if (syncText) syncText.textContent = '同步中...';

      try {
        const owner = 'yaoxiovo';
        const repo = 'astro';
        const branch = 'main';
        const apiUrl = `https://api.github.com/repos/${owner}/${repo}/contents/src/content/posts?ref=${branch}&_t=${Date.now()}`;

        const reqHeaders = {
          'Accept': 'application/vnd.github.v3+json',
        };
        if (githubPat) {
          reqHeaders['Authorization'] = `Bearer ${githubPat}`;
        }

        const res = await fetch(apiUrl, {
          headers: reqHeaders
        });

        if (!res.ok) {
          if (res.status === 403) {
            throw new Error('GitHub API 调用速率受限 (Rate Limit)。请检查统一认证中心是否已下发有效 PAT 喵！');
          }
          throw new Error(`GitHub API 响应失败 (${res.status})`);
        }

        const files = await res.json();
        if (!Array.isArray(files)) {
          throw new Error('返回的仓库文件列表数据格式无效');
        }

        const mdFiles = files.filter((f) => f.name.endsWith('.md'));
        const postMap = new Map(postsData.map((p) => [p.slug, p]));

        // 识别新发现的远程文件并拉取元数据
        const newFiles = mdFiles.filter((f) => {
          const slug = f.name.replace(/\.md$/, '');
          return !postMap.has(slug);
        });

        for (const f of newFiles) {
          const slug = f.name.replace(/\.md$/, '');
          try {
            const rawRes = await fetch(f.download_url || `https://raw.githubusercontent.com/${owner}/${repo}/${branch}/${f.path}`);
            if (rawRes.ok) {
              const rawText = await rawRes.text();
              const fmMatch = rawText.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/);
              let meta = {};
              let body = rawText;
              if (fmMatch) {
                const fm = fmMatch[1];
                body = fmMatch[2];
                const titleM = fm.match(/title:\s*["']?([^"\n\r]+)["']?/);
                const dateM = fm.match(/published:\s*["']?([^"\n\r]+)["']?/);
                const descM = fm.match(/description:\s*["']?([^"\n\r]+)["']?/);
                const catM = fm.match(/category:\s*["']?([^"\n\r]+)["']?/);
                meta.title = titleM ? titleM[1].trim() : slug;
                meta.published = dateM ? dateM[1].trim() : '';
                meta.description = descM ? descM[1].trim() : '';
                meta.category = catM ? catM[1].trim() : '技术分享';
              }
              postMap.set(slug, {
                slug,
                title: meta.title || slug,
                published: meta.published || '',
                description: meta.description || '',
                category: meta.category || '技术分享',
                tags: [],
                body: body || '',
              });
            }
          } catch (fetchFileErr) {
            console.warn(`[Sync] 获取文章 ${slug} 详情失败:`, fetchFileErr);
          }
        }

        // 过滤掉已经在 GitHub 仓库中被删除的文章
        const remoteSlugs = new Set(mdFiles.map((f) => f.name.replace(/\.md$/, '')));
        postsData = Array.from(postMap.values()).filter((p) => remoteSlugs.has(p.slug));
        postsData.sort((a, b) => (b.published || '').localeCompare(a.published || ''));

        populateCategoryFilter();
        renderManagePostsList();

      } catch (err) {
        console.error('[Sync Error]', err);
        alert(`同步 GitHub 仓库失败: ${err.message || '网络异常'} 喵！`);
      } finally {
        if (btnSyncGithubPosts) btnSyncGithubPosts.disabled = false;
        if (syncSpinner) syncSpinner.classList.add('hidden');
        if (syncIcon) syncIcon.classList.remove('hidden');
        if (syncText) syncText.textContent = '实时同步仓库';
      }
    }

