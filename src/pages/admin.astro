---
import Layout from "@layouts/Layout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { umamiConfig } from "../config";

const allPosts = await getSortedPosts();
const initialPosts = allPosts.map((p) => ({
  slug: p.id.replace(/\.[^/.]+$/, ""),
  title: p.data.title,
  published: p.data.published ? new Date(p.data.published).toISOString().split('T')[0] : '',
  category: p.data.category || '技术分享',
  tags: p.data.tags || [],
  description: p.data.description || '',
  encrypted: Boolean(p.data.encrypted),
  draft: Boolean(p.data.draft),
  body: p.body || '',
}));
const safeInitialPostsJson = JSON.stringify(initialPosts).replace(/<\/script>/gi, '<\\/script>');
---

<Layout title="文章发布与部署控制台 | 瑶曦博客" description="开箱即用的 Astro 博客便捷发布后台与实时部署监听系统" noindex={true}>
  <!-- 🛡️ 管理后台安全访问守卫 (Admin Authentication & Role Guard) -->
  <div id="admin-guard-container" class="min-h-[75vh] flex items-center justify-center py-12 px-4 sm:px-6 max-w-lg mx-auto transition-all duration-300">
    
    <!-- 状态 1: 正在校验管理权限 -->
    <div id="guard-state-checking" class="w-full p-8 rounded-3xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)] shadow-xl backdrop-blur-xl text-center animate-fade-in">
      <div class="inline-flex p-3 rounded-2xl bg-[var(--primary)]/10 text-[var(--primary)] mb-4 animate-pulse">
        <svg class="animate-spin h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-bold text-black/90 dark:text-white/90 mb-2">
        正在校验管理权限 喵...
      </h3>
      <p class="text-xs text-black/50 dark:text-white/50 leading-relaxed font-mono">
        正在核验统一身份认证中心 (accounts.yaoxi.cloud) 下发的身份凭据与权限...
      </p>
    </div>

    <!-- 状态 2: 检测到未登录，正在跳转至登录页 -->
    <div id="guard-state-redirecting" class="hidden w-full p-8 rounded-3xl bg-black/5 dark:bg-white/5 border border-amber-500/20 shadow-xl backdrop-blur-xl text-center animate-fade-in">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center ring-8 ring-amber-500/5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
        </svg>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 text-amber-500 font-mono text-xs font-bold uppercase mb-3">
        Redirecting · 未检测到登录
      </div>
      <h3 class="text-lg sm:text-xl font-bold text-black/90 dark:text-white/90 mb-2">
        检测到未登录，正在跳转 喵！
      </h3>
      <p class="text-xs sm:text-sm text-black/60 dark:text-white/60 mb-6 leading-relaxed">
        本后台仅限管理员访问。即将自动跳转至 <strong>耀西统一身份认证中心 (accounts.yaoxi.cloud)</strong> 完成登录喵呜~
      </p>
      <a id="btn-manual-login" href="https://accounts.yaoxi.cloud" class="w-full py-2.5 px-4 rounded-xl bg-[var(--primary)] text-white dark:text-black font-semibold text-xs shadow-md hover:opacity-90 active:scale-95 transition-all flex items-center justify-center gap-2">
        <span>🔑 若未自动跳转，点击此处手动前往登录 喵</span>
      </a>
    </div>

    <!-- 状态 3: 检测到已登录但不是管理员权限，直接安全拦截 (403 Forbidden) -->
    <div id="guard-state-forbidden" class="hidden w-full p-8 rounded-3xl bg-black/5 dark:bg-white/5 border border-red-500/20 shadow-2xl backdrop-blur-xl text-center animate-fade-in">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-red-500/10 text-red-500 flex items-center justify-center ring-8 ring-red-500/5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H10m11-3.5a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-500/10 text-red-500 font-mono text-xs font-bold uppercase mb-3">
        403 Forbidden · 权限不足
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-black/90 dark:text-white/90 mb-2">
        访问已被安全拦截 喵！
      </h2>
      <p class="text-xs sm:text-sm text-black/60 dark:text-white/60 mb-6 leading-relaxed">
        本后台仅对系统<strong>【管理员 (admin)】</strong>开放喵！统一身份认证中心下发的信息确认你当前仅拥有<strong>【成员 (member)】</strong>权限，已被安全网关直接拦截喵呜~！
      </p>
      
      <!-- 当前登录身份信息卡片 -->
      <div class="p-4 rounded-2xl bg-black/5 dark:bg-white/10 text-left mb-6 text-xs space-y-2.5 font-mono border border-[var(--line-divider)]">
        <div class="flex justify-between items-center text-black/60 dark:text-white/60">
          <span>登录账号:</span>
          <span id="forbidden-user-name" class="font-bold text-black/90 dark:text-white/90"></span>
        </div>
        <div class="flex justify-between items-center text-black/60 dark:text-white/60">
          <span>账号 UID:</span>
          <span id="forbidden-user-uid" class="text-black/80 dark:text-white/80"></span>
        </div>
        <div class="flex justify-between items-center text-black/60 dark:text-white/60">
          <span>下发角色:</span>
          <span id="forbidden-user-role" class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-500 font-bold">成员 (member)</span>
        </div>
        <div class="flex justify-between items-center text-black/60 dark:text-white/60">
          <span>所需角色:</span>
          <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">系统管理员 (admin)</span>
        </div>
      </div>

      <!-- 操作按钮群 -->
      <div class="flex flex-col gap-2.5">
        <button type="button" id="btn-forbidden-switch" class="w-full py-2.5 px-4 rounded-xl bg-[var(--primary)] text-white dark:text-black font-semibold text-xs shadow-md hover:opacity-90 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <span>🔄 切换管理员账号登录 喵</span>
        </button>
        <div class="flex items-center gap-2.5">
          <a href="/" class="flex-1 py-2.5 px-4 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/15 text-xs font-medium text-black/80 dark:text-white/80 transition-all flex items-center justify-center gap-1.5">
            <span>🏠 返回主站</span>
          </a>
          <button type="button" id="btn-forbidden-logout" class="py-2.5 px-4 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-500 text-xs font-medium transition-all flex items-center justify-center gap-1.5 cursor-pointer">
            <span>🚪 退出登录</span>
          </button>
        </div>
      </div>
    </div>

  </div>

  <div id="admin-studio-root" style="display: none;" class="min-h-screen py-8 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto" data-umami-base={umamiConfig.baseUrl} data-umami-share={umamiConfig.shareId}>
    
    <!-- 顶部状态栏 -->
    <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-6 mb-8 border-b border-[var(--line-divider)] gap-4">
      <div>
        <div class="flex items-center gap-3">
          <a href="/" class="p-2 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/15 transition-all text-sm font-medium flex items-center gap-1.5" title="返回主站">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>主站</span>
          </a>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-black/90 dark:text-white/90">
            便捷发布后台 <span class="text-xs px-2.5 py-1 rounded-full bg-[var(--primary)] text-white dark:text-black font-semibold ml-1">Studio</span>
          </h1>
        </div>
        <p class="text-xs sm:text-sm text-black/50 dark:text-white/50 mt-1">
          支持实时草稿暂存 · <kbd class="px-1.5 py-0.5 rounded bg-black/10 dark:bg-white/15 text-[11px] font-mono">Ctrl+S</kbd> / <kbd class="px-1.5 py-0.5 rounded bg-black/10 dark:bg-white/15 text-[11px] font-mono">Cmd+S</kbd> 极速发布 · 自动化监听 Cloudflare 构建
        </p>
      </div>

      <!-- 右侧操作区：草稿状态、Token 鉴权设置、发布主按钮 -->
      <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
        <div id="draft-status" class="hidden text-xs text-black/40 dark:text-white/40 items-center gap-1.5 font-mono">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="draft-time-text">草稿已保存</span>
        </div>

        <button id="btn-auth-config" class="px-3 py-2 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/15 text-xs font-medium flex items-center gap-1.5 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
          <span id="auth-status-text">鉴权凭据</span>
        </button>

        <button id="btn-publish" class="px-5 py-2.5 rounded-xl bg-[var(--primary)] hover:opacity-90 active:scale-95 text-white dark:text-black font-semibold text-sm shadow-md shadow-[var(--primary)]/20 transition-all flex items-center gap-2">
          <svg id="publish-spinner" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <svg id="publish-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span id="btn-publish-text">发布并构建</span>
        </button>
      </div>
    </header>

    <!-- 部署构建实时进度条看板 (隐藏状态，发布后呼出) -->
    <div id="deploy-panel" class="hidden mb-8 p-6 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)] shadow-lg backdrop-blur-md transition-all">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <div id="deploy-state-indicator" class="h-3 w-3 rounded-full bg-amber-500 animate-ping"></div>
          <div>
            <h3 class="text-base font-bold text-black/90 dark:text-white/90" id="deploy-title">正在向 GitHub 提交文章 Commit...</h3>
            <p class="text-xs text-black/50 dark:text-white/50 font-mono" id="deploy-subtitle">等待 Cloudflare Pages 捕获 Webhook</p>
          </div>
        </div>
        <div id="deploy-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-amber-500/10 text-amber-500 border border-amber-500/20">
          QUEUED
        </div>
      </div>

      <!-- 动态进度条 -->
      <div class="w-full bg-black/10 dark:bg-white/10 h-2.5 rounded-full overflow-hidden mb-3">
        <div id="deploy-progress-bar" class="h-full bg-[var(--primary)] transition-all duration-500 ease-out rounded-full" style="width: 15%;"></div>
      </div>

      <div class="flex items-center justify-between text-xs text-black/40 dark:text-white/40 font-mono">
        <span id="deploy-stage-info">阶段: 初始化</span>
        <span id="deploy-timer">耗时: 0s</span>
      </div>

      <!-- 发布成功后的跳转链接容器 -->
      <div id="deploy-success-links" class="hidden mt-4 pt-4 border-t border-[var(--line-divider)] flex flex-wrap items-center gap-3">
        <a id="link-live-post" href="#" target="_blank" class="px-4 py-2 rounded-xl bg-emerald-500 text-white font-medium text-xs flex items-center gap-1.5 shadow-sm hover:opacity-90">
          <span>在新标签页阅读新文章</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a id="link-preview-url" href="#" target="_blank" class="px-4 py-2 rounded-xl bg-black/5 dark:bg-white/10 text-xs font-mono hover:bg-black/10 dark:hover:bg-white/15">
          Pages 预览节点
        </a>
        <button id="btn-continue-writing" class="px-4 py-2 rounded-xl bg-black/5 dark:bg-white/10 text-xs font-medium hover:bg-black/10 ml-auto">
          再写一篇新文章
        </button>
      </div>
    </div>

    <!-- 静态嵌入本地文章预加载数据 -->
    <script id="initial-posts-data" type="application/json" set:html={safeInitialPostsJson}></script>

    <!-- 顶部工作台模式切换 Tab -->
    <div class="flex items-center gap-2 p-1.5 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)] w-fit mb-6 flex-wrap">
      <button type="button" id="tab-mode-post" class="px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-[var(--primary)] text-white dark:text-black shadow-sm flex items-center gap-1.5 cursor-pointer">
        <span>📝 撰写长文 (Blog Post)</span>
      </button>
      <button type="button" id="tab-mode-manage" class="px-4 py-2 rounded-xl text-xs font-medium text-black/60 dark:text-white/60 hover:text-black dark:hover:text-white transition-all flex items-center gap-1.5 cursor-pointer">
        <span>🗂️ 文章管理与修改 (Articles)</span>
      </button>
      <button type="button" id="tab-mode-moment" class="px-4 py-2 rounded-xl text-xs font-medium text-black/60 dark:text-white/60 hover:text-black dark:hover:text-white transition-all flex items-center gap-1.5 cursor-pointer">
        <span>💬 发朋友圈 / 胶囊 (Moment & Capsule)</span>
      </button>
      <button type="button" id="tab-mode-analytics" class="px-4 py-2 rounded-xl text-xs font-medium text-black/60 dark:text-white/60 hover:text-black dark:hover:text-white transition-all flex items-center gap-1.5 cursor-pointer">
        <span>📊 流量大盘 (Live Analytics)</span>
      </button>
    </div>

    <!-- 编辑模式指示横幅 (默认隐藏) -->
    <div id="editing-mode-banner" class="hidden mb-5 p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-between gap-4 animate-fade-in">
      <div class="flex items-center gap-3 min-w-0">
        <div class="p-2 rounded-xl bg-amber-500/20 text-amber-500 font-bold text-xs shrink-0">✏️ 编辑模式</div>
        <div class="min-w-0">
          <div class="text-xs font-bold text-black/90 dark:text-white/90 truncate" id="editing-banner-title">正在修改: 标题</div>
          <div class="text-[11px] font-mono text-black/50 dark:text-white/50" id="editing-banner-slug">文件: src/content/posts/...</div>
        </div>
      </div>
      <button type="button" id="btn-cancel-editing" class="shrink-0 px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-red-500/10 hover:text-red-500 text-xs font-medium transition-all cursor-pointer">
        ✕ 退出编辑 (新建文章)
      </button>
    </div>

    <!-- 1. 长文博文编辑区域 -->
    <div id="panel-post-editor" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- 左侧：文章元信息配置 (1 列) -->
      <div class="lg:col-span-1 space-y-5">
        <div class="p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)]">
          <h2 class="text-sm font-bold uppercase tracking-wider text-black/60 dark:text-white/60 mb-4 flex items-center justify-between">
            <span>文章元数据 (Frontmatter)</span>
            <button id="btn-clear-draft" class="text-xs text-red-500/80 hover:text-red-500 transition-colors lowercase" title="清空全部输入与本地草稿">清空草稿</button>
          </h2>

          <div class="space-y-4">
            <!-- 标题输入 -->
            <div>
              <label for="post-title" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1.5">文章标题 (Title) *</label>
              <input type="text" id="post-title" placeholder="输入引人注目的标题..." class="w-full px-3.5 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] focus:bg-white dark:focus:bg-black/40 text-sm outline-none transition-all" />
            </div>

            <!-- Slug 输入 -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="post-slug" class="block text-xs font-medium text-black/70 dark:text-white/70">唯一 Slug (URL 路径) *</label>
                <button type="button" id="btn-toggle-auto-slug" class="text-[11px] text-[var(--primary)] hover:underline">自动同步标题</button>
              </div>
              <div class="relative">
                <input type="text" id="post-slug" placeholder="my-awesome-article" class="w-full px-3.5 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] focus:bg-white dark:focus:bg-black/40 text-sm font-mono outline-none transition-all pr-8" />
                <span class="absolute right-3 top-3 text-xs text-black/30 dark:text-white/30 font-mono">.md</span>
              </div>
            </div>

            <!-- 标签 -->
            <div>
              <label for="post-tags" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1.5">标签 (Tags，逗号分隔)</label>
              <input type="text" id="post-tags" placeholder="Astro, Cloudflare, 架构设计" class="w-full px-3.5 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] focus:bg-white dark:focus:bg-black/40 text-sm outline-none transition-all" />
            </div>

            <!-- 分类 -->
            <div>
              <label for="post-category" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1.5">所属分类 (Category)</label>
              <input type="text" id="post-category" placeholder="技术分享" value="技术分享" class="w-full px-3.5 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] focus:bg-white dark:focus:bg-black/40 text-sm outline-none transition-all" />
            </div>

            <!-- 摘要 (Description) -->
            <div>
              <label for="post-desc" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1.5">摘要说明 (Description) *</label>
              <textarea id="post-desc" rows="3" placeholder="简要描述本文核心内容，将展示在列表卡片与 SEO 元信息中..." class="w-full px-3.5 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] focus:bg-white dark:focus:bg-black/40 text-sm outline-none transition-all resize-none"></textarea>
            </div>
          </div>
        </div>

        <!-- 统计面板卡片 -->
        <div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)] flex items-center justify-around text-center text-xs">
          <div>
            <div class="text-base font-bold font-mono text-[var(--primary)]" id="stat-words">0</div>
            <div class="text-black/40 dark:text-white/40">正文字数</div>
          </div>
          <div class="h-6 w-[1px] bg-[var(--line-divider)]"></div>
          <div>
            <div class="text-base font-bold font-mono text-black/80 dark:text-white/80" id="stat-minutes">0</div>
            <div class="text-black/40 dark:text-white/40">预计阅读 (分)</div>
          </div>
          <div class="h-6 w-[1px] bg-[var(--line-divider)]"></div>
          <div>
            <div class="text-base font-bold font-mono text-emerald-500" id="stat-lines">0</div>
            <div class="text-black/40 dark:text-white/40">文本行数</div>
          </div>
        </div>

        <!-- 条目维护状态卡 (编辑既有文章时加载 wiki 数据) -->
        <div id="editing-insight-card" class="hidden p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)] text-xs">
          <div class="font-bold text-black/75 dark:text-white/75 mb-2.5 flex items-center gap-1.5">
            <span>📊</span>
            <span>条目维护状态 (Wiki Insight)</span>
          </div>
          <div id="editing-insight-body" class="space-y-1 text-black/55 dark:text-white/55 leading-relaxed"></div>
        </div>
      </div>

      <!-- 右侧：宽屏 Markdown 编辑器 (2 列) -->
      <div class="lg:col-span-2 flex flex-col">
        <div class="flex-1 flex flex-col rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)] overflow-hidden">
          
          <!-- 快捷工具栏 -->
          <div class="flex items-center flex-wrap gap-1 px-3 py-2 bg-black/5 dark:bg-white/5 border-b border-[var(--line-divider)] text-xs">
            <button type="button" class="toolbar-btn" data-syntax="**" title="粗体 (Ctrl+B)">粗体</button>
            <button type="button" class="toolbar-btn" data-syntax="*" title="斜体 (Ctrl+I)">斜体</button>
            <button type="button" class="toolbar-btn" data-prefix="## " title="二级标题">H2</button>
            <button type="button" class="toolbar-btn" data-prefix="### " title="三级标题">H3</button>
            <div class="h-4 w-[1px] bg-[var(--line-divider)] mx-1"></div>
            <button type="button" class="toolbar-btn" data-syntax="`" title="行内代码">代码</button>
            <button type="button" class="toolbar-btn" data-wrap="```\n" data-wrap-end="\n```" title="多行代码块">代码块</button>
            <button type="button" class="toolbar-btn" data-prefix="> " title="引用块">引用</button>
            <button type="button" class="toolbar-btn" data-prefix="- " title="无序列表">列表</button>
            <button type="button" class="toolbar-btn" data-wrap="[标题](" data-wrap-end=")" title="链接">链接</button>
            <button type="button" class="toolbar-btn" data-wrap="![" data-wrap-end="](url)" title="图片">图片</button>
            <button type="button" class="toolbar-btn" data-insert="\n---\n" title="水平分割线">分割线</button>
            <div class="h-4 w-[1px] bg-[var(--line-divider)] mx-1"></div>
            <button type="button" id="btn-upload-image" class="toolbar-btn" title="上传图片 (相册/拍照/粘贴，直传 GitHub)">📷 上传图</button>
            <button type="button" id="btn-toggle-preview" class="toolbar-btn" title="切换 编辑 / 预览">👁 预览</button>
          </div>

          <!-- 正文编辑区 -->
          <textarea id="post-content" rows="22" placeholder="# 在此开始书写正文...\n\n支持标准的 GitHub Flavored Markdown 语法，随时输入即时自动保存草稿..." class="w-full flex-1 p-5 bg-transparent text-sm font-mono outline-none leading-relaxed resize-y min-h-[500px]"></textarea>

          <!-- Markdown 实时预览渲染容器 (与编辑区互斥切换) -->
          <div id="post-preview" class="hidden w-full flex-1 p-5 overflow-y-auto min-h-[500px] text-sm text-black/85 dark:text-white/85 leading-relaxed"></div>

          <!-- 图片上传隐藏文件选择器 -->
          <input type="file" id="image-upload-input" accept="image/*" class="hidden" />
        </div>
      </div>
    </div>

    <!-- 1.5 文章管理面板 (列表、修改、删除) -->
    <div id="panel-post-manage" class="hidden space-y-5 animate-fade-in">
      <div class="p-6 rounded-3xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)]">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-black/90 dark:text-white/90 flex items-center gap-2">
              <span>🗂️ 博客文章管理</span>
              <span id="manage-posts-count" class="text-xs px-2.5 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-mono font-bold">0 篇</span>
            </h2>
            <p class="text-xs text-black/50 dark:text-white/50 mt-1">
              支持一键装载现有文章进编辑器进行修改更新，或从 GitHub 仓库彻底删除文章并触发自动化重新编译上线 喵！
            </p>
          </div>
          <div class="flex items-center gap-2 w-full sm:w-auto flex-wrap">
            <button type="button" id="btn-sync-github-posts" class="px-3.5 py-2 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-black/10 text-xs font-medium flex items-center gap-1.5 transition-all cursor-pointer">
              <span id="sync-spinner" class="hidden animate-spin">⏳</span>
              <span id="sync-icon">🔄</span>
              <span id="sync-text">实时同步仓库</span>
            </button>
            <button type="button" id="btn-manage-new-post" class="px-3.5 py-2 rounded-xl bg-[var(--primary)] text-white dark:text-black text-xs font-semibold shadow-sm hover:opacity-90 flex items-center gap-1.5 transition-all cursor-pointer">
              <span>✍️ 撰写新文章</span>
            </button>
          </div>
        </div>

        <!-- 搜索与筛选工具条 -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-5">
          <div class="relative flex-1">
            <input type="text" id="manage-search-input" placeholder="按文章标题、Slug 或标签快速搜索..." class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] text-xs outline-none transition-all" />
            <span class="absolute left-3 top-2.5 text-black/30 dark:text-white/30 text-xs">🔍</span>
          </div>
          <select id="manage-filter-category" class="px-3 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] text-xs outline-none cursor-pointer">
            <option value="all">全部分类</option>
          </select>
        </div>

        <!-- 文章列表容器 -->
        <div id="manage-posts-list" class="space-y-3">
          <!-- 动态渲染文章卡片 -->
        </div>

        <!-- 空态提示 -->
        <div id="manage-empty-state" class="hidden py-12 text-center text-xs text-black/40 dark:text-white/40 font-mono">
          没有找到匹配的文章 喵~
        </div>
      </div>
    </div>

    <!-- 2. 朋友圈 / 时间胶囊专属编辑区域 (默认隐藏) -->
    <div id="panel-moment-editor" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- 左侧：动态参数设置 (1 列) -->
      <div class="lg:col-span-1 space-y-5">
        <div class="p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)]">
          <h2 class="text-sm font-bold uppercase tracking-wider text-black/60 dark:text-white/60 mb-4 flex items-center justify-between">
            <span>动态属性 (Moment Params)</span>
            <button id="btn-clear-moment" class="text-xs text-red-500/80 hover:text-red-500 transition-colors lowercase" title="清空动态内容">清空输入</button>
          </h2>

          <div class="space-y-4">
            <!-- 动态 Slug -->
            <div>
              <label for="moment-slug" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1.5">动态 Slug (可选，留空按时间自动生成)</label>
              <div class="relative">
                <input type="text" id="moment-slug" placeholder="如 moment-spring-walk" class="w-full px-3.5 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] focus:bg-white dark:focus:bg-black/40 text-sm font-mono outline-none transition-all pr-8" />
                <span class="absolute right-3 top-3 text-xs text-black/30 dark:text-white/30 font-mono">.md</span>
              </div>
            </div>

            <!-- 署名与发布来源 -->
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="moment-author" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1.5">作者署名</label>
                <input type="text" id="moment-author" value="瑶曦" class="w-full px-3 py-2 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] text-xs outline-none" />
              </div>
              <div>
                <label for="moment-source" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1.5">发布设备/来源</label>
                <input type="text" id="moment-source" value="Astro Web Studio" class="w-full px-3 py-2 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] text-xs outline-none" />
              </div>
            </div>

            <!-- 时间胶囊开关与解封日期 -->
            <div class="p-3.5 rounded-xl bg-purple-500/10 border border-purple-500/20">
              <label class="flex items-center justify-between cursor-pointer">
                <span class="text-xs font-semibold text-purple-700 dark:text-purple-300 flex items-center gap-1.5">
                  <span>⏳ 设为时间胶囊 (Time Capsule)</span>
                </span>
                <input type="checkbox" id="moment-is-capsule" class="h-4 w-4 rounded accent-purple-600 cursor-pointer" />
              </label>
              <div id="moment-capsule-date-container" class="hidden mt-2.5 pt-2.5 border-t border-purple-500/20">
                <label for="moment-capsule-date" class="block text-[11px] text-purple-600/80 dark:text-purple-300/80 mb-1 font-medium">解封时间 (到期前正文将自动封存掩码保护)</label>
                <input type="datetime-local" id="moment-capsule-date" class="w-full px-2.5 py-1.5 rounded-lg bg-white/80 dark:bg-black/40 border border-purple-500/30 text-xs outline-none" />
              </div>
            </div>

            <!-- 置顶动态与被回复动态 -->
            <div class="space-y-3">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="moment-pinned" class="rounded accent-[var(--primary)]" />
                <span class="text-xs font-medium text-black/70 dark:text-white/70">置顶此条动态 📌</span>
              </label>
              <div>
                <label for="moment-reply-to" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1">关联回复 Slug (可选)</label>
                <input type="text" id="moment-reply-to" placeholder="如 cfworker（留空为独立说说）" class="w-full px-3 py-2 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] text-xs font-mono outline-none" />
              </div>
            </div>

            <!-- 附带图片列表 -->
            <div>
              <label for="moment-images" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1">附带图片 (每行一个直链或 10.jpg 文件名)</label>
              <textarea id="moment-images" rows="3" placeholder="https://png.yaoxi.wiki/...&#10;或纯文件名 10.jpg (系统自动按日期拼接 CDN)" class="w-full px-3 py-2 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] text-xs font-mono outline-none resize-none"></textarea>
            </div>

            <!-- 附带视频 -->
            <div>
              <label for="moment-videos" class="block text-xs font-medium text-black/70 dark:text-white/70 mb-1">附带视频直链/文件名 (可选)</label>
              <input type="text" id="moment-videos" placeholder="如 1.mp4 或完整 mp4 链接" class="w-full px-3 py-2 rounded-xl bg-black/5 dark:bg-white/10 border border-transparent focus:border-[var(--primary)] text-xs font-mono outline-none" />
            </div>
          </div>
        </div>
      </div>

      <!-- 右侧：动态正文输入与实时卡片预览 (2 列) -->
      <div class="lg:col-span-2 flex flex-col space-y-5">
        <div class="rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)] p-5">
          <!-- 快捷标签推荐 -->
          <div class="flex items-center gap-2 mb-3 overflow-x-auto pb-1">
            <span class="text-xs text-black/40 dark:text-white/40 font-medium shrink-0">快捷话题:</span>
            <button type="button" class="btn-quick-tag px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/10 text-xs hover:bg-[var(--primary)] hover:text-white transition-all cursor-pointer" data-tag="#日常">#日常</button>
            <button type="button" class="btn-quick-tag px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/10 text-xs hover:bg-[var(--primary)] hover:text-white transition-all cursor-pointer" data-tag="#开发日志">#开发日志</button>
            <button type="button" class="btn-quick-tag px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/10 text-xs hover:bg-[var(--primary)] hover:text-white transition-all cursor-pointer" data-tag="#Astro">#Astro</button>
            <button type="button" class="btn-quick-tag px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/10 text-xs hover:bg-[var(--primary)] hover:text-white transition-all cursor-pointer" data-tag="#心情">#心情</button>
            <button type="button" class="btn-quick-tag px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/10 text-xs hover:bg-[var(--primary)] hover:text-white transition-all cursor-pointer" data-tag="#随想">#随想</button>
            <button type="button" class="btn-quick-tag px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/10 text-xs hover:bg-[var(--primary)] hover:text-white transition-all cursor-pointer" data-tag="#技术备忘">#技术备忘</button>
          </div>

          <label for="moment-content" class="block text-xs font-semibold text-black/70 dark:text-white/70 mb-2">说说内容 (支持 Markdown 与 #话题 喵) *</label>
          <textarea id="moment-content" rows="6" placeholder="分享当下的灵感与心情... 支持输入 #标签 自动归档，支持 Markdown 语法..." class="w-full p-4 rounded-xl bg-white dark:bg-black/40 border border-[var(--line-divider)] text-sm font-sans outline-none focus:border-[var(--primary)] leading-relaxed resize-y"></textarea>
        </div>

        <!-- 实时卡片模拟预览 -->
        <div class="rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)] p-5">
          <div class="text-xs font-bold text-black/50 dark:text-white/50 uppercase tracking-wider mb-3 flex items-center justify-between">
            <span>朋友圈卡片实时预览 (Live Card Preview)</span>
            <span id="preview-capsule-badge" class="hidden px-2 py-0.5 rounded text-[10px] bg-purple-500/10 text-purple-600 dark:text-purple-400 font-medium">时间胶囊封存中</span>
          </div>
          <div class="p-4 rounded-xl bg-white/70 dark:bg-neutral-900/80 border border-[var(--line-divider)] shadow-sm">
            <div class="flex items-center gap-3 mb-2.5">
              <div class="h-9 w-9 rounded-full bg-[var(--primary)]/20 text-[var(--primary)] flex items-center justify-center font-bold text-sm">瑶</div>
              <div>
                <div class="text-xs font-bold text-black/90 dark:text-white/90 flex items-center gap-1.5">
                  <span id="preview-moment-author">瑶曦</span>
                  <span class="px-1.5 py-0.5 rounded text-[10px] bg-amber-500/10 text-amber-500">博主认证</span>
                </div>
                <div class="text-[10px] text-black/40 dark:text-white/40 font-mono" id="preview-moment-time">刚刚 · Astro Web Studio</div>
              </div>
            </div>
            <div class="text-xs text-black/80 dark:text-white/80 leading-relaxed whitespace-pre-wrap font-sans" id="preview-moment-text">等待输入动态内容...</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Umami 实时流量与访问分析大盘 (默认隐藏) -->
    <div id="panel-analytics" class="hidden space-y-6">
      <!-- 顶部概览与控制器 -->
      <div class="p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)] flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h2 class="text-base font-bold text-black/90 dark:text-white/90 flex items-center gap-2">
              <span>📊</span>
              <span>站点访问与流量实时看板 (Umami Analytics)</span>
            </h2>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>实时在线: <strong id="umami-active-visitors" class="font-mono">1</strong> 人</span>
            </span>
          </div>
          <p class="text-xs text-black/50 dark:text-white/50 mt-1 font-mono">
            API 节点: {umamiConfig.baseUrl} · Share ID: {umamiConfig.shareId}
          </p>
        </div>

        <!-- 时间筛选器与刷新 -->
        <div class="flex items-center gap-2 flex-wrap">
          <div class="p-1 rounded-xl bg-black/5 dark:bg-white/10 flex items-center text-xs font-medium">
            <button type="button" class="analytics-range-btn px-2.5 py-1 rounded-lg transition-all" data-range="today">今日</button>
            <button type="button" class="analytics-range-btn px-2.5 py-1 rounded-lg bg-[var(--primary)] text-white dark:text-black font-semibold shadow-sm transition-all" data-range="7d">近 7 天</button>
            <button type="button" class="analytics-range-btn px-2.5 py-1 rounded-lg transition-all" data-range="30d">近 30 天</button>
          </div>
          <button type="button" id="btn-refresh-analytics" class="p-2 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/15 text-xs text-black/70 dark:text-white/70 transition-all flex items-center gap-1 cursor-pointer" title="刷新流量数据">
            <svg id="analytics-refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </button>
        </div>
      </div>

      <!-- 四项核心指标卡片 -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)]">
          <div class="text-xs text-black/50 dark:text-white/50 mb-1">页面浏览量 (PV)</div>
          <div id="stat-pv" class="text-2xl font-bold font-mono text-[var(--primary)]">-</div>
          <div class="text-[11px] text-black/40 dark:text-white/40 mt-1 font-mono">Pageviews</div>
        </div>
        <div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)]">
          <div class="text-xs text-black/50 dark:text-white/50 mb-1">独立访客 (UV)</div>
          <div id="stat-uv" class="text-2xl font-bold font-mono text-emerald-500">-</div>
          <div class="text-[11px] text-black/40 dark:text-white/40 mt-1 font-mono">Unique Visitors</div>
        </div>
        <div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)]">
          <div class="text-xs text-black/50 dark:text-white/50 mb-1">访问会话 (Visits)</div>
          <div id="stat-visits" class="text-2xl font-bold font-mono text-purple-500">-</div>
          <div class="text-[11px] text-black/40 dark:text-white/40 mt-1 font-mono">Total Sessions</div>
        </div>
        <div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)]">
          <div class="text-xs text-black/50 dark:text-white/50 mb-1">跳出率 (Bounce Rate)</div>
          <div id="stat-bounce" class="text-2xl font-bold font-mono text-amber-500">-</div>
          <div class="text-[11px] text-black/40 dark:text-white/40 mt-1 font-mono">Bounce Ratio</div>
        </div>
      </div>

      <!-- 细分榜单网格 -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- 热门页面与文章 Top 7 (占 2 列) -->
        <div class="lg:col-span-2 p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)]">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-bold text-black/85 dark:text-white/85 flex items-center gap-1.5">
              <span>🔥</span>
              <span>高频热门文章与页面排行 (Top Pages)</span>
            </h3>
            <span class="text-[11px] text-black/40 dark:text-white/40 font-mono">浏览次数</span>
          </div>
          <div id="analytics-top-pages" class="space-y-2.5">
            <div class="text-xs text-black/40 dark:text-white/40 text-center py-6">正在加载数据...</div>
          </div>
        </div>

        <!-- 来源渠道与地域分布 (占 1 列) -->
        <div class="space-y-6">
          <!-- 来源渠道 -->
          <div class="p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-[var(--line-divider)]">
            <h3 class="text-sm font-bold text-black/85 dark:text-white/85 mb-3 flex items-center gap-1.5">
              <span>🧭</span>
              <span>主要访问来源 (Referrers)</span>
            </h3>
            <div id="analytics-top-referrers" class="space-y-2 text-xs">
              <div class="text-xs text-black/40 dark:text-white/40 text-center py-4">正在加载数据...</div>
            </div>
          </div>

