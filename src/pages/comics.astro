---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { formatBytes, getComicCatalog } from "@utils/comic-utils";
import { Icon } from "astro-icon/components";

const comics = getComicCatalog();
const totalSeries = comics.length;
const totalChapters = comics.reduce((sum, item) => sum + item.totalChapters, 0);
const totalPages = comics.reduce((sum, item) => sum + item.totalPages, 0);
const totalBytes = comics.reduce((sum, item) => sum + item.totalBytes, 0);

const categories = Array.from(
	new Set(comics.map((c) => c.category).filter(Boolean)),
);
---

<MainGridLayout
	title="漫画书架"
	description="瑶曦的漫画阅读馆 — 高清全彩条漫典藏，支持无缝连阅、单页翻阅、多级目录索引与自动阅读进度同步。"
>
	<div class="space-y-6">
		<!-- 头部 Hero 状态卡片 -->
		<div class="card-base px-6 md:px-8 py-7 bg-[var(--card-bg)] border border-black/5 dark:border-white/10 rounded-2xl shadow-sm relative overflow-hidden">
			<div class="absolute -right-10 -bottom-10 w-44 h-44 rounded-full bg-[var(--primary)]/5 blur-2xl pointer-events-none"></div>

			<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
				<div class="flex items-start md:items-center gap-4">
					<div class="h-14 w-14 rounded-2xl bg-[var(--primary)] flex items-center justify-center text-white dark:text-black/85 flex-shrink-0 shadow-lg shadow-[var(--primary)]/20">
						<Icon name="material-symbols:photo-library-rounded" class="text-3xl" />
					</div>
					<div>
						<div class="flex flex-wrap items-center gap-2">
							<h1 class="text-2xl md:text-3xl font-black text-black/90 dark:text-white/90 tracking-tight">
								漫画书架
							</h1>
							<span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-[var(--primary)]/15 text-[var(--primary)] border border-[var(--primary)]/25 uppercase tracking-wider">
								Comic Shelf
							</span>
						</div>
						<p class="text-xs md:text-sm text-black/60 dark:text-white/60 mt-1.5 leading-relaxed">
							全彩条漫 · 本地镜像与云端双源兜底 · 零抖动沉浸式阅览体验
						</p>
					</div>
				</div>

				<!-- 聚合指标标签组 -->
				<div class="flex flex-wrap items-center gap-2 text-xs">
					<div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 text-black/75 dark:text-white/75 font-medium">
						<Icon name="material-symbols:collections-bookmark-outline-rounded" class="text-base text-[var(--primary)]" />
						<span>收录 {totalSeries} 部</span>
					</div>
					<div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 text-black/75 dark:text-white/75 font-medium">
						<Icon name="material-symbols:format-list-numbered-rounded" class="text-base text-emerald-500" />
						<span>{totalChapters.toLocaleString()} 话</span>
					</div>
					<div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 text-black/75 dark:text-white/75 font-medium">
						<Icon name="material-symbols:auto-awesome-motion-outline-rounded" class="text-base text-blue-500" />
						<span>{totalPages.toLocaleString()} 页 · {formatBytes(totalBytes)}</span>
					</div>
				</div>
			</div>
		</div>

		<!-- 最近阅读续读条（客户端根据 localStorage 自动激活） -->
		<div
			id="comic-resume-banner"
			class="hidden card-base px-5 py-4 bg-[var(--card-bg)] border border-[var(--primary)]/25 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3"
		>
			<div class="flex items-center gap-3 min-w-0">
				<div class="w-10 h-10 rounded-xl bg-[var(--primary)]/15 text-[var(--primary)] flex items-center justify-center flex-shrink-0">
					<Icon name="material-symbols:history-rounded" class="text-xl" />
				</div>
				<div class="min-w-0">
					<div class="text-xs text-black/50 dark:text-white/50">最近阅读</div>
					<div id="comic-resume-text" class="text-sm font-bold text-black/85 dark:text-white/85 truncate"></div>
				</div>
			</div>
			<a
				id="comic-resume-link"
				href="/comics/"
				class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-[var(--primary)] text-white dark:text-black/90 hover:opacity-90 active:scale-95 transition-all flex-shrink-0"
			>
				<Icon name="material-symbols:play-arrow-rounded" class="text-base" />
				<span>继续阅读</span>
			</a>
		</div>

		<!-- 分类与状态筛选条（作品较多时支持即时过滤） -->
		{comics.length > 1 && (
			<div class="card-base p-4 bg-[var(--card-bg)] border border-black/5 dark:border-white/10 rounded-2xl flex flex-wrap items-center gap-3 text-xs">
				<div class="flex flex-wrap items-center gap-1.5">
					<span class="text-black/40 dark:text-white/40 mr-1 font-semibold">题材:</span>
					<button
						type="button"
						class="comic-category-btn px-3 py-1 rounded-lg transition-all bg-[var(--primary)] text-white dark:text-black/90 font-medium"
						data-val="all"
					>
						全部
					</button>
					{categories.map((cat) => (
						<button
							type="button"
							class="comic-category-btn px-3 py-1 rounded-lg transition-all bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 text-black/70 dark:text-white/70"
							data-val={cat}
						>
							{cat}
						</button>
					))}
				</div>
			</div>
		)}

		<!-- 漫画列表 -->
		{comics.length === 0 ? (
			<div class="card-base p-12 text-center bg-[var(--card-bg)] border border-black/5 dark:border-white/10 rounded-2xl space-y-2">
				<Icon name="material-symbols:collections-bookmark-outline-rounded" class="text-5xl text-black/25 dark:text-white/25 mx-auto" />
				<p class="text-sm text-black/50 dark:text-white/50">书架暂未导入漫画作品，可运行 <code class="font-mono">node scripts/import-comic.mjs</code> 导入。</p>
			</div>
		) : (
			<div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="comic-shelf-grid">
				{comics.map((comic) => {
					const isOngoing = comic.status === "ongoing";
					return (
						<article
							class="comic-card card-base bg-[var(--card-bg)] border border-black/5 dark:border-white/10 rounded-2xl overflow-hidden hover:shadow-lg hover:border-[var(--primary)]/35 transition-all duration-300 flex flex-col sm:flex-row group"
							data-category={comic.category}
							data-slug={comic.slug}
						>
							<!-- 竖版封面海报 -->
							<a
								href={`/comics/${comic.slug}/`}
								class="relative w-full sm:w-44 md:w-48 h-64 sm:h-auto bg-black/5 dark:bg-white/5 overflow-hidden flex-shrink-0 block"
							>
								<img
									src={comic.cover}
									data-fallback={comic.coverFallback || ""}
									alt={`${comic.title} 封面`}
									class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
									loading="lazy"
									onerror="this.onerror=null;if(this.dataset.fallback && this.src !== this.dataset.fallback){this.src = this.dataset.fallback;}"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-black/20 pointer-events-none"></div>

								<div class="absolute top-3 left-3 flex items-center gap-1.5">
									<span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-lg backdrop-blur-md shadow-sm flex items-center gap-1 ${
										isOngoing ? "bg-emerald-500/85 text-white" : "bg-blue-600/85 text-white"
									}`}>
										<span class="w-1.5 h-1.5 rounded-full bg-white"></span>
										{isOngoing ? "连载中" : comic.status === "completed" ? "已完结" : "休刊中"}
									</span>
								</div>

								<div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-[11px] text-white/95 font-medium">
									<span class="px-2 py-0.5 rounded-md bg-black/45 backdrop-blur-sm">
										{comic.category}
									</span>
									<span class="px-2 py-0.5 rounded-md bg-black/45 backdrop-blur-sm font-mono">
										{comic.totalChapters} 话
									</span>
								</div>
							</a>

							<!-- 作品详情主体 -->
							<div class="p-5 flex-1 flex flex-col justify-between gap-4 min-w-0">
								<div class="space-y-2.5">
									<div>
										<h2 class="text-lg md:text-xl font-black text-black/90 dark:text-white/90 group-hover:text-[var(--primary)] transition-colors line-clamp-1">
											<a href={`/comics/${comic.slug}/`}>{comic.title}</a>
										</h2>
										{comic.subtitle && (
											<div class="text-[11px] text-black/40 dark:text-white/40 font-mono mt-0.5">
												{comic.subtitle}
											</div>
										)}
									</div>

									<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-black/55 dark:text-white/55">
										<span class="flex items-center gap-1">
											<Icon name="material-symbols:person-outline-rounded" class="text-sm text-[var(--primary)]" />
											{comic.author}
										</span>
										<span class="flex items-center gap-1 font-mono">
											<Icon name="material-symbols:layers-outline-rounded" class="text-sm text-[var(--primary)]" />
											{comic.totalPages.toLocaleString()} 页
										</span>
									</div>

									<p class="text-xs text-black/65 dark:text-white/65 line-clamp-3 leading-relaxed">
										{comic.description}
									</p>

									{comic.tags.length > 0 && (
										<div class="flex flex-wrap gap-1.5 pt-0.5">
											{comic.tags.map((tag) => (
												<span class="text-[10px] px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 text-black/60 dark:text-white/60 border border-black/5 dark:border-white/5">
													#{tag}
												</span>
											))}
										</div>
									)}
								</div>

								<div class="pt-3 border-t border-black/5 dark:border-white/5 flex flex-wrap items-center justify-between gap-2 text-xs">
									<span class="text-black/40 dark:text-white/40 flex items-center gap-1 font-mono">
										<Icon name="material-symbols:update-rounded" class="text-sm" />
										{comic.updatedAt}
									</span>
									<div class="flex items-center gap-2">
										<a
											href={`/comics/${comic.slug}/`}
											class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 text-black/75 dark:text-white/75 font-semibold transition-all"
										>
											<span>章节目录</span>
										</a>
										<a
											href={`/comics/${comic.slug}/0001/`}
											data-comic-quick-read={comic.slug}
											class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl bg-[var(--primary)]/15 hover:bg-[var(--primary)] text-[var(--primary)] hover:text-white dark:hover:text-black/90 font-semibold transition-all"
										>
											<span>开始阅读</span>
											<Icon name="material-symbols:arrow-forward-rounded" class="text-sm" />
										</a>
									</div>
								</div>
							</div>
						</article>
					);
				})}
			</div>
		)}
	</div>
</MainGridLayout>

<script>
	function hydrateComicShelf() {
		const banner = document.getElementById("comic-resume-banner");
		const resumeText = document.getElementById("comic-resume-text");
		const resumeLink = document.getElementById("comic-resume-link") as HTMLAnchorElement | null;

		try {
			const raw = window.localStorage.getItem("yaoxi-comic-progress-v1");
			if (raw) {
				const allProgress = JSON.parse(raw) as Record<
					string,
					{
						comicSlug: string;
						comicTitle: string;
						chapterIndex: number;
						chapterSlug: string;
						chapterTitle: string;
						page: number;
						totalPages: number;
						updatedAt: string;
					}
				>;
				const entries = Object.values(allProgress).sort((a, b) =>
					String(b.updatedAt || "").localeCompare(String(a.updatedAt || "")),
				);
				const latest = entries[0];
				if (latest && banner && resumeText && resumeLink) {
					banner.classList.remove("hidden");
					resumeText.textContent = `《${latest.comicTitle}》 #${String(latest.chapterIndex).padStart(3, "0")} ${latest.chapterTitle} · 第 ${latest.page}/${latest.totalPages} 页`;
					resumeLink.href = `/comics/${latest.comicSlug}/${latest.chapterSlug}/`;
				}

				for (const item of entries) {
					const quickBtn = document.querySelector<HTMLAnchorElement>(
						`[data-comic-quick-read="${item.comicSlug}"]`,
					);
					if (quickBtn) {
						quickBtn.href = `/comics/${item.comicSlug}/${item.chapterSlug}/`;
						const span = quickBtn.querySelector("span");
						if (span) {
							span.textContent = `续读第 ${item.chapterIndex} 话`;
						}
					}
				}
			}
		} catch {
			// ignore localStorage access failures
		}

		const categoryButtons =
			document.querySelectorAll<HTMLButtonElement>(".comic-category-btn");
		const cards = document.querySelectorAll<HTMLElement>(".comic-card");
		for (const btn of categoryButtons) {
			btn.addEventListener("click", () => {
				const val = btn.dataset.val || "all";
				for (const b of categoryButtons) {
					b.classList.remove(
						"bg-[var(--primary)]",
						"text-white",
						"dark:text-black/90",
						"font-medium",
					);
					b.classList.add(
						"bg-black/5",
						"dark:bg-white/5",
						"text-black/70",
						"dark:text-white/70",
					);
				}
				btn.classList.add(
					"bg-[var(--primary)]",
					"text-white",
					"dark:text-black/90",
					"font-medium",
				);
				btn.classList.remove(
					"bg-black/5",
					"dark:bg-white/5",
					"text-black/70",
					"dark:text-white/70",
				);
				for (const card of cards) {
					const cat = card.dataset.category || "";
					card.classList.toggle("hidden", val !== "all" && cat !== val);
				}
			});
		}
	}

	hydrateComicShelf();
	document.addEventListener("astro:page-load", hydrateComicShelf);
	document.addEventListener("swup:page:view", hydrateComicShelf);
</script>
