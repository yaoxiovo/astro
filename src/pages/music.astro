---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import "../styles/music.css";

const songs = (await getCollection("music")).sort(
	(a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const featured = [...songs].sort((a, b) => b.data.likes - a.data.likes).slice(0, 3);
const lead = featured[0];
---

<MainGridLayout title="音乐馆" description="收听瑶曦收藏的歌曲、同步歌词与听歌随笔" noindex>
	<div class="music-room" data-wide-layout>
		<header class="music-hero">
			{lead?.data.cover && <img class="music-backdrop" src={lead.data.cover} alt="" fetchpriority="high" />}
			<div class="music-hero-copy">
				<h1>音乐馆</h1>
				{lead && (
					<a class="music-cta" href={`/music/${lead.slug}/`}>
						<Icon name="material-symbols:play-arrow-rounded" />
						<span>去听《{lead.data.title}》</span>
					</a>
				)}
			</div>
		</header>
		{featured.length > 0 && (
			<section class="music-section" aria-labelledby="music-featured">
				<h2 id="music-featured">热门歌曲</h2>
				<div class="music-featured">
					{featured.map(({ slug, data }) => (
						<a href={`/music/${slug}/`} class="music-tile">
							<img src={data.cover || "/favicon.svg"} alt="" loading="lazy" decoding="async" />
							<span><strong>{data.title}</strong><small>{data.artist}</small></span>
							<Icon name="material-symbols:play-arrow-rounded" />
						</a>
					))}
				</div>
			</section>
		)}
		<section class="music-section music-library" aria-labelledby="music-library">
			<div class="music-library-head">
				<h2 id="music-library">全部歌曲 <small>{songs.length} 首</small></h2>
				<label class="music-search">
					<Icon name="material-symbols:search-rounded" />
					<input type="search" placeholder="搜索歌曲、歌手" aria-label="搜索歌曲、歌手" data-track-search />
				</label>
			</div>
			<ul>
				{songs.map(({ slug, data }) => (
					<li data-track-key={`${data.title} ${data.artist} ${data.songType ?? ""}`.toLowerCase()}>
						<a href={`/music/${slug}/`} class="music-tile">
							<img src={data.cover || "/favicon.svg"} alt="" loading="lazy" decoding="async" />
							<span><strong>{data.title}</strong><small>{data.artist}</small></span>
							{data.songType && <small class="music-track-type">{data.songType}</small>}
							<Icon name="material-symbols:play-arrow-rounded" />
						</a>
					</li>
				))}
			</ul>
			<p data-track-empty role="status" hidden>没有找到匹配的歌曲。</p>
		</section>
	</div>
</MainGridLayout>

<script>
	document.addEventListener("input", (event) => {
		const input = event.target;
		if (!(input instanceof HTMLInputElement) || !input.matches("[data-track-search]")) return;
		const library = input.closest(".music-library");
		if (!library) return;
		const query = input.value.trim().toLowerCase();
		let matches = 0;
		for (const track of library.querySelectorAll<HTMLElement>("[data-track-key]")) {
			track.hidden = !track.dataset.trackKey?.includes(query);
			if (!track.hidden) matches++;
		}
		const empty = library.querySelector<HTMLElement>("[data-track-empty]");
		if (empty) empty.hidden = matches > 0;
	});
</script>
