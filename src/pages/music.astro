---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import MusicCard from "@components/widget/MusicCard.astro";
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "@/config";
import { getCollection } from "astro:content";

const musicMoments = (await getCollection("music")).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

function getFriendlyTime(date: Date) {
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffMins = Math.floor(diffMs / (1000 * 60));
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffMins < 60) {
    return diffMins <= 1 ? "刚刚" : `${diffMins} 分钟前`;
  } else if (diffHours < 24) {
    return `${diffHours} 小时前`;
  } else if (diffDays === 1) {
    return "昨天";
  } else if (diffDays === 2) {
    return "前天";
  } else {
    return date.toLocaleDateString("zh-CN", { month: "short", day: "numeric" });
  }
}
---

<MainGridLayout title="音乐馆" description="瑶曦的沉浸式音乐朋友圈">
  <div class="w-full flex flex-col gap-6">
    <!-- 朋友圈头部大 Banner -->
    <div class="card-base w-full relative h-48 md:h-64 rounded-2xl overflow-hidden shadow-md border border-white/40 group">
      <!-- 背景图 -->
      <img 
        src={siteConfig.banner.src} 
        alt="Music Banner" 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
      
      <!-- 磨砂玻璃大标题 -->
      <div class="absolute left-6 bottom-6 md:left-8 md:bottom-8 flex flex-col gap-1 relative z-10 text-white">
        <h1 class="text-3xl md:text-4xl font-black tracking-wider flex items-center gap-2 drop-shadow-md">
          <Icon name="material-symbols:library-music-rounded" class="text-2xl md:text-3xl text-[var(--primary)] animate-pulse" />
          <span>音乐馆</span>
        </h1>
        <p class="text-xs md:text-sm text-white/70 font-light tracking-widest uppercase">
          Music Moments & Live Lyrics
        </p>
      </div>

      <!-- 用户信息 (浮动在右下角，经典朋友圈设计) -->
      <div class="absolute right-6 -bottom-5 md:right-8 flex items-end gap-3 z-20">
        <span class="text-white font-bold text-base md:text-lg mb-6 drop-shadow-md tracking-wide">瑶曦</span>
        <div class="relative group/avatar">
          <img 
            src={profileConfig.avatar} 
            alt="Avatar" 
            class="w-16 h-16 md:w-20 md:h-20 rounded-2xl object-cover border-4 border-white/90 shadow-xl"
          />
          <div class="absolute -bottom-1.5 -right-1.5 bg-yellow-500 rounded-full p-0.5 border-2 border-white shadow-md">
            <svg viewBox="0 0 24 24" class="w-4 h-4 text-white" aria-label="Verified account" role="img"><g><path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.918-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.337 2.25c-.416-.165-.866-.25-1.336-.25-2.21 0-3.918 1.792-3.918 4 0 .495.084.965.238 1.4-1.273.65-2.148 2.02-2.148 3.6 0 1.46.728 2.76 1.848 3.52-.06.335-.09.68-.09 1.03 0 2.21 1.71 3.998 3.918 3.998.47 0 .92-.084(1.336-.25.52 1.333 1.817 2.25 3.337 2.25s2.816-.917 3.337-2.25c.416.165.866.25 1.336.25 2.21 0 3.918-1.792 3.918-4 0-.35-.03-.695-.09-1.03 1.12-.76 1.848-2.06 1.848-3.52z" fill="currentColor"></path><path d="M10.89 16.03L7.75 12.87l1.41-1.41 1.73 1.73 4.95-4.95 1.41 1.41-6.36 6.38z" fill="#fff"></path></g></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- 占位高度补全 -->
    <div class="h-4"></div>

    <!-- 音乐馆歌曲列表 (两列网格布局) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10">
      {musicMoments.map((moment) => {
        // 提取说说第一行作为摘要
        const firstLine = moment.body.trim().split('\n')[0] || "暂无随笔内容...";
        const displaySummary = firstLine.length > 35 ? firstLine.substring(0, 35) + "..." : firstLine;
        
        return (
          <a 
            href={`/music/${moment.slug}/`}
            class="group relative flex items-center gap-5 p-4 rounded-2xl backdrop-blur-xl bg-white/70 dark:bg-zinc-900/60 border border-white/80 dark:border-white/5 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-[var(--primary)] dark:hover:border-[var(--primary)] transition-all duration-300 overflow-hidden"
          >
            <!-- 晶莹发光渐变背景 -->
            <div class="absolute inset-0 bg-gradient-to-tr from-white/10 via-white/20 to-white/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

            <!-- 歌曲封面缩略图 -->
            <div class="relative w-24 h-24 rounded-xl overflow-hidden flex-shrink-0 shadow-md ring-2 ring-white/50 dark:ring-white/10 group-hover:scale-105 transition-transform duration-500">
              <img 
                src={moment.data.cover || "/favicon.svg"} 
                alt={moment.data.title} 
                class="w-full h-full object-cover"
              />
              <!-- 悬浮播放图标遮罩 -->
              <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <Icon name="material-symbols:play-arrow-rounded" class="text-white text-3xl" />
              </div>
            </div>

            <!-- 歌曲基本信息 -->
            <div class="flex flex-col justify-between flex-grow h-24 py-1">
              <div>
                <h3 class="font-bold text-base text-neutral-800 dark:text-neutral-200 tracking-wide line-clamp-1 group-hover:text-[var(--primary)] transition-colors duration-300">
                  {moment.data.title}
                </h3>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 line-clamp-1">
                  {moment.data.artist}
                </p>
              </div>

              <!-- 底部随笔摘要与发布信息 -->
              <div class="flex flex-col gap-1">
                <!-- 随笔一句话摘要 -->
                <p class="text-[11px] text-neutral-400 dark:text-neutral-500 line-clamp-1 italic font-light">
                  "{displaySummary}"
                </p>
                
                <!-- 底部作者/时间/点赞 -->
                <div class="flex items-center justify-between text-[10px] text-neutral-400 dark:text-neutral-500 mt-1">
                  <div class="flex items-center gap-1.5">
                    <span class="font-semibold text-[var(--primary)]">@{moment.data.author}</span>
                    <span>•</span>
                    <span>{getFriendlyTime(moment.data.published)}</span>
                  </div>
                  <div class="flex items-center gap-1">
                    <Icon name="fa6-regular:heart" class="w-2.5 h-2.5" />
                    <span>{moment.data.likes}</span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</MainGridLayout>
