---
import { getCollection } from "astro:content";
import { profileConfig } from "@/config";
import MusicCard from "@components/widget/MusicCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getComicCatalog } from "@utils/comic-utils";
import { Icon } from "astro-icon/components";
import "../../styles/music.css";

export async function getStaticPaths() {
	const musicEntries = await getCollection("music");
	return musicEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const {
	title,
	artist,
	cover,
	src,
	lrc,
	author,
	avatar,
	published,
	source,
	likes,
	songType,
} = entry.data;
const songs = (await getCollection("music")).sort(
	(a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const index = songs.findIndex((song) => song.slug === entry.slug);
const neighbors = [
	{
		song: songs[index - 1],
		label: "上一首",
		icon: "material-symbols:skip-previous-rounded",
	},
	{
		song: songs[index + 1],
		label: "下一首",
		icon: "material-symbols:skip-next-rounded",
	},
].filter(({ song }) => song);
const { Content } = await entry.render();
const relatedComics = getComicCatalog().filter((comic) =>
	entry.data.comics.includes(comic.slug),
);
const dateLabel = published.toLocaleDateString("zh-CN", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});
---

<MainGridLayout title={`${title} - 音乐馆`} description={`收听 ${artist} 的《${title}》`} image={cover} noindex>
	<div class="music-room" data-wide-layout>
		<nav class="music-detail-nav" aria-label="音乐馆导航">
			<a class="music-back-link" href="/music/">
				<Icon name="material-symbols:arrow-back-rounded" />
				音乐馆
			</a>
			{(relatedComics.length > 0 || songType) && (
				<div class="music-detail-tags">
					{relatedComics.map((comic) => <a href={`/comics/${comic.slug}/`}>{comic.title}<Icon name="material-symbols:arrow-outward-rounded" /></a>)}
					{songType && <span>{songType}</span>}
				</div>
			)}
		</nav>

		<MusicCard src={src} title={title} artist={artist} cover={cover} lrc={lrc} />

		<div class="music-detail-grid">
			<music-notes class="music-notes card-base">
				<div class="music-section-head">
					<h2>听歌随笔</h2>
					<div class="music-note-actions">
						<button type="button" data-note-like={entry.id} aria-label="点赞" aria-pressed="false" disabled>
							<Icon name="fa6-regular:heart" />
							<span data-like-count={likes}>{likes}</span>
						</button>
						<button type="button" data-note-share={`【瑶曦的听歌日志】今天推荐一首《${title}》- ${artist}。来自网页端听歌链接：${src}`} disabled>
							<Icon name="fa6-solid:share-nodes" />
							分享
						</button>
					</div>
				</div>
				<div class="music-byline">
					{author && <img src={avatar || profileConfig.avatar} alt="" width="40" height="40" loading="lazy" />}
					<div>
						{author && <strong>{author}</strong>}
						<time datetime={published.toISOString()}>{dateLabel}</time>
					</div>
					{source && <span class="music-note-source">来自 {source}</span>}
				</div>
				<article class="music-note-body prose max-w-none">
					<Content />
				</article>
				<p class="music-note-status" data-note-status role="status" hidden></p>
			</music-notes>

			{neighbors.length > 0 && (
				<nav class="music-neighbors card-base" aria-labelledby="music-neighbors-heading">
					<h2 id="music-neighbors-heading">相邻曲目</h2>
					{neighbors.map(({ song, label, icon }) => (
						<a class="music-track" href={`/music/${song.slug}/`}>
							<span class="music-track-art">
								{song.data.cover
									? <img src={song.data.cover} alt="" width="48" height="48" loading="lazy" />
									: <Icon name="material-symbols:music-note-rounded" />}
							</span>
							<span class="music-track-copy"><small>{label}</small><strong>{song.data.title}</strong></span>
							<Icon name={icon} class="music-neighbor-icon" />
						</a>
					))}
				</nav>
			)}
		</div>
	</div>
</MainGridLayout>

<script>
	class MusicNotes extends HTMLElement {
		private lifecycle?: AbortController;

		connectedCallback() {
			if (this.lifecycle) return;
			const like = this.querySelector<HTMLButtonElement>("[data-note-like]");
			const count = this.querySelector<HTMLElement>("[data-like-count]");
			const share = this.querySelector<HTMLButtonElement>("[data-note-share]");
			const status = this.querySelector<HTMLElement>("[data-note-status]");
			if (!like || !count || !share || !status) return;

			this.lifecycle = new AbortController();
			const options = { signal: this.lifecycle.signal };
			const key = `music-moment-liked-${like.dataset.noteLike}`;
			const baseLikes = Number(count.dataset.likeCount);
			let liked = false;
			try {
				liked = localStorage.getItem(key) === "true";
			} catch {
				// 点赞仍可在当前页面使用。
			}

			const renderLike = () => {
				like.setAttribute("aria-pressed", String(liked));
				count.textContent = String(baseLikes + Number(liked));
			};
			renderLike();
			like.disabled = false;
			share.disabled = false;

			like.addEventListener("click", () => {
				liked = !liked;
				renderLike();
				try {
					localStorage.setItem(key, String(liked));
				} catch {
					// 点赞仍可在当前页面使用。
				}
			}, options);

			share.addEventListener("click", async () => {
				let message: string;
				try {
					await navigator.clipboard.writeText(share.dataset.noteShare ?? "");
					message = "推荐语与音频链接已复制。";
				} catch {
					message = "无法复制音频链接。";
				}
				if (options.signal.aborted) return;
				status.hidden = false;
				status.textContent = message;
			}, options);
		}

		disconnectedCallback() {
			this.lifecycle?.abort();
			this.lifecycle = undefined;
		}
	}

	if (!customElements.get("music-notes")) customElements.define("music-notes", MusicNotes);
</script>
