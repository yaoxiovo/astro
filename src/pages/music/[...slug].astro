---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import MusicCard from "@components/widget/MusicCard.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const musicEntries = await getCollection("music");
  return musicEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<MainGridLayout title={`${entry.data.title} - 听歌随笔`} description={`关于 ${entry.data.title} 的沉浸式听歌随笔喵`}>
  <div class="w-full flex flex-col gap-6">
    <!-- 返回音乐馆按钮 (磨砂玻璃微悬浮) -->
    <div class="flex justify-start">
      <a 
        href="/music" 
        class="flex items-center gap-2 py-2 px-4 rounded-xl text-neutral-700 dark:text-neutral-300 hover:text-[var(--primary)] backdrop-blur-xl bg-white/30 dark:bg-black/10 border border-black/5 dark:border-white/10 shadow-sm hover:shadow-md hover:-translate-y-0.5 active:scale-95 transition-all duration-300 font-semibold text-sm"
      >
        <Icon name="material-symbols:arrow-back-ios-new-rounded" class="w-4 h-4" />
        <span>返回音乐馆</span>
      </a>
    </div>

    <!-- 上方：音乐卡片组件 -->
    <div class="w-full relative z-10">
      <MusicCard 
        src={entry.data.src} 
        title={entry.data.title} 
        artist={entry.data.artist} 
        cover={entry.data.cover}
        lrc={entry.data.lrc}
      />
    </div>

    <!-- 下方：随笔展示区 -->
    <div class="backdrop-blur-xl bg-white/80 dark:bg-white/85 border border-white/80 rounded-2xl p-8 shadow-md flex flex-col gap-4 text-neutral-800 dark:text-neutral-800">
      <div class="flex items-center justify-between border-b border-neutral-200 pb-4 mb-2">
        <div class="flex items-center gap-3">
          <img 
            src={entry.data.avatar || profileConfig.avatar} 
            alt={entry.data.author} 
            class="w-10 h-10 rounded-xl object-cover ring-2 ring-white"
          />
          <div class="flex flex-col">
            <span class="font-bold text-sm text-[var(--primary)]">{entry.data.author}</span>
            <span class="text-[10px] text-neutral-500 font-mono mt-0.5">
              发布于 {entry.data.published.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
            </span>
          </div>
        </div>
        <div class="text-xs text-neutral-500 font-mono">
          来自 {entry.data.source}
        </div>
      </div>

      <!-- 渲染 Markdown 正文 -->
      <article class="prose prose-neutral dark:prose-invert max-w-none text-neutral-800 dark:text-neutral-800 leading-relaxed font-normal">
        <Content />
      </article>

      <!-- 底部发布来源与交互按键 -->
      <div class="flex items-center justify-between border-t border-neutral-200/80 pt-4 mt-6 text-xs text-neutral-500 dark:text-neutral-500 relative z-10">
        <span class="font-mono">来自 {entry.data.source}</span>

        <div class="flex items-center gap-4">
          <!-- 点赞按钮 -->
          <button 
            class="music-moment-like-btn flex items-center gap-1.5 py-1 px-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800/50 active:scale-90 group text-neutral-500 dark:text-neutral-500 transition-all duration-200"
            data-id={entry.id}
          >
            <Icon name="fa6-regular:heart" class="like-icon w-3.5 h-3.5 transition-transform duration-300 group-hover:scale-110" />
            <span class="like-count font-semibold font-mono text-neutral-600 dark:text-neutral-400">{entry.data.likes}</span>
          </button>

          <!-- 分享按钮 -->
          <button 
            class="music-moment-share-btn flex items-center gap-1 py-1 px-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800/50 active:scale-90 text-neutral-500 dark:text-neutral-500 hover:text-[var(--primary)] transition-all duration-200"
            data-id={entry.id}
            data-content={`【瑶曦的听歌日志】今天推荐一首《${entry.data.title}》- ${entry.data.artist}。来自网页端听歌链接：${entry.data.src}`}
          >
            <Icon name="fa6-solid:share-nodes" class="w-3.5 h-3.5" />
            <span>分享</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</MainGridLayout>

<script>
  function initMusicDetails() {
    const likeBtns = document.querySelectorAll(".music-moment-like-btn");
    
    likeBtns.forEach((btn: any) => {
      const id = btn.dataset.id;
      const countSpan = btn.querySelector(".like-count");
      const icon = btn.querySelector(".like-icon");
      if (!id || !countSpan || !icon) return;

      const storageKey = `music-moment-liked-${id}`;
      let isLiked = localStorage.getItem(storageKey) === "true";
      let baseLikes = parseInt(countSpan.textContent || "0", 10);

      if (isLiked) {
        icon.classList.remove("text-neutral-400", "dark:text-neutral-500");
        icon.classList.add("text-red-500", "fill-red-500");
        icon.setAttribute("style", "color: rgb(239, 68, 68);");
      }

      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", () => {
        isLiked = !isLiked;
        localStorage.setItem(storageKey, isLiked ? "true" : "false");
        
        let newCount = isLiked ? baseLikes + 1 : baseLikes;
        countSpan.textContent = newCount.toString();

        if (isLiked) {
          icon.classList.remove("text-neutral-400", "dark:text-neutral-500");
          icon.classList.add("text-red-500", "fill-red-500");
          icon.setAttribute("style", "color: rgb(239, 68, 68); transform: scale(1.2); transition: transform 0.2s;");
          showToast("点赞成功了喵~ ❤️");
        } else {
          icon.classList.remove("text-red-500", "fill-red-500");
          icon.classList.add("text-neutral-400", "dark:text-neutral-500");
          icon.setAttribute("style", "color: ''; transform: scale(1.0); transition: transform 0.2s;");
        }
      });
    });

    const shareBtns = document.querySelectorAll(".music-moment-share-btn");
    shareBtns.forEach((btn: any) => {
      const content = btn.dataset.content;
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", () => {
        if (!content) return;
        navigator.clipboard.writeText(content)
          .then(() => {
            showToast("推荐语与音频直链已复制到剪贴板喵~ 📋");
          })
          .catch((err) => {
            console.error("Copy failed:", err);
            showToast("复制失败了喵，请手动复制吧...");
          });
      });
    });

    function showToast(message: string) {
      let oldToast = document.querySelector(".glass-toast");
      if (oldToast) oldToast.remove();

      const toast = document.createElement("div");
      toast.className = "glass-toast fixed bottom-12 left-1/2 -translate-x-1/2 px-5 py-3 rounded-2xl backdrop-blur-xl bg-white/90 border border-white/60 text-neutral-800 text-xs md:text-sm font-semibold shadow-lg z-[9999] transition-all duration-300 opacity-0 translate-y-3 pointer-events-none";
      toast.textContent = message;
      document.body.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove("opacity-0", "translate-y-3");
        toast.classList.add("opacity-100", "translate-y-0");
      }, 50);

      setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0");
        toast.classList.add("opacity-0", "translate-y-3");
        setTimeout(() => toast.remove(), 300);
      }, 2200);
    }
  }

  // 立即执行一次以兼容 Swup 单页应用路由异步加载
  initMusicDetails();

  document.addEventListener("DOMContentLoaded", initMusicDetails);
  document.addEventListener("swup:contentReplaced", initMusicDetails);
  document.addEventListener("swup:page:view", initMusicDetails);
</script>
