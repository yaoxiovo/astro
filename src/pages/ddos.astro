              <button type="button" id="btn-sync-ddos-creds" class="text-[10px] px-2 py-0.5 rounded-md bg-[var(--primary)]/10 text-[var(--primary)] hover:bg-[var(--primary)]/20 transition-all font-medium flex items-center gap-1 cursor-pointer">
