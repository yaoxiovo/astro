</MainGridLayout>

<!-- 客户端动态交互与 Cloudflare DDoS 日志拉取驱动 -->
<script is:inline>
(() => {
  let isInitialized = false;
  let pollTimer = null;
  let countdownTimer = null;
  let countdownSeconds = 30;
  let currentHours = 24;
  let isDemoMode = false;
  let currentLogs = [];

  const STORAGE_KEY_ENDPOINT = "yaoxi_ddos_api_endpoint";
  const STORAGE_KEY_TOKEN = "yaoxi_ddos_cf_token";
  const STORAGE_KEY_ZONE = "yaoxi_ddos_cf_zone_id";
  const STORAGE_KEY_DEMO = "yaoxi_ddos_demo_mode";

  function getDefaultApiEndpoint() {
    return (localStorage.getItem(STORAGE_KEY_ENDPOINT) || "https://blog-api.yaoxi.cloud").replace(/\/$/, "");
  }

  function initDDoSPage() {
    const shieldIcon = document.getElementById("shield-icon");
    if (!shieldIcon) return; // 当前页面非 ddos 页面

    // 清理旧定时器
    if (pollTimer) clearInterval(pollTimer);
    if (countdownTimer) clearInterval(countdownTimer);

    // 读取持久化演练开关
    isDemoMode = localStorage.getItem(STORAGE_KEY_DEMO) === "true";
    updateDemoButtonState();

    bindEvents();
    fetchDDoSLogs();
    startCountdown();
  }

  function updateDemoButtonState() {
    const demoBtn = document.getElementById("btn-toggle-demo");
    const demoLabel = document.getElementById("demo-mode-label");
    if (!demoBtn || !demoLabel) return;

    if (isDemoMode) {
      demoBtn.classList.add("bg-amber-500/20", "border-amber-500/50", "text-amber-600", "dark:text-amber-400", "font-bold");
      demoLabel.textContent = "退出演练";
    } else {
      demoBtn.classList.remove("bg-amber-500/20", "border-amber-500/50", "text-amber-600", "dark:text-amber-400", "font-bold");
      demoLabel.textContent = "演练模拟";
    }
  }

  function bindEvents() {
    // 时间范围按钮
    document.querySelectorAll(".time-range-btn").forEach((btn) => {
      btn.onclick = () => {
        document.querySelectorAll(".time-range-btn").forEach((b) => {
          b.classList.remove("active-time", "bg-[var(--primary)]", "text-white", "dark:text-black", "font-semibold", "shadow-sm");
        });
        btn.classList.add("active-time", "bg-[var(--primary)]", "text-white", "dark:text-black", "font-semibold", "shadow-sm");
        currentHours = parseInt(btn.getAttribute("data-hours") || "24", 10);
        resetCountdown();
        fetchDDoSLogs();
      };
    });

    // 演练开关
    const toggleDemoBtn = document.getElementById("btn-toggle-demo");
    if (toggleDemoBtn) {
      toggleDemoBtn.onclick = () => {
        isDemoMode = !isDemoMode;
        localStorage.setItem(STORAGE_KEY_DEMO, String(isDemoMode));
        updateDemoButtonState();
        resetCountdown();
        fetchDDoSLogs();
      };
    }

    const emptyDemoBtn = document.getElementById("btn-empty-demo");
    if (emptyDemoBtn) {
      emptyDemoBtn.onclick = () => {
        isDemoMode = true;
        localStorage.setItem(STORAGE_KEY_DEMO, "true");
        updateDemoButtonState();
        resetCountdown();
        fetchDDoSLogs();
      };
    }

    // 手动刷新
    const refreshBtn = document.getElementById("btn-refresh");
    if (refreshBtn) {
      refreshBtn.onclick = () => {
        resetCountdown();
        fetchDDoSLogs();
      };
    }

    // 搜索与过滤
    const searchInput = document.getElementById("input-search-log");
    if (searchInput) {
      searchInput.oninput = () => renderLogList();
    }
    const filterAction = document.getElementById("filter-action");
    if (filterAction) {
      filterAction.onchange = () => renderLogList();
    }

    // 导出 JSON
    const exportBtn = document.getElementById("btn-export-json");
    if (exportBtn) {
      exportBtn.onclick = () => {
        if (!currentLogs || currentLogs.length === 0) {
          alert("当前暂无 DDoS 攻击日志可导出 喵~");
          return;
        }
        const jsonStr = JSON.stringify(currentLogs, null, 2);
        navigator.clipboard.writeText(jsonStr).then(() => {
          alert("已复制全部攻击事件日志 JSON 至剪贴板 喵呜！✨");
        }).catch(() => {
          prompt("请手动复制以下日志 JSON:", jsonStr);
        });
      };
    }

    // 设置弹窗
    const openSettingsBtn = document.getElementById("btn-open-settings");
    const closeSettingsBtn = document.getElementById("btn-close-settings");
    const settingsModal = document.getElementById("settings-modal");
    const saveSettingsBtn = document.getElementById("btn-save-settings");
    const resetSettingsBtn = document.getElementById("btn-reset-settings");
    const syncCredsBtn = document.getElementById("btn-sync-ddos-creds");
    const badgeAutoToken = document.getElementById("badge-cf-token-auto");

    function resolveCfToken() {
      if (typeof window !== "undefined" && window.yaoxiAuth && typeof window.yaoxiAuth.getPlatformToken === "function") {
        const pt = window.yaoxiAuth.getPlatformToken("cloudflare");
        if (pt) return pt;
      }
      return localStorage.getItem(STORAGE_KEY_TOKEN) || "";
    }

    function updateSettingBadges() {
      const hasToken = !!resolveCfToken();
      if (badgeAutoToken) {
        if (hasToken) badgeAutoToken.classList.remove("hidden");
        else badgeAutoToken.classList.add("hidden");
      }
    }

    if (openSettingsBtn && settingsModal) {
      openSettingsBtn.onclick = () => {
        document.getElementById("setting-api-endpoint").value = getDefaultApiEndpoint();
        document.getElementById("setting-cf-token").value = resolveCfToken();
        document.getElementById("setting-cf-zone-id").value = localStorage.getItem(STORAGE_KEY_ZONE) || "";
        updateSettingBadges();
        settingsModal.classList.remove("hidden");
      };
    }

    if (syncCredsBtn) {
      syncCredsBtn.onclick = async () => {
        if (typeof window.yaoxiSyncCredentials === "function") {
          syncCredsBtn.disabled = true;
          syncCredsBtn.innerHTML = "<span>⏳ 下发中...</span>";
          try {
            const creds = await window.yaoxiSyncCredentials();
            if (creds && (creds.cf_token || creds.github_pat)) {
              if (creds.cf_token) {
                document.getElementById("setting-cf-token").value = creds.cf_token;
                localStorage.setItem(STORAGE_KEY_TOKEN, creds.cf_token);
              }
              if (creds.cf_zone_id) {
                document.getElementById("setting-cf-zone-id").value = creds.cf_zone_id;
                localStorage.setItem(STORAGE_KEY_ZONE, creds.cf_zone_id);
              }
              updateSettingBadges();
              alert("已随统一认证中心成功下发 Cloudflare 运维凭据喵！");
            } else {
              alert("未从认证中心拉取到运维凭据，请确认当前账号具备管理员权限喵！");
            }
          } catch (e) {
            alert("同步下发异常: " + e.message);
          } finally {
            syncCredsBtn.disabled = false;
            syncCredsBtn.innerHTML = "<span>🔄 重新下发凭据</span>";
          }
        } else {
          alert("统一认证中心客户端尚未就绪 喵！");
        }
      };
    }

    if (closeSettingsBtn && settingsModal) {
      closeSettingsBtn.onclick = () => settingsModal.classList.add("hidden");
    }

    if (resetSettingsBtn) {
      resetSettingsBtn.onclick = () => {
        localStorage.removeItem(STORAGE_KEY_ENDPOINT);
        localStorage.removeItem(STORAGE_KEY_TOKEN);
        localStorage.removeItem(STORAGE_KEY_ZONE);
        document.getElementById("setting-api-endpoint").value = "https://blog-api.yaoxi.cloud";
        document.getElementById("setting-cf-token").value = "";
        document.getElementById("setting-cf-zone-id").value = "";
        updateSettingBadges();
      };
    }

    if (saveSettingsBtn && settingsModal) {
      saveSettingsBtn.onclick = () => {
        const ep = document.getElementById("setting-api-endpoint").value.trim();
        const tok = document.getElementById("setting-cf-token").value.trim();
        const zone = document.getElementById("setting-cf-zone-id").value.trim();

        if (ep) localStorage.setItem(STORAGE_KEY_ENDPOINT, ep);
        else localStorage.removeItem(STORAGE_KEY_ENDPOINT);

        if (tok) localStorage.setItem(STORAGE_KEY_TOKEN, tok);
        else localStorage.removeItem(STORAGE_KEY_TOKEN);

        if (zone) localStorage.setItem(STORAGE_KEY_ZONE, zone);
        else localStorage.removeItem(STORAGE_KEY_ZONE);

        settingsModal.classList.add("hidden");
        resetCountdown();
        fetchDDoSLogs();
      };
    }

    // 自动预拉取认证中心凭据（若用户为管理员但未配置）
    if (!localStorage.getItem(STORAGE_KEY_TOKEN) && typeof window.yaoxiSyncCredentials === "function") {
      window.yaoxiSyncCredentials().catch(() => {});
    }
  }

  function startCountdown() {
    countdownSeconds = 30;
    const progressEl = document.getElementById("countdown-progress");
    const autoCheck = document.getElementById("auto-refresh-check");

    countdownTimer = setInterval(() => {
      if (!autoCheck || !autoCheck.checked) return;

      countdownSeconds--;
      if (progressEl) {
        const percent = Math.max(0, (countdownSeconds / 30) * 100);
        progressEl.style.width = percent + "%";
      }

      if (countdownSeconds <= 0) {
        countdownSeconds = 30;
        fetchDDoSLogs();
      }
    }, 1000);
  }

  function resetCountdown() {
    countdownSeconds = 30;
    const progressEl = document.getElementById("countdown-progress");
    if (progressEl) progressEl.style.width = "100%";
  }

  async function fetchDDoSLogs() {
    const refreshSpinner = document.getElementById("refresh-spinner");
    if (refreshSpinner) refreshSpinner.classList.add("animate-spin");

    const endpoint = getDefaultApiEndpoint();
    const customToken = resolveCfToken();
    const customZone = localStorage.getItem(STORAGE_KEY_ZONE);

    let apiUrl = `${endpoint}/api/ddos?hours=${currentHours}&limit=50`;
    if (isDemoMode) {
      apiUrl += "&demo=1";
    }

    try {
      let data = null;
      let usedDirectCF = false;

      // 如果用户在本地配置了直接访问 CF GraphQL
      if (customToken && customZone && !isDemoMode) {
        try {
          data = await queryCloudflareDirect(customToken, customZone, currentHours);
          usedDirectCF = true;
        } catch (e) {
          console.warn("[DDoS] 本地直连 CF 失败，回退至 Worker 网关:", e);
        }
      }

      if (!data) {
        const res = await fetch(apiUrl);
        if (res.ok) {
          data = await res.json();
        } else {
          // 备用：尝试回退到 zk-api
          if (!endpoint.includes("zk-api.yaoxi.cloud")) {
            const fallbackUrl = `https://zk-api.yaoxi.cloud/api/ddos?hours=${currentHours}&limit=50${isDemoMode ? "&demo=1" : ""}`;
            const fbRes = await fetch(fallbackUrl);
            if (fbRes.ok) data = await fbRes.json();
          }
        }
      }

      if (!data) {
        throw new Error("未能从网关获取到 DDoS 响应");
      }

      renderPageData(data, usedDirectCF);
    } catch (err) {
      console.error("[DDoS] 获取日志异常:", err);
      // 展示离线兜底状态
      renderFallbackState(err.message);
    } finally {
      if (refreshSpinner) refreshSpinner.classList.remove("animate-spin");
    }
  }

  async function queryCloudflareDirect(token, zoneId, hours) {
    const since = new Date(Date.now() - hours * 3600 * 1000).toISOString();
    const until = new Date().toISOString();

    const gql = `
      query GetSecurityLogs($zoneTag: String!, $since: String!, $until: String!) {
        viewer {
          zones(filter: { zoneTag: $zoneTag }) {
            securityEventsAdaptive(
              filter: { datetime_geq: $since, datetime_leq: $until },
              limit: 50,
              orderBy: [datetime_DESC]
            ) {
              action
              clientASNDescription
              clientAsn
              clientCountryName
              clientIP
              clientRequestHTTPHost
              clientRequestHTTPMethodName
              clientRequestPath
              datetime
              rayName
              ruleId
              source
              userAgent
            }
          }
        }
      }
    `;

    const res = await fetch("https://api.cloudflare.com/client/v4/graphql", {
      method: "POST",
      headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
      body: JSON.stringify({ query: gql, variables: { zoneTag: zoneId, since, until } }),
    });

    if (!res.ok) throw new Error("CF GraphQL 响应状态: " + res.status);
    const j = await res.json();
    const rawEvents = j?.data?.viewer?.zones?.[0]?.securityEventsAdaptive || [];

    const ddosEvents = rawEvents.filter((e) => {
      const s = String(e.source || "").toLowerCase();
      const a = String(e.action || "").toLowerCase();
      return s.includes("ddos") || s.includes("dos") || s.includes("rate") || a.includes("drop") || a.includes("block");
    });

    return {
      status: ddosEvents.length > 0 ? "attack" : "normal",
      hasAttack: ddosEvents.length > 0,
      isDemo: false,
      target: "blog.yaoxi.wiki",
      activeAttacks: ddosEvents.length > 0 ? 1 : 0,
      totalEvents: ddosEvents.length,
      events: ddosEvents.map((e, idx) => ({
        id: e.rayName || `event-${idx}`,
        timestamp: e.datetime,
        action: e.action || "drop",
        source: e.source || "l7ddos",
        ruleId: e.ruleId || "CF L7 Mitigation",
        rayId: e.rayName || "",
        ip: e.clientIP ? e.clientIP.replace(/\.\d+$/, ".***") : "未知",
        country: e.clientCountryName || "未知地区",
        countryCode: "UN",
        asn: e.clientAsn ? `AS${e.clientAsn}` : "未知网络",
        asnDesc: e.clientASNDescription || "",
        method: e.clientRequestHTTPMethodName || "GET",
        host: e.clientRequestHTTPHost || "blog.yaoxi.wiki",
        path: e.clientRequestPath || "/",
        ua: e.userAgent || "",
        attackType: "L7 HTTP DDoS 清洗",
      })),
      cfConnected: true,
      updatedAt: new Date().toISOString(),
    };
  }

  function renderPageData(data, isDirect) {
    currentLogs = data.events || [];

    // 更新探测时间
    const updatedEl = document.getElementById("last-updated-time");
    if (updatedEl) {
      const dt = data.updatedAt ? new Date(data.updatedAt) : new Date();
      updatedEl.textContent = dt.toLocaleTimeString("zh-CN", { hour12: false });
    }

    // 网关连接状态
    const connEl = document.getElementById("cf-connection-status");
    if (connEl) {
      if (isDemoMode) connEl.textContent = "🎮 攻防演练模式 (本地模拟)";
      else if (isDirect) connEl.textContent = "⚡ 本地私有 API Token 直连";
      else if (data.cfConnected) connEl.textContent = "✅ Cloudflare 边缘网关已连通";
      else connEl.textContent = "⚠️ Cloudflare Token 未绑定 (展示基础防护)";
    }

    const isUnderAttack = data.status === "attack" || (data.hasAttack && data.activeAttacks > 0);
    const hasAnyIncident = data.hasAttack || currentLogs.length > 0;

    // 1. 顶部盾牌与光晕风格
    const haloEl = document.getElementById("status-halo");
    const shieldContainer = document.getElementById("shield-icon-container");
    const badgeEl = document.getElementById("status-badge");
    const badgeText = document.getElementById("status-badge-text");

    if (isUnderAttack) {
      // 🚨 遭受攻击中
      if (haloEl) haloEl.className = "absolute -right-16 -top-16 w-56 h-56 rounded-full blur-3xl opacity-30 pointer-events-none transition-all duration-700 bg-red-600";
      if (shieldContainer) shieldContainer.className = "w-14 h-14 md:w-16 md:h-16 rounded-2xl flex items-center justify-center flex-shrink-0 transition-all duration-500 shadow-lg shadow-red-500/20 bg-red-500/15 text-red-600 border border-red-500/30 animate-pulse";
      if (badgeEl) badgeEl.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold font-mono tracking-wide transition-all duration-500 bg-red-500/15 text-red-600 dark:text-red-400 border border-red-500/40";
      if (badgeText) badgeText.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-600 animate-ping mr-1"></span>🚨 遭受攻击中 · UNDER ATTACK';
    } else if (hasAnyIncident) {
      // ⚠️ 近期有拦截
      if (haloEl) haloEl.className = "absolute -right-16 -top-16 w-56 h-56 rounded-full blur-3xl opacity-20 pointer-events-none transition-all duration-700 bg-amber-500";
      if (shieldContainer) shieldContainer.className = "w-14 h-14 md:w-16 md:h-16 rounded-2xl flex items-center justify-center flex-shrink-0 transition-all duration-500 shadow-md bg-amber-500/10 text-amber-500 border border-amber-500/20";
      if (badgeEl) badgeEl.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold font-mono tracking-wide transition-all duration-500 bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30";
      if (badgeText) badgeText.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-500 mr-1"></span>⚠️ 触发清洗质询 · ELEVATED';
    } else {
      // 🟢 安全正常
      if (haloEl) haloEl.className = "absolute -right-16 -top-16 w-56 h-56 rounded-full blur-3xl opacity-20 pointer-events-none transition-all duration-700 bg-emerald-500";
      if (shieldContainer) shieldContainer.className = "w-14 h-14 md:w-16 md:h-16 rounded-2xl flex items-center justify-center flex-shrink-0 transition-all duration-500 shadow-md bg-emerald-500/10 text-emerald-500 border border-emerald-500/20";
      if (badgeEl) badgeEl.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold font-mono tracking-wide transition-all duration-500 bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30";
      if (badgeText) badgeText.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping mr-1"></span>🟢 安全防护中 · NORMAL';
    }

    // 2. 警报横幅
    const alertBanner = document.getElementById("attack-alert-banner");
    if (alertBanner) {
      if (isUnderAttack) {
        alertBanner.classList.remove("hidden");
        const peakEl = document.getElementById("alert-peak-rps");
        if (peakEl) peakEl.textContent = data.peakRate || "18,450 req/s";
        const topEndEl = document.getElementById("alert-top-endpoint");
        if (topEndEl && currentLogs[0]) topEndEl.textContent = currentLogs[0].path || "/api/moments.json";
      } else {
        alertBanner.classList.add("hidden");
      }
    }

    // 3. 四张核心态势卡片数据
    const defenseStateEl = document.getElementById("metric-defense-state");
    if (defenseStateEl) {
      if (isUnderAttack) {
        defenseStateEl.textContent = "全力清洗中";
        defenseStateEl.className = "text-xl md:text-2xl font-black tracking-tight text-red-600 dark:text-red-400";
      } else if (hasAnyIncident) {
        defenseStateEl.textContent = "质询拦截中";
        defenseStateEl.className = "text-xl md:text-2xl font-black tracking-tight text-amber-600 dark:text-amber-400";
      } else {
        defenseStateEl.textContent = "安全平稳";
        defenseStateEl.className = "text-xl md:text-2xl font-black tracking-tight text-emerald-600 dark:text-emerald-400";
      }
    }

    const blockedTotalEl = document.getElementById("metric-blocked-total");
    if (blockedTotalEl) {
      blockedTotalEl.textContent = String(data.totalEvents || currentLogs.length);
    }

    const peakRpsEl = document.getElementById("metric-peak-rps");
    if (peakRpsEl) {
      peakRpsEl.textContent = isUnderAttack ? (data.peakRate ? data.peakRate.replace(" req/s", "") : "18,450") : "0";
    }

    const topSourceEl = document.getElementById("metric-top-source");
    if (topSourceEl) {
      if (hasAnyIncident && currentLogs.length > 0) {
        const topEv = currentLogs[0];
        topSourceEl.textContent = `${topEv.country} · ${topEv.asn || "Botnet"}`;
      } else {
        topSourceEl.textContent = "无异常威胁";
      }
    }

    // 4. 多维分布分析卡片
    const breakdownSection = document.getElementById("attack-breakdown-section");
    if (breakdownSection) {
      if (hasAnyIncident) {
        breakdownSection.classList.remove("hidden");
        renderBreakdownStats(data.summary, currentLogs);
      } else {
        breakdownSection.classList.add("hidden");
      }
    }

    // 5. 渲染日志列表
    renderLogList();
  }

  function renderBreakdownStats(summary, logs) {
    const total = logs.length;
    if (total === 0) return;

    let drops = summary?.dropped ?? logs.filter((e) => e.action.toLowerCase().includes("drop")).length;
    let blocks = summary?.blocked ?? logs.filter((e) => e.action.toLowerCase().includes("block")).length;
    let challenges = summary?.challenged ?? (total - drops - blocks);

    const dropPct = Math.round((drops / total) * 100);
    const blockPct = Math.round((blocks / total) * 100);
    const challengePct = Math.max(0, 100 - dropPct - blockPct);

    document.getElementById("action-drop-stat").textContent = `${dropPct}% (${drops})`;
    document.getElementById("bar-action-drop").style.width = dropPct + "%";

    document.getElementById("action-block-stat").textContent = `${blockPct}% (${blocks})`;
    document.getElementById("bar-action-block").style.width = blockPct + "%";

    document.getElementById("action-challenge-stat").textContent = `${challengePct}% (${challenges})`;
    document.getElementById("bar-action-challenge").style.width = challengePct + "%";

    // 国家列表
    const countriesList = document.getElementById("top-countries-list");
    if (countriesList) {
      const countryCounts = summary?.topCountries || computeTop(logs, "country");
      countriesList.innerHTML = countryCounts.slice(0, 5).map((c) => `
        <div class="flex items-center justify-between text-xs py-1 border-b border-black/5 dark:border-white/5">
          <span class="font-medium text-black/80 dark:text-white/80 truncate flex items-center gap-1.5">
            <span>${getFlagEmoji(c.code || c.name)}</span>
            <span>${escapeHtml(c.name)}</span>
          </span>
          <span class="font-mono text-black/60 dark:text-white/60">${c.count} 次</span>
        </div>
      `).join("");
    }

    // 路径列表
    const targetsList = document.getElementById("top-targets-list");
    if (targetsList) {
      const pathCounts = summary?.topTargets || computeTop(logs, "path");
      targetsList.innerHTML = pathCounts.slice(0, 5).map((p) => `
        <div class="flex items-center justify-between text-xs py-1 border-b border-black/5 dark:border-white/5">
          <span class="font-mono text-[11px] text-[var(--primary)] truncate max-w-[200px]" title="${escapeHtml(p.path || p.name)}">
            ${escapeHtml(p.path || p.name)}
          </span>
          <span class="font-mono text-black/60 dark:text-white/60">${p.count} 次</span>
        </div>
      `).join("");
    }
  }

  function computeTop(list, key) {
    const map = new Map();
    list.forEach((item) => {
      const val = item[key] || "未知";
      map.set(val, (map.get(val) || 0) + 1);
    });
    return Array.from(map.entries())
      .map(([name, count]) => ({ name, count }))
      .sort((a, b) => b.count - a.count);
  }

  function renderLogList() {
    const loadingEl = document.getElementById("logs-loading");
    const emptySafeEl = document.getElementById("logs-empty-safe");
    const listEl = document.getElementById("logs-list");
    const countBadge = document.getElementById("logs-count-badge");

    if (loadingEl) loadingEl.classList.add("hidden");

    if (!currentLogs || currentLogs.length === 0) {
      if (emptySafeEl) emptySafeEl.classList.remove("hidden");
      if (listEl) listEl.classList.add("hidden");
      if (countBadge) countBadge.textContent = "0 条";
      return;
    }

    if (emptySafeEl) emptySafeEl.classList.add("hidden");
    if (listEl) listEl.classList.remove("hidden");

    // 过滤逻辑
    const filterAction = document.getElementById("filter-action")?.value || "all";
    const searchKeyword = (document.getElementById("input-search-log")?.value || "").toLowerCase().trim();

    const filtered = currentLogs.filter((ev) => {
      const a = ev.action.toLowerCase();
      if (filterAction === "drop" && !a.includes("drop")) return false;
      if (filterAction === "block" && !a.includes("block")) return false;
      if (filterAction === "challenge" && !a.includes("challenge")) return false;

      if (searchKeyword) {
        const text = `${ev.path} ${ev.ip} ${ev.rayId} ${ev.asn} ${ev.country} ${ev.ruleId}`.toLowerCase();
        if (!text.includes(searchKeyword)) return false;
      }
      return true;
    });

    if (countBadge) countBadge.textContent = `${filtered.length} 条`;

    if (filtered.length === 0) {
      listEl.innerHTML = `
        <div class="py-12 text-center text-xs text-black/40 dark:text-white/40">
          未检索到符合条件的攻击日志 喵~
        </div>
      `;
      return;
    }

    listEl.innerHTML = filtered.map((ev) => {
      const actionBadge = getActionBadgeHtml(ev.action);
      const friendlyTime = getFriendlyTime(new Date(ev.timestamp));

      return `
        <div class="p-3.5 md:p-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 hover:border-[var(--primary)] transition-all flex flex-col gap-2.5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              ${actionBadge}
              <span class="font-mono text-xs font-semibold text-black/90 dark:text-white/90 flex items-center gap-1.5">
                <span class="px-1.5 py-0.5 rounded bg-black/5 dark:bg-white/10 text-[10px] uppercase text-black/60 dark:text-white/60">${escapeHtml(ev.method || 'GET')}</span>
                <span class="text-[var(--primary)]">${escapeHtml(ev.path || '/')}</span>
              </span>
            </div>

            <div class="flex items-center gap-2 text-xs font-mono text-black/40 dark:text-white/40">
              <span title="${new Date(ev.timestamp).toLocaleString()}">${friendlyTime}</span>
              <span>·</span>
              <button class="copy-ray-btn hover:text-[var(--primary)] transition-colors flex items-center gap-1" data-ray="${escapeHtml(ev.rayId)}" title="点击复制 Cloudflare Ray ID">
                <span>Ray: ${escapeHtml(ev.rayId.slice(0, 10))}...</span>
                <span>📋</span>
              </button>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between text-xs text-black/60 dark:text-white/60 gap-2 pt-1 border-t border-black/5 dark:border-white/5">
            <div class="flex flex-wrap items-center gap-3">
              <span class="flex items-center gap-1">
                <span>${getFlagEmoji(ev.countryCode || ev.country)}</span>
                <span class="font-medium">${escapeHtml(ev.country || '未知')}</span>
              </span>
              <span>·</span>
              <span class="font-mono">${escapeHtml(ev.asn || '未知 ASN')} ${escapeHtml(ev.asnDesc || '')}</span>
              <span>·</span>
              <span class="font-mono">IP: ${escapeHtml(ev.ip || '脱敏')}</span>
            </div>

            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-black/5 dark:bg-white/10 font-mono text-[10px] text-black/60 dark:text-white/60 truncate max-w-[200px]" title="${escapeHtml(ev.ruleId)}">
                规则: ${escapeHtml(ev.ruleId || 'DDoS Mitigation')}
              </span>
            </div>
          </div>
        </div>
      `;
    }).join("");

    // 绑定一键复制 RayID
    listEl.querySelectorAll(".copy-ray-btn").forEach((btn) => {
      btn.onclick = () => {
        const ray = btn.getAttribute("data-ray") || "";
        navigator.clipboard.writeText(ray).then(() => {
          alert(`已复制 Cloudflare Ray ID: ${ray} 喵呜！`);
        });
      };
    });
  }

  function getActionBadgeHtml(action = "") {
    const a = action.toLowerCase();
    if (a.includes("drop")) {
      return '<span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono uppercase bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30">DROP 🛑</span>';
    } else if (a.includes("block")) {
      return '<span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono uppercase bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30">BLOCK ⛔</span>';
    } else {
      return '<span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono uppercase bg-blue-500/20 text-blue-600 dark:text-blue-400 border border-blue-500/30">CHALLENGE 🛡️</span>';
    }
  }

  function renderFallbackState(errMsg) {
    const updatedEl = document.getElementById("last-updated-time");
    if (updatedEl) updatedEl.textContent = new Date().toLocaleTimeString("zh-CN");

    const connEl = document.getElementById("cf-connection-status");
    if (connEl) connEl.textContent = "⚡ 离线防护模式 · 基础防线在线";

    const loadingEl = document.getElementById("logs-loading");
    if (loadingEl) loadingEl.classList.add("hidden");

    const emptySafeEl = document.getElementById("logs-empty-safe");
    if (emptySafeEl) emptySafeEl.classList.remove("hidden");
  }

  function getFriendlyTime(date) {
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);

    if (diffMins < 1) return "刚刚";
    if (diffMins < 60) return `${diffMins} 分钟前`;
    if (diffHours < 24) return `${diffHours} 小时前`;
    return date.toLocaleDateString("zh-CN", { month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit" });
  }

  function getFlagEmoji(codeOrName = "") {
    const str = String(codeOrName).toUpperCase();
    if (str === "US" || str.includes("UNITED STATES")) return "🇺🇸";
    if (str === "CN" || str.includes("CHINA")) return "🇨🇳";
    if (str === "DE" || str.includes("GERMANY")) return "🇩🇪";
    if (str === "NL" || str.includes("NETHERLANDS")) return "🇳🇱";
    if (str === "GB" || str.includes("UNITED KINGDOM")) return "🇬🇧";
    if (str === "JP" || str.includes("JAPAN")) return "🇯🇵";
    if (str === "HK" || str.includes("HONG KONG")) return "🇭🇰";
    if (str === "TW" || str.includes("TAIWAN")) return "🇹🇼";
    if (str === "SG" || str.includes("SINGAPORE")) return "🇸🇬";
    if (str === "FR" || str.includes("FRANCE")) return "🇫🇷";
    if (str === "RU" || str.includes("RUSSIA")) return "🇷🇺";
    return "🌐";
  }

  function escapeHtml(str = "") {
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // 监听随认证中心下发的凭据更新事件
  window.addEventListener("yaoxi:credentials:sync", (e) => {
    const creds = e.detail;
    if (creds && creds.cf_token) {
      localStorage.setItem(STORAGE_KEY_TOKEN, creds.cf_token);
      const tokenInput = document.getElementById("setting-cf-token");
      if (tokenInput) tokenInput.value = creds.cf_token;
    }
    if (creds && creds.cf_zone_id) {
      localStorage.setItem(STORAGE_KEY_ZONE, creds.cf_zone_id);
      const zoneInput = document.getElementById("setting-cf-zone-id");
      if (zoneInput) zoneInput.value = creds.cf_zone_id;
    }
    const badge = document.getElementById("badge-cf-token-auto");
    if (badge) badge.classList.remove("hidden");
  });

  // 监听首次加载与 Swup 路由跳转
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDDoSPage);
  } else {
    initDDoSPage();
  }
  document.addEventListener("astro:after-swap", initDDoSPage);
  document.addEventListener("astro:page-load", initDDoSPage);
})();
</script>
