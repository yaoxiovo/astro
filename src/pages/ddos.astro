          <input type="text" id="setting-api-endpoint" placeholder="https://blog-api.yaoxi.cloud" class="w-full px-3 py-2 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 font-mono text-xs outline-none focus:border-[var(--primary)]" />
