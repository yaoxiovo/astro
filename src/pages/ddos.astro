---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";

const pageTitle = "DDoS 告警与实时防御中心";
const pageDescription = "直连 Cloudflare 边缘安全智能分析 · 实时追踪 HTTP Flood、L7 DDoS 与异常并发攻击事件";
---

<MainGridLayout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="flex flex-col gap-5 w-full">

    <!-- 顶部状态卡片 (Hero & Live Status Bar) -->
    <div class="card-base p-6 md:p-8 relative overflow-hidden transition-all duration-300">
      <!-- 背景光晕装饰 -->
      <div id="status-halo" class="absolute -right-16 -top-16 w-56 h-56 rounded-full blur-3xl opacity-20 pointer-events-none transition-all duration-700 bg-emerald-500"></div>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
        <div class="flex items-start md:items-center gap-4">
          <!-- 动态盾牌图标 -->
          <div id="shield-icon-container" class="w-14 h-14 md:w-16 md:h-16 rounded-2xl flex items-center justify-center flex-shrink-0 transition-all duration-500 shadow-md bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
            <Icon id="shield-icon" name="material-symbols:shield" class="text-3xl md:text-4xl transition-transform duration-500" />
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
              <h1 class="text-2xl md:text-3xl font-black tracking-tight text-black/90 dark:text-white/90">
                DDoS 告警与防御中心
              </h1>
              <!-- 核心状态徽章 -->
              <div id="status-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold font-mono tracking-wide transition-all duration-500 bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                <span id="status-badge-text">🟢 安全防护中 · NORMAL</span>
              </div>
            </div>
            <p class="text-xs md:text-sm text-black/60 dark:text-white/60 flex items-center gap-2">
              <span>Cloudflare 边缘安全智能分析 · 实时追踪 HTTP Flood 与 L7 异常并发</span>
              <span class="hidden md:inline text-black/30 dark:text-white/30">|</span>
              <span id="target-domain-label" class="hidden md:inline font-mono text-xs px-2 py-0.5 rounded bg-black/5 dark:bg-white/5">blog.yaoxi.wiki</span>
            </p>
          </div>
        </div>

        <!-- 右侧控制交互栏 -->
        <div class="flex flex-wrap items-center gap-2.5 self-start lg:self-center">
          <!-- 时间范围切片 -->
          <div class="flex items-center bg-black/5 dark:bg-white/5 p-1 rounded-xl border border-black/5 dark:border-white/10 text-xs font-medium">
            <button class="time-range-btn px-2.5 py-1.5 rounded-lg transition-all" data-hours="1">1小时</button>
            <button class="time-range-btn px-2.5 py-1.5 rounded-lg transition-all active-time bg-[var(--primary)] text-white dark:text-black font-semibold shadow-sm" data-hours="24">24小时</button>
            <button class="time-range-btn px-2.5 py-1.5 rounded-lg transition-all" data-hours="168">7天</button>
          </div>

          <!-- 攻防演练模拟模式切换开关 -->
          <button id="btn-toggle-demo" class="btn-plain px-3 py-1.5 rounded-xl text-xs font-medium flex items-center gap-1.5 border border-black/10 dark:border-white/15 hover:border-[var(--primary)] transition-all" title="切换模拟演练模式，直观查看遭受攻击时的告警与日志展示">
            <Icon name="material-symbols:crisis-alert-rounded" class="text-base text-amber-500" />
            <span id="demo-mode-label">演练模拟</span>
          </button>

          <!-- 立即刷新按钮 -->
          <button id="btn-refresh" class="btn-plain px-3 py-1.5 rounded-xl text-xs font-medium flex items-center gap-1.5 border border-black/10 dark:border-white/15 hover:border-[var(--primary)] transition-all">
            <Icon id="refresh-spinner" name="material-symbols:refresh-rounded" class="text-base transition-transform duration-500" />
            <span>刷新</span>
          </button>

          <!-- 设置抽屉按钮 -->
          <button id="btn-open-settings" class="btn-plain p-2 rounded-xl text-xs border border-black/10 dark:border-white/15 hover:border-[var(--primary)] transition-all" title="自定义 Cloudflare 凭据与 API 端点">
            <Icon name="material-symbols:tune-rounded" class="text-base" />
          </button>
        </div>
      </div>

      <!-- 自动刷新进度微指示条 -->
      <div class="mt-5 pt-4 border-t border-black/5 dark:border-white/10 flex flex-wrap items-center justify-between text-xs text-black/50 dark:text-white/50 gap-3">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span id="cf-connection-status">CF 边缘网关已连通</span>
          </span>
          <span>·</span>
          <span>最近探测时间：<span id="last-updated-time" class="font-mono text-black/70 dark:text-white/70">获取中...</span></span>
        </div>

        <div class="flex items-center gap-3">
          <label class="flex items-center gap-1.5 cursor-pointer select-none">
            <input type="checkbox" id="auto-refresh-check" checked class="rounded border-gray-400 text-[var(--primary)] focus:ring-0 w-3.5 h-3.5 cursor-pointer" />
            <span>30s 自动轮询</span>
          </label>
          <div class="w-16 h-1.5 rounded-full bg-black/10 dark:bg-white/10 overflow-hidden">
            <div id="countdown-progress" class="h-full bg-[var(--primary)] transition-all duration-300 w-full"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- 🚨 严重攻击警报横幅 (Attack Alert Banner - 动态呈现) -->
    <div id="attack-alert-banner" class="hidden card-base p-6 md:p-7 relative overflow-hidden border-2 border-red-500/50 bg-gradient-to-r from-red-500/10 via-amber-500/10 to-red-500/5 shadow-xl shadow-red-500/10 animate-fade-in">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
        <div class="flex items-start gap-4">
          <div class="p-3 rounded-2xl bg-red-500 text-white flex-shrink-0 shadow-lg shadow-red-500/30 animate-bounce">
            <Icon name="material-symbols:warning-rounded" class="text-3xl" />
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-red-600 text-white uppercase tracking-wider font-mono">CRITICAL ALERT</span>
              <h2 class="text-lg md:text-xl font-bold text-red-600 dark:text-red-400">
                检测到针对本站的 DDoS 恶意攻击流量！
              </h2>
            </div>
            <p class="text-xs md:text-sm text-black/75 dark:text-white/80 leading-relaxed max-w-2xl">
              Cloudflare 边缘防护系统已启动自适应清洗机制（Adaptive L7 Mitigation），对冲击本站的异常高并发请求执行智能丢弃（Drop）与 403 阻断（Block），源站负载与正常读者访问受严密保护喵呜！
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3 self-end md:self-center flex-shrink-0">
          <div class="text-right">
            <div class="text-[11px] text-black/50 dark:text-white/50 uppercase tracking-wider">峰值清洗速率</div>
            <div id="alert-peak-rps" class="text-xl md:text-2xl font-black font-mono text-red-600 dark:text-red-400">18,450 req/s</div>
          </div>
          <div class="h-10 w-px bg-red-500/20"></div>
          <div class="text-right">
            <div class="text-[11px] text-black/50 dark:text-white/50 uppercase tracking-wider">受冲击端点</div>
            <div id="alert-top-endpoint" class="text-xs md:text-sm font-bold font-mono text-black/80 dark:text-white/80">/api/moments.json</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 核心防御态势卡片网格 (Metrics Row - 4 Cards) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 md:gap-4">
      <!-- 卡片 1: 防御状态 -->
      <div class="card-base p-4 md:p-5 flex flex-col justify-between transition-all hover:-translate-y-0.5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-black/50 dark:text-white/50">防御态势</span>
          <Icon name="material-symbols:security-rounded" class="text-base text-black/40 dark:text-white/40" />
        </div>
        <div class="flex items-baseline gap-2">
          <span id="metric-defense-state" class="text-xl md:text-2xl font-black tracking-tight text-emerald-600 dark:text-emerald-400">安全平稳</span>
        </div>
        <div class="text-[11px] text-black/40 dark:text-white/40 mt-1 flex items-center gap-1 truncate">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>Anycast 边缘分布式清洗</span>
        </div>
      </div>

      <!-- 卡片 2: 拦截事件总数 -->
      <div class="card-base p-4 md:p-5 flex flex-col justify-between transition-all hover:-translate-y-0.5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-black/50 dark:text-white/50">拦截攻击事件</span>
          <Icon name="material-symbols:shield" class="text-base text-black/40 dark:text-white/40" />
        </div>
        <div class="flex items-baseline gap-2">
          <span id="metric-blocked-total" class="text-xl md:text-2xl font-black font-mono tracking-tight text-black/90 dark:text-white/90">0</span>
          <span class="text-xs text-black/40 dark:text-white/40">次</span>
        </div>
        <div class="text-[11px] text-black/40 dark:text-white/40 mt-1 flex items-center gap-1 truncate">
          <span id="metric-blocked-detail">静默丢弃 (Drop) + 403 阻断</span>
        </div>
      </div>

      <!-- 卡片 3: 峰值攻击速率 -->
      <div class="card-base p-4 md:p-5 flex flex-col justify-between transition-all hover:-translate-y-0.5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-black/50 dark:text-white/50">峰值攻击速率</span>
          <Icon name="material-symbols:speed-rounded" class="text-base text-black/40 dark:text-white/40" />
        </div>
        <div class="flex items-baseline gap-2">
          <span id="metric-peak-rps" class="text-xl md:text-2xl font-black font-mono tracking-tight text-black/90 dark:text-white/90">0</span>
          <span class="text-xs text-black/40 dark:text-white/40">req/s</span>
        </div>
        <div class="text-[11px] text-black/40 dark:text-white/40 mt-1 flex items-center gap-1 truncate">
          <span id="metric-rps-sub">全球边缘瞬时统计</span>
        </div>
      </div>

      <!-- 卡片 4: 主要攻击来源 -->
      <div class="card-base p-4 md:p-5 flex flex-col justify-between transition-all hover:-translate-y-0.5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-medium text-black/50 dark:text-white/50">主要攻击源</span>
          <Icon name="material-symbols:public" class="text-base text-black/40 dark:text-white/40" />
        </div>
        <div class="flex items-baseline gap-2 truncate">
          <span id="metric-top-source" class="text-sm md:text-base font-bold font-mono tracking-tight text-black/90 dark:text-white/90 truncate">无异常威胁</span>
        </div>
        <div class="text-[11px] text-black/40 dark:text-white/40 mt-1 flex items-center gap-1 truncate">
          <span id="metric-source-sub">L7 Flood / 恶意压测</span>
        </div>
      </div>
    </div>

    <!-- 攻击深度分析面板 (Breakdown Panel - 仅当有攻击或演练时展开) -->
    <div id="attack-breakdown-section" class="hidden card-base p-6 md:p-7 transition-all duration-300">
      <div class="flex items-center gap-2 mb-5">
        <Icon name="material-symbols:tune-rounded" class="text-xl text-[var(--primary)]" />
        <h3 class="text-base md:text-lg font-bold text-black/90 dark:text-white/90">DDoS 攻击多维分布分析</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 处置动作占比 -->
        <div class="flex flex-col gap-3">
          <div class="text-xs font-semibold text-black/60 dark:text-white/60 uppercase tracking-wider">处置策略分布 (Actions)</div>
          <div class="flex flex-col gap-2.5">
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-red-600 dark:text-red-400">DROP (静默丢弃)</span>
                <span id="action-drop-stat" class="font-mono text-black/60 dark:text-white/60">0% (0)</span>
              </div>
              <div class="h-2 rounded-full bg-black/5 dark:bg-white/10 overflow-hidden">
                <div id="bar-action-drop" class="h-full bg-red-500 rounded-full transition-all duration-500" style="width: 0%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-amber-600 dark:text-amber-400">BLOCK (403 阻断)</span>
                <span id="action-block-stat" class="font-mono text-black/60 dark:text-white/60">0% (0)</span>
              </div>
              <div class="h-2 rounded-full bg-black/5 dark:bg-white/10 overflow-hidden">
                <div id="bar-action-block" class="h-full bg-amber-500 rounded-full transition-all duration-500" style="width: 0%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="font-medium text-blue-600 dark:text-blue-400">CHALLENGE (人机质询)</span>
                <span id="action-challenge-stat" class="font-mono text-black/60 dark:text-white/60">0% (0)</span>
              </div>
              <div class="h-2 rounded-full bg-black/5 dark:bg-white/10 overflow-hidden">
                <div id="bar-action-challenge" class="h-full bg-blue-500 rounded-full transition-all duration-500" style="width: 0%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 来源地区 Top 5 -->
        <div class="flex flex-col gap-3">
          <div class="text-xs font-semibold text-black/60 dark:text-white/60 uppercase tracking-wider">攻击来源地区 Top 5</div>
          <div id="top-countries-list" class="flex flex-col gap-2">
            <!-- 动态注入 -->
          </div>
        </div>

        <!-- 受冲击路由 Top 5 -->
        <div class="flex flex-col gap-3">
          <div class="text-xs font-semibold text-black/60 dark:text-white/60 uppercase tracking-wider">受冲击路由目标 Top 5</div>
          <div id="top-targets-list" class="flex flex-col gap-2">
            <!-- 动态注入 -->
          </div>
        </div>
      </div>
    </div>

    <!-- DDoS 详细安全日志流水 (Detailed Security Event Logs) -->
    <div class="card-base p-6 md:p-8 flex flex-col gap-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-lg md:text-xl font-bold text-black/90 dark:text-white/90">
              DDoS 攻击事件日志流水
            </h3>
            <span id="logs-count-badge" class="px-2 py-0.5 text-xs font-mono font-bold rounded-full bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60">
              0 条
            </span>
          </div>
          <p class="text-xs text-black/40 dark:text-white/40 mt-0.5">从 Cloudflare 边缘安全智能拉取，包含 L7 DDoS、速率限制与清洗策略触发日志</p>
        </div>

        <!-- 过滤与搜索控件 -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- 动作过滤 -->
          <select id="filter-action" class="px-2.5 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 text-xs text-black/80 dark:text-white/80 outline-none focus:border-[var(--primary)] cursor-pointer">
            <option value="all">所有动作 (All)</option>
            <option value="drop">仅丢弃 (Drop)</option>
            <option value="block">仅阻断 (Block)</option>
            <option value="challenge">仅质询 (Challenge)</option>
          </select>

          <!-- 搜索输入框 -->
          <div class="relative">
            <input type="text" id="input-search-log" placeholder="搜索 IP / 路由 / RayID..." class="w-40 sm:w-48 pl-7 pr-3 py-1.5 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 text-xs font-mono text-black/80 dark:text-white/80 outline-none focus:border-[var(--primary)]" />
            <Icon name="material-symbols:search-rounded" class="absolute left-2 top-2 text-sm text-black/40 dark:text-white/40 pointer-events-none" />
          </div>

          <!-- 导出 JSON -->
          <button id="btn-export-json" class="btn-plain px-3 py-1.5 rounded-xl text-xs flex items-center gap-1 border border-black/10 dark:border-white/15 hover:border-[var(--primary)] transition-all" title="复制所有日志的原始 JSON 数据">
            <Icon name="material-symbols:download-rounded" class="text-sm" />
            <span>导出</span>
          </button>
        </div>
      </div>

      <!-- 日志列表展示容器 -->
      <div id="logs-container" class="flex flex-col gap-3 min-h-[160px]">
        <!-- 默认或加载状态骨架屏 -->
        <div id="logs-loading" class="flex flex-col items-center justify-center py-16 gap-3">
          <div class="w-8 h-8 rounded-full border-2 border-[var(--primary)] border-t-transparent animate-spin"></div>
          <span class="text-xs text-black/40 dark:text-white/40 font-mono">正在拉取 Cloudflare 边缘安全防护日志...</span>
        </div>

        <!-- 绿盾·零事件安全状态 (当无 DDoS 攻击时展示) -->
        <div id="logs-empty-safe" class="hidden flex flex-col items-center justify-center py-14 px-4 text-center">
          <div class="relative w-20 h-20 mb-4 flex items-center justify-center">
            <div class="absolute inset-0 rounded-3xl bg-emerald-500/10 animate-ping opacity-30"></div>
            <div class="w-16 h-16 rounded-2xl bg-emerald-500/15 text-emerald-500 flex items-center justify-center border border-emerald-500/30 shadow-inner">
              <Icon name="material-symbols:check-circle-rounded" class="text-4xl" />
            </div>
          </div>
          <h4 class="text-base md:text-lg font-bold text-black/90 dark:text-white/90 mb-1">
            当前网络环境安全 · 未检测到 DDoS 攻击事件
          </h4>
          <p class="text-xs md:text-sm text-black/50 dark:text-white/50 max-w-md leading-relaxed mb-5">
            在所选的时间窗口内，未发现针对本站的恶意高频流量冲击或异常拒绝服务攻击。Cloudflare 全球 330+ Anycast 边缘清洗节点全天候处于待命防护状态喵~
          </p>
          <div class="flex flex-wrap items-center justify-center gap-2">
            <button id="btn-empty-demo" class="px-4 py-2 rounded-xl bg-[var(--primary)] text-white dark:text-black font-semibold text-xs shadow-md hover:opacity-90 active:scale-95 transition-all flex items-center gap-1.5">
              <Icon name="material-symbols:crisis-alert-rounded" class="text-base" />
              <span>开启攻防模拟演练 (Demo)</span>
            </button>
            <a href="https://blog.yaoxi.wiki" class="btn-plain px-4 py-2 rounded-xl text-xs font-medium border border-black/10 dark:border-white/15">
              返回博客首页
            </a>
          </div>
        </div>

        <!-- 真实日志流水挂载区 -->
        <div id="logs-list" class="hidden flex flex-col gap-2.5">
          <!-- 动态注入日志行 -->
        </div>
      </div>
    </div>

    <!-- 底部：全栈多层纵深防御体系概览 -->
    <div class="card-base p-6 md:p-8">
      <div class="flex items-center gap-2 mb-4">
        <Icon name="material-symbols:shield" class="text-xl text-[var(--primary)]" />
        <h3 class="text-base md:text-lg font-bold text-black/90 dark:text-white/90">
          博客系统多层纵深防御架构 (Multi-Layer Defense)
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 flex flex-col gap-1.5">
          <div class="font-bold text-[var(--primary)] flex items-center gap-1">
            <span>🛡️ 第一道：BGP Anycast 清洗</span>
          </div>
          <p class="text-black/60 dark:text-white/60 leading-relaxed">
            全球 330+ 城市边缘节点近源吸收 SYN Flood、UDP 放大攻击，L3/L4 畸形数据包 100% 边缘封堵。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 flex flex-col gap-1.5">
          <div class="font-bold text-[var(--primary)] flex items-center gap-1">
            <span>⚡ 第二道：L7 HTTP 智能清洗</span>
          </div>
          <p class="text-black/60 dark:text-white/60 leading-relaxed">
            实时分析并发突增速率与请求指纹，自适应触发 Drop / Challenge，毫秒级瓦解分布式 CC 僵尸网络。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 flex flex-col gap-1.5">
          <div class="font-bold text-[var(--primary)] flex items-center gap-1">
            <span>🚦 第三道：WAF 与速率限制</span>
          </div>
          <p class="text-black/60 dark:text-white/60 leading-relaxed">
            针对朋友圈 API、发信网关与订阅端点实施单 IP 60 次/分与全局频次熔断，防范接口刷量滥用。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 flex flex-col gap-1.5">
          <div class="font-bold text-[var(--primary)] flex items-center gap-1">
            <span>🔒 第四道：零知识 BFF 网关</span>
          </div>
          <p class="text-black/60 dark:text-white/60 leading-relaxed">
            源站不暴露公网 IP，鉴权与写操作完全由边缘 Workers 零知识代持，彻底阻断任何针对源站的直连穿透。
          </p>
        </div>
      </div>
