  </div>

  <!-- 自定义连接配置弹窗 (Settings Modal) -->
  <div id="settings-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in">
    <div class="card-base w-full max-w-md p-6 rounded-2xl shadow-2xl border border-black/10 dark:border-white/20 flex flex-col gap-4">
      <div class="flex items-center justify-between border-b border-black/10 dark:border-white/10 pb-3">
        <h4 class="text-base font-bold text-black/90 dark:text-white/90 flex items-center gap-2">
          <Icon name="material-symbols:tune-rounded" class="text-lg text-[var(--primary)]" />
          <span>DDoS 防御监控连接设置</span>
        </h4>
        <button id="btn-close-settings" class="p-1 rounded-lg text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white">
          <Icon name="material-symbols:close-rounded" class="text-xl" />
        </button>
