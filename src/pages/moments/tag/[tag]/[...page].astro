---
import MainGridLayout from '../../../../layouts/MainGridLayout.astro';
import MomentCard from '../../../../components/MomentCard.astro';
import MomentsClient from '../../../../components/MomentsClient.astro';
import Pagination from '../../../../components/control/Pagination.astro';
import { getSortedMoments } from '../../../../utils/content-utils';

export async function getStaticPaths({ paginate }) {
    // 注意：getStaticPaths 会被 Astro 独立提取执行，不能引用模块顶层变量，必须自包含
    // 与服务端/客户端统一的 hashtag 规则：字母/数字/下划线/连字符（含 CJK），不吞中文标点
    const TAG_RE = /#[\p{L}\p{N}_-]+/gu;

    function escapeRegExp(s) {
        return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    const allMoments = await getSortedMoments();
    
    // Filter out replies, only show top-level moments on homepage
    const topLevelMoments = allMoments.filter((moment) => !moment.data.replyTo);

    // Extract all unique tags using a regex on the raw content
    const tags = new Set();
    topLevelMoments.forEach(m => {
        const matches = m.body.match(TAG_RE);
        if (matches) {
            matches.forEach(tag => tags.add(tag.substring(1)));
        }
    });

    return Array.from(tags).flatMap(tag => {
        // 精确匹配 tag（后面不能紧跟标签字符），避免 #开发 误匹配 #开发日志
        const tagRe = new RegExp(`#${escapeRegExp(tag)}(?![\\p{L}\\p{N}_-])`, 'u');
        const filteredMoments = topLevelMoments.filter(m => tagRe.test(m.body));
        
        const sortedMoments = filteredMoments.sort((a, b) => {
            if (a.data.pinned && !b.data.pinned) return -1;
            if (!a.data.pinned && b.data.pinned) return 1;
            return new Date(b.data.published).getTime() - new Date(a.data.published).getTime();
        });
        
        return paginate(sortedMoments, {
            params: { tag },
            pageSize: 10
        });
    });
}

const { page } = Astro.props;
const { tag } = Astro.params;
---

<MainGridLayout title={`#${tag} - 朋友圈`} description={`含有 #${tag} 标签的动态`} noindex>
<div class="card-base z-10 px-9 py-6 relative w-full">
            <!-- Back button and Title -->
            <div class="flex items-center gap-4">
                <a href="/moments/" class="p-2 -ml-2 rounded-full hover:bg-[var(--primary)]/10 text-[var(--primary)] transition">
                    <svg viewBox="0 0 24 24" class="w-6 h-6" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"></path></svg>
                </a>
                <div class="text-3xl font-bold text-[var(--primary)]">#{tag}</div>
            </div>
        </div>
            
    <div class="mt-8">
        <div id="moments-container" class="flex flex-col gap-6">
                {page.data.map((moment) => (
                    <MomentCard moment={moment} />
                ))}
                {page.data.length === 0 && (
                    <div class="text-center text-[var(--text-color-light)] py-10">
                        还没有发布过任何动态呢~
                    </div>
                )}
            </div>
            
            <!-- Infinite Scroll Trigger -->
            {page.url.next && (
                <div id="infinite-scroll-trigger" data-next-url={page.url.next} class="w-full h-10 flex items-center justify-center mt-6">
                    <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-[var(--primary)]"></div>
                </div>
            )}
            
            <!-- Standard Pagination (Fallback) -->
            <div id="standard-pagination" class={page.url.next ? "hidden" : "mt-8"}>
                <Pagination page={page} baseUrl={`moments/tag/${tag}`} />
            </div>
        </div>
    </div>

<MomentsClient />
</MainGridLayout>