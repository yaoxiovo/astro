---
import MainGridLayout from '../../layouts/MainGridLayout.astro';
import MomentCard from '../../components/MomentCard.astro';
import MomentsClient from '../../components/MomentsClient.astro';
import { getSortedMoments, momentToText, extractMomentTags, stripMomentId } from '../../utils/content-utils';

const allMoments = await getSortedMoments();
const topLevel = allMoments.filter((m) => !m.data.replyTo);

// 按 年 -> 月 分组（allMoments 已按时间倒序，天然满足组内倒序）
const yearMap = new Map<number, Map<number, typeof topLevel>>();
for (const m of topLevel) {
    const d = new Date(m.data.published);
    if (Number.isNaN(d.getTime())) continue;
    const year = d.getFullYear();
    const month = d.getMonth() + 1;
    if (!yearMap.has(year)) yearMap.set(year, new Map());
    const monthMap = yearMap.get(year)!;
    if (!monthMap.has(month)) monthMap.set(month, []);
    monthMap.get(month)!.push(m);
}

const archive = [...yearMap.entries()]
    .sort((a, b) => b[0] - a[0])
    .map(([year, monthMap]) => ({
        year,
        total: [...monthMap.values()].reduce((s, arr) => s + arr.length, 0),
        months: [...monthMap.entries()]
            .sort((a, b) => b[0] - a[0])
            .map(([month, items]) => ({ month, items })),
    }));

const totalCount = topLevel.length;
const yearCount = archive.length;
---

<MainGridLayout title="朋友圈归档" description="按年月浏览朋友圈动态" noindex>
    <div class="card-base z-10 px-9 py-6 relative w-full">
        <div class="flex items-center justify-between">
            <div class="text-3xl font-bold text-[var(--primary)]">朋友圈归档 (Archive)</div>
            <div class="text-sm text-[var(--text-color-light)]">共 {totalCount} 条动态 · {yearCount} 年</div>
        </div>
    </div>

    <div class="mt-8 flex flex-col gap-10">
        {archive.map((entry) => (
            <section class="w-full">
                <div class="flex items-center gap-3 mb-5">
                    <span class="text-2xl font-bold text-[var(--primary)] tabular-nums">{entry.year}</span>
                    <span class="text-xs text-[var(--text-color-light)]">{entry.total} 条动态</span>
                    <div class="flex-1 h-px bg-black/5 dark:bg-white/5"></div>
                </div>

                <div class="flex flex-col gap-8">
                    {entry.months.map((monthGroup) => (
                        <div class="w-full">
                            <div class="flex items-center gap-2 mb-3 px-2">
                                <span class="text-sm font-bold text-[var(--text-color)]">{monthGroup.month} 月</span>
                                <span class="text-xs text-[var(--text-color-light)]">{monthGroup.items.length} 条</span>
                            </div>
                            <div class="flex flex-col gap-6">
                                {monthGroup.items.map((moment) => (
                                    <MomentCard moment={moment} />
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </section>
        ))}

        {totalCount === 0 && (
            <div class="text-center text-[var(--text-color-light)] py-10">
                还没有发布过任何动态呢~
            </div>
        )}
    </div>

<MomentsClient />
</MainGridLayout>