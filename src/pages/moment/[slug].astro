---
import MainGridLayout from '../../layouts/MainGridLayout.astro';
import MomentCard from '../../components/MomentCard.astro';
import MomentsClient from '../../components/MomentsClient.astro';
import PosterGenerator from '../../components/PosterGenerator.astro';
import { profileConfig, momentsImageConfig } from '../../config';
import { getCollection } from 'astro:content';

// 统一 id 解析：只剥掉内容扩展名，文件名内其他点号原样保留
const stripExt = (id) => id.replace(/\.(md|mdx)$/, "");

export async function getStaticPaths() {
    const allMoments = await getCollection('moments');
    // 注意：getStaticPaths 会被 Astro 独立提取执行，不能引用模块顶层变量，必须自包含
    return allMoments.map((moment) => ({
        params: { slug: moment.id.replace(/\.(md|mdx)$/, "") },
        props: { moment },
    }));
}

const { moment } = Astro.props;
const allMoments = await getCollection('moments');

// Find thread: Parent -> Current -> Children
let parent = null;
if (moment.data.replyTo) {
    parent = allMoments.find(m => stripExt(m.id) === moment.data.replyTo);
}

const children = allMoments
    .filter(m => m.data.replyTo === stripExt(moment.id))
    .sort((a, b) => new Date(a.data.published).getTime() - new Date(b.data.published).getTime());

// Other related moments (same author, not in thread)
const threadSlugs = new Set([moment.id]);
if (parent) threadSlugs.add(parent.id);
children.forEach(c => threadSlugs.add(c.id));

const authorName = moment.data.author || profileConfig.name;

const relatedMoments = allMoments
    .filter(m => (m.data.author || profileConfig.name) === authorName && !threadSlugs.has(m.id))
    .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime())
    .slice(0, 3);

// 从 Markdown 提取纯文本摘要（分享海报用，避免渲染出 #、** 等源码符号）
const excerptText = (moment.body || '')
    .replace(/```[\s\S]*?```/g, ' ')         // 代码块
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')   // 图片
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // 链接 -> 文字
    .replace(/[#>*_`~|-]/g, ' ')             // Markdown 符号 -> 空格
    .replace(/\s+/g, ' ')
    .trim();

// 图片 URL 解析：把动态图片统一补全为完整 raw URL（日期目录自动推导）
const resolveImageUrl = (img) => {
    if (!img) return undefined;
    const { rawUrlPrefix, webpUrlPrefix } = momentsImageConfig;
    let name = img;
    if (name.startsWith(rawUrlPrefix)) name = name.substring(rawUrlPrefix.length);
    else if (name.startsWith(webpUrlPrefix)) name = name.substring(webpUrlPrefix.length);
    else if (name.startsWith('/astro/raw/')) name = name.substring('/astro/raw/'.length);
    else if (name.startsWith('/astro/webp/')) name = name.substring('/astro/webp/'.length);
    if (name.startsWith('/')) name = name.substring(1);
    const dateStr = new Date(moment.data.published).toISOString().slice(0, 10);
    const match = name.match(/^(\d{4}-\d{2}-\d{2})\/(.+)$/);
    const folder = match ? match[1] : dateStr;
    const filename = match ? match[2] : name;
    return `${rawUrlPrefix}/${folder}/${filename}`;
};
// 海报/OG 共用的完整图片列表
const posterImages = (moment.data.images || []).map(resolveImageUrl).filter(Boolean);
// OG 分享图：取第一张（Layout 自动补全域名；无图时回退站点默认图）
const ogImage = posterImages[0];
---

<MainGridLayout
    title={`${authorName} 的朋友圈`}
    description={excerptText || `${authorName} 发布于 ${new Date(moment.data.published).toLocaleDateString('zh-CN')} 的动态`}
    image={ogImage}
    noindex
>
<div class="card-base z-10 px-6 md:px-9 py-6 relative w-full min-h-32">
            <!-- Back button -->
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-2 md:gap-4">
                    <a href="/moments/" class="p-2 -ml-2 rounded-full hover:bg-[var(--primary)]/10 text-[var(--primary)] transition shrink-0">
                        <svg viewBox="0 0 24 24" class="w-6 h-6" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"></path></svg>
                    </a>
                    <div class="text-xl md:text-2xl font-bold text-[var(--primary)]">动态详情 (Thread)</div>
                </div>
                <PosterGenerator 
                    title={`${authorName} 的动态`}
                    excerpt={excerptText || "查看详情"}
                    author={authorName}
                />
            </div>
        </div>

    <div class="mt-8 w-full flex flex-col items-stretch">
        <div id="moments-container" class="flex flex-col gap-6 w-full items-stretch">
                <!-- Thread Parent -->
                {parent && (
                    <div class="relative w-full flex flex-col items-stretch">
                        <MomentCard moment={parent} />
                        <!-- Connecting Line -->
                        <div class="absolute left-12 top-16 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700 -z-10" style="transform: translateX(-50%); height: calc(100% + 24px);"></div>
                    </div>
                )}
                
                <!-- Main Moment -->
                <div class="relative w-full flex flex-col items-stretch">
                    <div class={`w-full flex flex-col items-stretch ${(parent || children.length > 0) ? "ring-2 ring-[var(--primary)] rounded-2xl" : ""}`}>
                        <MomentCard moment={moment} isDetail={true} />
                    </div>
                    {children.length > 0 && (
                        <div class="absolute left-12 top-16 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700 -z-10" style="transform: translateX(-50%); height: calc(100% + 24px);"></div>
                    )}
                </div>

                <!-- Thread Children -->
                {children.map((child, idx) => (
                    <div class="relative mt-6 w-full flex flex-col items-stretch">
                        <MomentCard moment={child} />
                        {idx !== children.length - 1 && (
                            <div class="absolute left-12 top-16 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700 -z-10" style="transform: translateX(-50%); height: calc(100% + 24px);"></div>
                        )}
                    </div>
                ))}
            </div>

            <!-- Other Related -->
            {relatedMoments.length > 0 && (
                <div class="mt-12 pt-8 border-t border-black/5 dark:border-white/5 w-full flex flex-col items-stretch">
                    <div class="text-xl font-bold mb-6 text-[var(--text-color)] px-4">该作者的其他动态</div>
                    <div class="flex flex-col gap-6 w-full items-stretch">
                        {relatedMoments.map(rm => (
                            <MomentCard moment={rm} />
                        ))}
                    </div>
                </div>
            )}
        </div>

<MomentsClient trackViews={false} />
</MainGridLayout>